{
  "name": "MintooSuite",
  "short_name": "MintooSuite",
  "description": "Awais Mintoo & Co. Quantum Sovereign Cloud Trading Suite",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone"],
  "background_color": "#0b0f19",
  "theme_color": "#1f2937",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Trade",
      "url": "/",
      "icons": [{ "src": "/icon-512.png", "sizes": "512x512" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ]
}
