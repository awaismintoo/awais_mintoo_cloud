function rtEnter() { if (!S.rt.busy && (!S.rt.data || nowMs() - S.rt.at > 600000)) { rtLoad(); } }
function rtRate(c) { var t; c = (c || '').toLowerCase(); if (c === 'usd') { return 1; } t = S.tick[c.toUpperCase() + 'USDT']; if (t && t.p > 0) { return 1 / t.p; } return S.rt.data && S.rt.data[c] ? S.rt.data[c] : null; }
function rtName(c) { return (S.rt.names && S.rt.names[c]) || c.toUpperCase(); }
function rtConv(a, f, t) { var rf = rtRate(f), rt = rtRate(t); return rf && rt ? a / rf * rt : null; }
function rtNum(x) { if (x === null || !isFinite(x)) { return '—'; } var a = Math.abs(x), d = a >= 1000 ? 2 : a >= 1 ? 4 : a >= 0.01 ? 6 : 8; return x.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: a >= 1000 ? 2 : 0 }); }
