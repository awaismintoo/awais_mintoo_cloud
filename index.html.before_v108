    }
    document.addEventListener('touchstart', function (e) { py = null; if (e.touches && e.touches.length === 1 && (window.pageYOffset || 0) <= 0 && !document.querySelector('.sheet.open')) { py = e.touches[0].clientY; px0 = e.touches[0].clientX; pd = 0; } }, { passive: true });
    document.addEventListener('touchmove', function (e) { if (py === null || !e.touches.length) { return; } pd = e.touches[0].clientY - py; if ((window.pageYOffset || 0) > 0) { py = null; pbar(''); return; } if (pd > 40 && Math.abs(e.touches[0].clientX - px0) < pd) { pbar(pd > 110 ? 'Release to refresh' : 'Pull down to refresh'); } }, { passive: true });
    document.addEventListener('touchend', function () { var go = py !== null && pd > 110; py = null; if (go) { doRefresh(); } else { pbar(''); } }, { passive: true });
    try { buildNav(); } catch (e) {}
