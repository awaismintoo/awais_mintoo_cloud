/* ---------- generic search picker ---------- */
function mwPicker(title, items, onPick) {
    var el = document.getElementById('mwPick'), q = '', ev;
    if (!el) { el = document.createElement('div'); el.id = 'mwPick'; el.className = 'mwpop'; document.body.appendChild(el); }
    function draw() {
        var qq = q.trim().toLowerCase(), list = items.filter(function (x) { return !qq || (x.label + ' ' + (x.kw || '') + ' ' + x.value).toLowerCase().indexOf(qq) >= 0; }).slice(0, 80), g = '', h = '';
        list.forEach(function (x) { if (x.group && x.group !== g) { g = x.group; h += '<div class="mwgh" style="margin:10px 0 2px">' + esc(g) + '</div>'; } h += '<div class="row tap" data-pk="' + esc(x.value) + '"><span>' + esc(x.label) + '</span><small class="mut">' + esc(x.value) + '</small></div>'; });
        el.querySelector('.pkl').innerHTML = h || '<div class="mut" style="padding:12px">Nothing matches. Try another word.</div>';
    }
