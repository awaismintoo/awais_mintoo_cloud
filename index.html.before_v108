        try { var ph = await unseal(load('mw_vault'), pw || ''); store('mw_fail', '0'); if (!strict && mins > 0 && pw) { cache = { pw: pw, until: Date.now() + mins * 60000 }; } return ph; } catch (e) { n = (+(load('mw_fail') || 0)) + 1; store('mw_fail', String(n)); if (n >= 5) { store('mw_lock', String(Date.now() + 300000)); store('mw_fail', '0'); throw new Error('Wrong password. The wallet is locked for 5 minutes.'); } throw new Error('Wrong password. ' + (5 - n) + ' tries left before a 5 minute lock.'); }
    }
    async function prepare() {
        var net = f.net || 'prac', nd = NETS[net], asset = f.asset || (nd.kind === 'btc' ? 'BTC' : 'N');
        if (asset === 'BTC' || nd.kind === 'btc') { return prepareBtc(); }
        var p = pubs(), to = (f.to || '').trim(), list = tokList(net), tok = null, sym = nd.sym, dec = 18, custom = false, m, amt, r, tx, fee, est, ca;
        if (!okAddr(to)) { throw new Error('That is not a valid address (or its capital letters are wrong). Paste it again.'); }
        if (to.toLowerCase() === p.evm.toLowerCase()) { throw new Error('That is your own address. Enter the address you want to send to.'); }
        if (asset.charAt(0) === 'T') { tok = list[+asset.slice(1)]; if (!tok) { throw new Error('Choose a token.'); } }
        else if (asset === 'C') {
