function mwGauge(v, max, label) {
    var a = Math.max(0, Math.min(1, v / max)), ang = Math.PI * (1 - a), cx = 120, cy = 120, r = 90, nx = cx + 76 * Math.cos(ang), ny = cy - 76 * Math.sin(ang);
    function arc(a0, a1, col) { var x0 = cx + r * Math.cos(Math.PI * (1 - a0)), y0 = cy - r * Math.sin(Math.PI * (1 - a0)), x1 = cx + r * Math.cos(Math.PI * (1 - a1)), y1 = cy - r * Math.sin(Math.PI * (1 - a1)); return '<path d="M' + x0.toFixed(1) + ' ' + y0.toFixed(1) + ' A' + r + ' ' + r + ' 0 0 1 ' + x1.toFixed(1) + ' ' + y1.toFixed(1) + '" stroke="' + col + '" stroke-width="15" fill="none" stroke-linecap="round" filter="url(#mwg)"/>'; }
    return '<svg viewBox="0 0 240 150" width="100%" style="max-width:330px;display:block;margin:0 auto"><defs><filter id="mwg" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="2.6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>' + arc(0, 0.3, '#30d158') + arc(0.33, 0.6, '#ffd60a') + arc(0.63, 0.82, '#ff9f0a') + arc(0.85, 1, '#ff453a') + '<line x1="' + cx + '" y1="' + cy + '" x2="' + nx.toFixed(1) + '" y2="' + ny.toFixed(1) + '" stroke="#64d2ff" stroke-width="4" stroke-linecap="round" filter="url(#mwg)"/><circle cx="' + cx + '" cy="' + cy + '" r="7" fill="#64d2ff" filter="url(#mwg)"/><text x="120" y="104" text-anchor="middle" font-size="22" font-weight="800" fill="#e8f1ff">' + esc(label) + '</text></svg>';
}
function mwCell(l, v) { return '<div><span>' + l + '</span><b>' + v + '</b></div>'; }
function vRisk() {
    var b = S.bot, eq = botEquity(), used = 0, heat = 0, expo = 0, upl = 0, now = nowMs(), h, heatPct, usedPct, lvl, col;
    b.open.forEach(function (p) { var t = S.tick[p.sym]; used += p.margin; expo += p.notional; upl += t ? p.notional * (p.sg * (t.p - p.entry) / p.entry) : 0; heat += p.notional * Math.abs(p.entry - p.sl) / p.entry; });
    heatPct = eq > 0 ? heat / eq * 100 : 0; usedPct = eq > 0 ? used / eq * 100 : 0;
    lvl = heatPct < 2 ? 'LOW RISK' : heatPct < 4 ? 'MODERATE' : heatPct < 7 ? 'HIGH' : 'EXTREME'; col = heatPct < 2 ? '#30d158' : heatPct < 4 ? '#ffd60a' : heatPct < 7 ? '#ff9f0a' : '#ff453a';
    h = '<div class="mwneon"><div class="mwt">RISK METER <span style="opacity:.6;font-weight:600">· paper account</span></div>' + mwGauge(heatPct, 10, heatPct.toFixed(1) + '%') + '<div class="mwlv" style="color:' + col + '">' + lvl + '</div><div class="mwg">' + mwCell('EQUITY', usd(eq).replace('+', '')) + mwCell('OPEN P/L', usd(upl)) + mwCell('MARGIN USED', usd(used).replace('+', '') + ' · ' + usedPct.toFixed(0) + '%') + mwCell('FREE MARGIN', usd(Math.max(0, b.bal - used)).replace('+', '')) + mwCell('EXPOSURE', usd(expo).replace('+', '')) + mwCell('MAX DRAWDOWN', b.maxDd.toFixed(1) + '%') + '</div><div class="mwn">Risk % = the part of your account lost if every open trade hits its stop. Virtual money, real prices.</div></div>';
    h += sh('Open trades', b.open.length);
    if (!b.open.length) { h += '<div class="group pad mut">No open trade. The bot opens one only when a signal reaches ENTER NOW.</div>'; }
    b.open.forEach(function (p, i) {
        var t = S.tick[p.sym], u = t ? p.notional * (p.sg * (t.p - p.entry) / p.entry) : 0, up = t ? p.sg * (t.p - p.entry) / p.entry * 100 * p.lev : 0, left = Math.max(0, p.at + 3 * 3600000 - now), c = S.rkc === i && now - (S.rkt || 0) < 5000;
        h += '<div class="mwtr"><div class="mwh"><span><b>' + esc(base(p.sym)) + '</b> <span class="pill ' + (p.side === 'LONG' ? 'long' : 'short') + '">' + p.side + ' ' + p.lev + '×</span></span><b class="' + cc(u) + '">' + usd(u) + ' · ' + pct(up) + '</b></div><div class="mwd">Entry ' + fmtP(p.entry, p.sym) + ' · Now ' + (t ? fmtP(t.p, p.sym) : '—') + '<br>Stop ' + fmtP(p.sl, p.sym) + ' · Target ' + fmtP(p.tp, p.sym) + '<br>Opened ' + fmtT(p.at) + ' · ' + (left > 0 ? 'time left ' + Math.floor(left / 3600000) + 'h ' + Math.floor(left % 3600000 / 60000) + 'm' : 'time limit reached') + '</div><button class="btn sec" data-rk="close:' + i + '">' + (c ? 'Tap again to close at the live price' : 'Close this trade') + '</button></div>';
    });
    if (b.open.length > 1) { h += '<button class="btn sec" data-rk="closeall" style="border:2px solid #ff453a;color:#ff453a">' + (S.rkc === 'all' && now - (S.rkt || 0) < 5000 ? 'Tap again to close ALL trades' : 'Emergency: close all trades') + '</button>'; }
    return h + '<div class="note">This window shows the paper bot. Real Binance orders are placed from the Trade window with your own API keys.</div>';
}
function vHist() {
    var b = S.bot, s = botStats(), f = S.hf || 'all', rows = b.closed.filter(function (c) { return f === 'all' || (f === 'win' ? c.pnl >= 0 : c.pnl < 0); }), best = 0, worst = 0, h;
    b.closed.forEach(function (c) { if (c.pnl > best) { best = c.pnl; } if (c.pnl < worst) { worst = c.pnl; } });
    h = '<div class="group pad"><div class="lv x2">' + mwCell('TRADES', s.n) + mwCell('WIN RATE', s.n ? s.wr + '%' : '—') + mwCell('PROFIT FACTOR', s.n ? (s.pf >= 99 ? '∞' : s.pf.toFixed(2)) : '—') + mwCell('AVG RESULT', s.n ? (s.avgR >= 0 ? '+' : '') + s.avgR.toFixed(2) + ' R' : '—') + mwCell('BEST', usd(best)) + mwCell('WORST', usd(worst)) + '</div></div>';
    h += '<div class="chips">' + [['all', 'All'], ['win', 'Wins'], ['loss', 'Losses']].map(function (x) { return '<span class="cc tap" data-rk="hf:' + x[0] + '" style="' + (f === x[0] ? 'background:var(--blu);color:#fff' : '') + '">' + x[1] + '</span>'; }).join('') + '</div>';
    if (!rows.length) { return h + '<div class="group pad mut">Nothing here yet.</div>'; }
    h += rows.slice(0, 120).map(function (c) { var d = Math.max(0, c.ct - c.at), mins = Math.round(d / 60000), pc = c.entry ? (c.side === 'LONG' ? 1 : -1) * (c.exit - c.entry) / c.entry * 100 : 0; return '<div class="mwtr"><div class="mwh"><span><b>' + esc(base(c.sym)) + '</b> <span class="pill ' + (c.side === 'LONG' ? 'long' : 'short') + '">' + c.side + '</span></span><b class="' + cc(c.pnl) + '">' + usd(c.pnl) + '</b></div><div class="mwd">Entry ' + fmtP(c.entry, c.sym) + ' → Exit ' + fmtP(c.exit, c.sym) + ' (' + pct(pc) + ' price move)<br>Opened ' + fmtT(c.at) + ' · Closed ' + fmtT(c.ct) + ' · ' + (mins >= 60 ? Math.floor(mins / 60) + 'h ' + (mins % 60) + 'm' : mins + ' min') + '<br>Closed by: <b>' + esc(c.why) + '</b> · indicators agreed ' + (c.pct != null ? c.pct + '%' : '—') + ' · ' + (c.r >= 0 ? '+' : '') + (c.r || 0).toFixed(2) + ' R</div></div>'; }).join('');
    return h;
}
