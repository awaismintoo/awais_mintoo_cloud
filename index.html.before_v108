VIEWS.risk = vRisk2;
function mwClosedRow(c) {
    var d = Math.max(0, c.ct - c.at), m = Math.round(d / 60000), pc = c.entry ? (c.side === 'LONG' ? 1 : -1) * (c.exit - c.entry) / c.entry * 100 : 0;
    return '<div class="mwtr"><div class="mwh"><span><b>' + esc(base(c.sym)) + '</b> <span class="pill ' + (c.side === 'LONG' ? 'long' : 'short') + '">' + c.side + '</span></span><b class="' + cc(c.pnl) + '">' + usd(c.pnl) + '</b></div><div class="mwd"><b>Opened</b> ' + pkd(c.at) + '<br><b>Closed</b> ' + pkd(c.ct) + ' · lasted ' + (m >= 60 ? Math.floor(m / 60) + 'h ' + (m % 60) + 'm' : m + ' min') + '<br>Entry ' + fmtP(c.entry, c.sym) + ' → Exit ' + fmtP(c.exit, c.sym) + ' (' + pct(pc) + ' price move)<br>Closed by <b>' + esc(c.why) + '</b> · indicators agreed ' + (c.pct != null ? c.pct + '%' : '—') + ' · ' + ((c.r || 0) >= 0 ? '+' : '') + (c.r || 0).toFixed(2) + ' R</div></div>';
}
function vHist2() {
    var b = S.bot, s = botStats(), f = S.hf || 'all', rows = b.closed.filter(function (c) { return f === 'all' || (f === 'win' ? c.pnl >= 0 : c.pnl < 0); }), best = 0, worst = 0, h;
    b.closed.forEach(function (c) { if (c.pnl > best) { best = c.pnl; } if (c.pnl < worst) { worst = c.pnl; } });
    h = '<div class="group pad"><div class="lv x2">' + mwCell('TRADES', s.n) + mwCell('WIN RATE', s.n ? s.wr + '%' : '—') + mwCell('PROFIT FACTOR', s.n ? (s.pf >= 99 ? '∞' : s.pf.toFixed(2)) : '—') + mwCell('AVG RESULT', s.n ? (s.avgR >= 0 ? '+' : '') + s.avgR.toFixed(2) + ' R' : '—') + mwCell('BEST', usd(best)) + mwCell('WORST', usd(worst)) + '</div></div>';
    h += '<div class="segc">' + [['all', 'All'], ['win', 'Wins'], ['loss', 'Losses']].map(function (x) { return '<span class="' + (f === x[0] ? 'on' : '') + '" data-rk="hf:' + x[0] + '">' + x[1] + '</span>'; }).join('') + '</div>';
    return rows.length ? h + rows.slice(0, 120).map(mwClosedRow).join('') : h + '<div class="group pad mut">Nothing here yet.</div>';
}
VIEWS.hist = vHist2;
document.addEventListener('click', function (e) {
    var q = e.target.closest ? e.target.closest('[data-rk^="tab:"]') : null; if (!q) { return; }
    S.rkTab = q.getAttribute('data-rk').slice(4); S.rkAng = null; renderView(true);
});
/* ---- Binance Compare: every coin, app vs Binance ---- */
var _vcalib103 = VIEWS.calib;
function cmpLoad() {
    var c = S.cmp; if (c.busy) { return; } c.busy = true;
    fetch('https://fapi.binance.com/fapi/v1/ticker/24hr', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (a) {
        var d = {}; if (!Array.isArray(a)) { throw new Error('bad'); }
        a.forEach(function (x) { if (/USDT$/.test(x.symbol)) { d[x.symbol] = { p: +x.lastPrice, c: +x.priceChangePercent, q: +x.quoteVolume, h: +x.highPrice, l: +x.lowPrice }; } });
        c.d = d; c.at = nowMs(); c.err = '';
    }).catch(function () { c.err = 'Could not reach Binance right now. Try again in a moment.'; }).then(function () { c.busy = false; if (S.win === 'calib') { cmpDraw(); } });
}
function cmpEnter() { if (!S.cmp.at || nowMs() - S.cmp.at > 15000) { cmpLoad(); } }
setInterval(function () { try { if (S.win === 'calib') { cmpLoad(); } } catch (e) {} }, 15000);
function cmpRows() {
    var c = S.cmp, q = (c.q || '').trim().toUpperCase(), rows = [], s, a, x;
    for (s in c.d) {
        if (q && s.indexOf(q) < 0) { continue; } x = c.d[s]; a = S.tick[s];
        rows.push({ sym: s, bp: x.p, bc: x.c, bq: x.q, bh: x.h, bl: x.l, ap: a ? a.p : null, ac: a ? a.chg : null, dc: a ? Math.abs(x.c - a.chg) : null, dp: a && x.p ? Math.abs(a.p - x.p) / x.p * 100 : null });
    }
    rows.sort(function (m, n) { return c.sort === 'gain' ? n.bc - m.bc : c.sort === 'loss' ? m.bc - n.bc : c.sort === 'diff' ? (n.dc || 0) - (m.dc || 0) : n.bq - m.bq; });
    return rows;
}
function cmpSummary(rows) {
    var withApp = rows.filter(function (r) { return r.dc != null; }), b = [0, 0, 0, 0], sum = 0, worst = null, n = withApp.length, mx = 1;
    withApp.forEach(function (r) { sum += r.dc; var i = r.dc < 0.05 ? 0 : r.dc < 0.1 ? 1 : r.dc < 0.3 ? 2 : 3; b[i]++; if (!worst || r.dc > worst.dc) { worst = r; } });
    b.forEach(function (v) { if (v > mx) { mx = v; } });
    return '<div class="group pad"><div class="lv x2">' + mwCell('COINS COMPARED', n) + mwCell('AVERAGE GAP', n ? (sum / n).toFixed(3) + '%' : '—') + mwCell('WITHIN 0.1%', n ? Math.round((b[0] + b[1]) / n * 100) + '%' : '—') + mwCell('BIGGEST GAP', worst ? esc(base(worst.sym)) + ' ' + worst.dc.toFixed(2) + '%' : '—') + '</div><div class="sh" style="margin:12px 0 6px">How close the app is to Binance (24h % gap)</div>' +
        [['< 0.05%', 0, '#30d158'], ['0.05 – 0.1%', 1, '#7bd88f'], ['0.1 – 0.3%', 2, '#ff9f0a'], ['> 0.3%', 3, '#ff453a']].map(function (x) { return '<div class="mwd" style="margin:4px 0 0">' + x[0] + ' · ' + b[x[1]] + ' coins</div><div class="mwbar"><i style="width:' + Math.round(b[x[1]] / mx * 100) + '%;background:' + x[2] + '"></i></div>'; }).join('') + '</div>';
}
function cmpList() {
    var rows = cmpRows(), top = rows.slice(0, 60), mq = 1, html = '';
    top.forEach(function (r) { if (r.bq > mq) { mq = r.bq; } });
    if (!rows.length) { return '<div class="group pad mut">' + (S.cmp.at ? 'No coin matches your search.' : 'Loading Binance data…') + '</div>'; }
    top.forEach(function (r) {
        var pos = r.bh > r.bl ? Math.max(0, Math.min(1, (r.bp - r.bl) / (r.bh - r.bl))) : 0.5, bad = r.dc != null && r.dc >= 0.3, ok = r.dc != null && r.dc < 0.1;
        html += '<div class="mwtr tap" data-act="chart:' + r.sym + '"><div class="mwh"><b>' + esc(base(r.sym)) + '</b><span><b>' + fmtP(r.bp, r.sym) + '</b> <span class="badge ' + (r.bc >= 0 ? 'long' : 'short') + '">' + pct(r.bc) + '</span></span></div><div class="mwd">App price ' + (r.ap != null ? fmtP(r.ap, r.sym) + ' (' + (r.dp != null ? r.dp.toFixed(2) : '0') + '% apart)' : 'not tracked') + ' · app 24h ' + (r.ac != null ? pct(r.ac) : '—') + ' · gap <b style="color:' + (bad ? '#ff453a' : ok ? '#30d158' : '#ff9f0a') + '">' + (r.dc != null ? r.dc.toFixed(2) + '%' : '—') + '</b><br>Volume ' + money(r.bq) + ' · 24h low ' + fmtP(r.bl, r.sym) + ' · high ' + fmtP(r.bh, r.sym) + '</div><div class="mwbar" style="background:linear-gradient(90deg,rgba(255,69,58,.35),rgba(48,209,88,.35))"><i style="width:3px;margin-left:' + Math.round(pos * 100) + '%;background:#0a84ff;box-shadow:0 0 6px #0a84ff"></i></div><div class="mwbar"><i style="width:' + Math.max(2, Math.round(r.bq / mq * 100)) + '%;background:#5e5ce6"></i></div></div>';
    });
    return html;
}
function cmpDraw() { var el = document.getElementById('mwCmpList'), sm = document.getElementById('mwCmpSum'); if (el) { el.innerHTML = cmpList(); } if (sm) { sm.innerHTML = cmpSummary(cmpRows()); } }
VIEWS.calib = function () {
    var c = S.cmp, h = '<div class="note" style="margin:0 0 8px">Every Binance Futures coin, compared live with what this app shows. ' + (c.at ? 'Binance data ' + ago(c.at) + '.' : 'Loading…') + ' Tap a coin for its chart.</div>' + (c.err ? '<div class="warn">' + esc(c.err) + '</div>' : '');
    h += '<input id="mwCmpQ" data-cmq="1" placeholder="Search a coin, for example ARIA" value="' + esc(c.q) + '" autocomplete="off" style="width:100%;box-sizing:border-box;padding:12px;margin:0 0 8px;border-radius:12px;border:1px solid #8e8e9355;font-size:16px;background:transparent;color:inherit">';
    h += '<div class="segc">' + [['q', 'Volume'], ['gain', 'Gainers'], ['loss', 'Losers'], ['diff', 'Biggest gap']].map(function (x) { return '<span class="' + (c.sort === x[0] ? 'on' : '') + '" data-cmp="sort:' + x[0] + '">' + x[1] + '</span>'; }).join('') + '</div>';
    h += '<div id="mwCmpSum">' + cmpSummary(cmpRows()) + '</div><div id="mwCmpList">' + cmpList() + '</div>';
