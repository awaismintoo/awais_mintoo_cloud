function labSignals(k, kind) {
    var c = k.map(function (x) { return x.c; }), n = k.length, s = new Array(n), e9 = iEMA(c, 9), e21 = iEMA(c, 21), e50 = iEMA(c, 50), sp = iSUPER(k, 10, 3), mc = iMACD(c), rs = iRSI(c, 14), bo = iBOLL(c, 20, 2), i, j, hi, lo, vs = iSMA(k.map(function (x) { return x.v; }), 20);
    for (i = 0; i < n; i++) {
        s[i] = 0; if (i < 55) { continue; }
        if (kind === 'ema') { if (e9[i] > e21[i] && e9[i - 1] <= e21[i - 1]) { s[i] = 1; } else if (e9[i] < e21[i] && e9[i - 1] >= e21[i - 1]) { s[i] = -1; } }
        else if (kind === 'st') { if (sp[i] && sp[i - 1]) { if (sp[i].up && !sp[i - 1].up) { s[i] = 1; } else if (!sp[i].up && sp[i - 1].up) { s[i] = -1; } } }
        else if (kind === 'bb') { if (c[i] > bo.up[i] && c[i - 1] <= bo.up[i - 1] && k[i].v > (vs[i] || 0)) { s[i] = 1; } else if (c[i] < bo.lo[i] && c[i - 1] >= bo.lo[i - 1] && k[i].v > (vs[i] || 0)) { s[i] = -1; } }
        else if (kind === 'macd') { if (mc.dif[i] > 0 && mc.dif[i - 1] <= 0) { s[i] = 1; } else if (mc.dif[i] < 0 && mc.dif[i - 1] >= 0) { s[i] = -1; } }
