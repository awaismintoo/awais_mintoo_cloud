S.tm = { sym: 'BTCUSDT', side: 'LONG', slp: 1.5, tpp: 3, bal: null, pos: null, ord: null, busy: false, err: '', at: 0 };
function tmFake(o) { return { getAttribute: function (k) { return o[k] === undefined ? null : String(o[k]); } }; }
function tmLv() { var T = S.tm, t = S.tick[T.sym]; if (!t) { return null; } var p = t.p, L = T.side === 'LONG'; return { p: p, sl: L ? p * (1 - T.slp / 100) : p * (1 + T.slp / 100), tp: L ? p * (1 + T.tpp / 100) : p * (1 - T.tpp / 100) }; }
function tmQuote() {
