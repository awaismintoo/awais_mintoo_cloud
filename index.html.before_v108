    c.heatPct = eq > 0 ? c.heat / eq * 100 : 0; c.usedPct = eq > 0 ? c.used / eq * 100 : 0; c.dayPct = b.start > 0 ? c.day / b.start * 100 : 0;
    return c;
}
function mwTabs(cur, list) { return '<div class="segc">' + list.map(function (x) { return '<span class="' + (cur === x[0] ? 'on' : '') + '" data-rk="tab:' + x[0] + '">' + x[1] + '</span>'; }).join('') + '</div>'; }
function mwTradeCard(r) {
    var p = r.p, now = nowMs(), conf = S.rkc === r.i && now - (S.rkt || 0) < 5000;
    return '<div class="mwtr"><div class="mwh"><span><b>' + esc(base(p.sym)) + '</b> <span class="pill ' + (p.side === 'LONG' ? 'long' : 'short') + '">' + p.side + ' ' + p.lev + '×</span>' + (p.trail ? ' <span class="badge wait">stop moved</span>' : '') + '</span><b class="' + cc(r.u) + '">' + usd(r.u) + ' · ' + pct(r.up) + '</b></div>' +
        '<div class="mwbar"><i class="mwdn" style="width:100%;opacity:.35"></i></div><div class="mwbar" style="margin-top:-12px;background:none"><i style="width:' + Math.round(r.frac * 100) + '%;background:#64d2ff;box-shadow:0 0 8px #64d2ff"></i></div>' +
        '<div class="mwd">Stop ' + fmtP(p.sl, p.sym) + ' ← now ' + fmtP(r.px, p.sym) + (r.live ? '' : ' (waiting for price)') + ' → target ' + fmtP(p.tp, p.sym) + '<br>Entry ' + fmtP(p.entry, p.sym) + ' · now ' + (r.rnow >= 0 ? '+' : '') + r.rnow.toFixed(2) + ' R · money at risk if stopped ' + usd(-r.risk) + '<br>Liquidation (estimate) ' + fmtP(r.liq, p.sym) + ' · ' + r.liqD.toFixed(1) + '% away<br>Opened ' + pkd(p.at) + ' · ' + (r.left > 0 ? 'time left ' + Math.floor(r.left / 3600000) + 'h ' + Math.floor(r.left % 3600000 / 60000) + 'm' : 'time limit reached') + '</div><button class="btn sec" data-rk="close:' + r.i + '">' + (conf ? 'Tap again to close at the live price' : 'Close this trade') + '</button></div>';
}
function vRisk2() {
    var c = mwRiskCalc(), b = c.b, s = botStats(), tab = S.rkTab || 'ov', h = '', lvl, col, gate = botGate(), now = nowMs(), eqs = [b.start], k, e = b.start, maxPos = 0;
    lvl = c.heatPct < 2 ? 'LOW RISK' : c.heatPct < 4 ? 'MODERATE' : c.heatPct < 7 ? 'HIGH' : 'EXTREME'; col = c.heatPct < 2 ? '#30d158' : c.heatPct < 4 ? '#ffd60a' : c.heatPct < 7 ? '#ff9f0a' : '#ff453a';
    for (k = b.closed.length - 1; k >= 0; k--) { e += b.closed[k].pnl; eqs.push(e); }
    h += mwTabs(tab, [['ov', 'Overview'], ['tr', 'Trades'], ['ex', 'Exposure'], ['lm', 'Limits']]);
    if (tab === 'ov') {
        h += '<div class="mwneon"><div class="mwt">RISK METER <span style="opacity:.6;font-weight:600">· paper account</span></div>' + mwDial(c.heatPct, 10, c.heatPct.toFixed(1) + '%') + '<div class="mwlv" style="color:' + col + '">' + lvl + '</div>' +
            '<div class="mwmini"><div>' + mwGauge(c.usedPct, 100, c.usedPct.toFixed(0) + '%') + '<b>MARGIN USED</b></div><div>' + mwGauge(b.maxDd, 10, b.maxDd.toFixed(1) + '%') + '<b>MAX DROP</b></div><div>' + mwGauge(Math.max(0, -c.dayPct), 3, c.dayPct.toFixed(1) + '%') + '<b>TODAY vs 3% LIMIT</b></div></div>' +
            '<div class="mwg">' + mwCell('EQUITY', usd(c.eq).replace('+', '')) + mwCell('OPEN P/L', usd(c.upl)) + mwCell('FREE MARGIN', usd(Math.max(0, b.bal - c.used)).replace('+', '')) + mwCell('EXPOSURE', usd(c.expo).replace('+', '')) + mwCell('LAST 24H', usd(c.day)) + mwCell('OPEN TRADES', b.open.length + ' / ' + b.maxOpen) + mwCell('WIN RATE', s.n ? s.wr + '%' : '—') + mwCell('PROFIT FACTOR', s.n ? (s.pf >= 99 ? '∞' : s.pf.toFixed(2)) : '—') + '</div>' +
            '<div class="mwt" style="margin-top:12px">EQUITY CURVE</div>' + (eqs.length > 3 ? spark(eqs, e >= b.start, '#64d2ff', 300, 70) : '<div class="mwn">The curve appears after a few closed trades.</div>') + '<div class="mwn">Risk % = the part of your account lost if every open trade hits its stop. Virtual money, real prices.</div></div>';
    } else if (tab === 'tr') {
        h += sh('Open trades', c.rows.length) + (c.rows.length ? c.rows.map(mwTradeCard).join('') : '<div class="group pad mut">No open trade. The bot opens one only when a signal reaches ENTER NOW.</div>');
        if (c.rows.length > 1) { h += '<button class="btn sec" data-rk="closeall" style="border:2px solid #ff453a;color:#ff453a">' + (S.rkc === 'all' && now - (S.rkt || 0) < 5000 ? 'Tap again to close ALL trades' : 'Emergency: close all trades') + '</button>'; }
        h += '<div class="note"><a href="#" data-act="win:hist">Full history of closed trades ›</a></div>';
    } else if (tab === 'ex') {
        var tot = Math.max(1, c.lng + c.sht);
        h += '<div class="group pad"><div class="sh" style="margin:0 0 8px">Long vs short</div><div class="mwbar" style="height:14px"><i style="width:' + Math.round(c.lng / tot * 100) + '%;background:#30d158;float:left"></i><i style="width:' + Math.round(c.sht / tot * 100) + '%;background:#ff453a;float:left"></i></div><div class="mwd">Long ' + usd(c.lng).replace('+', '') + ' · Short ' + usd(c.sht).replace('+', '') + ' · Net ' + usd(c.lng - c.sht) + '</div>' + (c.rows.length > 1 && (c.lng === 0 || c.sht === 0) ? '<div class="warn">All open trades point the same way: if the market turns, they lose together.</div>' : '') + '</div>';
        c.rows.forEach(function (r) { if (r.p.notional > maxPos) { maxPos = r.p.notional; } });
        h += sh('By coin', c.rows.length) + '<div class="group pad">' + (c.rows.length ? c.rows.map(function (r) { return '<div class="mwd" style="margin:6px 0 2px"><b>' + esc(base(r.p.sym)) + '</b> ' + r.p.side + ' · ' + usd(r.p.notional).replace('+', '') + ' · ' + r.p.lev + '× · risk ' + usd(-r.risk) + '</div><div class="mwbar"><i style="width:' + Math.round(r.p.notional / maxPos * 100) + '%;background:' + (r.p.sg > 0 ? '#30d158' : '#ff453a') + '"></i></div>'; }).join('') : '<span class="mut">No exposure.</span>') + '</div>' +
            '<div class="group"><div class="row"><span>Average leverage</span><b>' + (c.rows.length ? (c.rows.reduce(function (a, r) { return a + r.p.lev; }, 0) / c.rows.length).toFixed(1) + '×' : '—') + '</b></div><div class="row"><span>Total margin used</span><b>' + usd(c.used).replace('+', '') + ' (' + c.usedPct.toFixed(0) + '%)</b></div><div class="row"><span>Nearest liquidation</span><b>' + (c.rows.length ? Math.min.apply(null, c.rows.map(function (r) { return r.liqD; })).toFixed(1) + '% away' : '—') + '</b></div></div>';
    } else {
        function lim(label, v, max, txt) { return '<div class="mwd" style="margin:8px 0 2px"><b>' + label + '</b> · ' + txt + '</div><div class="mwbar"><i style="width:' + Math.round(Math.max(0, Math.min(1, v / max)) * 100) + '%;background:' + (v / max > 0.8 ? '#ff453a' : v / max > 0.5 ? '#ff9f0a' : '#30d158') + '"></i></div>'; }
        var streak = 0; for (k = 0; k < b.closed.length && b.closed[k].pnl < 0; k++) { streak++; }
        h += '<div class="group pad">' + lim('Daily loss limit (3%)', Math.max(0, -c.dayPct), 3, c.dayPct.toFixed(2) + '% in the last 24h') + lim('Losses in a row (pause at 3)', streak, 3, streak + ' now') + lim('Open trades', b.open.length, b.maxOpen, b.open.length + ' of ' + b.maxOpen) + lim('Risk if all stops hit', c.heatPct, 7, c.heatPct.toFixed(1) + '% (HIGH from 4%)') + '</div>' +
            '<div class="group"><div class="row"><span>Risk per trade</span><b>' + (b.risk * 100).toFixed(1) + '% of equity</b></div><div class="row"><span>Leverage</span><b>' + b.lev + '×</b></div><div class="row"><span>Time limit per trade</span><b>3 hours</b></div><div class="row"><span>Break-even stop</span><b>at 50% of the way to target</b></div><div class="row"><span>Trailing stop</span><b>at 75% of the way to target</b></div></div>' + (gate ? '<div class="warn">' + esc(gate) + '</div>' : '<div class="note">No safety pause is active.</div>');
    }
