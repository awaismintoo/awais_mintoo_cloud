WINS.push({ id: 'terminal', ic: '🖥️', c: '#f0b90b', n: 'Trading Terminal', t: 'Terminal', sub: 'Order ticket with stop and target, positions and balance (your own Binance keys)' }); LIVE.terminal = 0; VIEWS.terminal = vTerminal;

// ---------- Bot Pro: Freqtrade-style paper bot ----------
var FB_KINDS = [['combo', 'Combined (all agree)'], ['ema', 'EMA 9/21 cross'], ['st', 'SuperTrend flip'], ['bb', 'Bollinger breakout'], ['macd', 'MACD zero cross'], ['don', 'Donchian 20 breakout'], ['rsi', 'RSI reversal']];
var FB_ROI = { scalper: [[0, 3], [15, 1.5], [45, 0.6], [90, 0]], balanced: [[0, 6], [30, 3], [90, 1.5], [180, 0.5]], patient: [[0, 12], [120, 6], [360, 3], [720, 1]] };
function fbDef() { return { on: false, bal: 1000, start: 1000, strat: 'combo', tf: '15m', pairs: 12, maxOpen: 4, stake: 10, sl: 3, roiName: 'balanced', trail: true, tOff: 1.5, tDist: 1, shorts: true, cool: 60, ddLock: 15, open: [], closed: [], cd: {}, last: 0, peak: 1000, maxDd: 0, lockUntil: 0, sigs: [], note: '' }; }
S.fb = fbDef(); try { var _fb = JSON.parse(ls('mintoosuite_fb', 'null')); if (_fb && _fb.open) { S.fb = Object.assign(fbDef(), _fb); } } catch (e) {}
function fbSave() { try { lss('mintoosuite_fb', JSON.stringify(S.fb)); } catch (e) {} }
var FB_FEE = 0.0016;
function fbClose(i, px0, why) {
    var F = S.fb, p = F.open[i], pct = p.sg * (px0 / p.entry - 1) * 100, usd = p.size * (pct / 100) - p.size * FB_FEE; F.open.splice(i, 1);
    F.bal += usd; F.peak = Math.max(F.peak, F.bal); var dd = (F.peak - F.bal) / F.peak * 100; F.maxDd = Math.max(F.maxDd, dd);
    F.closed.unshift({ sym: p.sym, sg: p.sg, entry: p.entry, exit: px0, pct: pct - FB_FEE * 100, usd: usd, why: why, t0: p.t0, t1: Date.now() }); F.closed = F.closed.slice(0, 300);
    if (why === 'stop-loss') { F.cd[p.sym] = Date.now() + F.cool * 60000; }
    if (dd >= F.ddLock && !(F.lockUntil > Date.now())) { F.lockUntil = Date.now() + 86400000; F.note = 'Protection: the bot paused for 24 h because the balance fell ' + dd.toFixed(1) + '% from its peak.'; }
    fbSave(); if (S.win === 'botpro') { renderView(true); }
}
function fbTick() {
    var F = S.fb, now = Date.now(), roi = FB_ROI[F.roiName] || FB_ROI.balanced, i; if (!F.open.length) { return; }
    for (i = F.open.length - 1; i >= 0; i--) {
        var p = F.open[i], t = S.tick[p.sym]; if (!t) { continue; } var pct = p.sg * (t.p / p.entry - 1) * 100, el = (now - p.t0) / 60000; p.pk = Math.max(p.pk || 0, pct);
        if (pct <= -F.sl) { fbClose(i, p.entry * (1 - p.sg * F.sl / 100), 'stop-loss'); continue; }
        if (F.trail && p.pk >= F.tOff && pct <= p.pk - F.tDist) { fbClose(i, t.p, 'trailing stop'); continue; }
        var r = null; roi.forEach(function (x) { if (el >= x[0]) { r = x; } });
        if (r && pct >= r[1] && (r[1] > 0 || el >= r[0])) { fbClose(i, t.p, 'ROI ' + r[1] + '% after ' + r[0] + ' min'); continue; }
    }
}
function fbScan() {
    var F = S.fb; if (!F.on) { return; } var now = Date.now(); if (F.lockUntil > now) { return; }
    var ms = (CX_MS[F.tf] || 900) * 1000, bucket = Math.floor(now / ms); if (F.last === bucket) { return; } F.last = bucket; F.sigs = (F.sigs || []).filter(function (s) { return now - s.at < 3 * 3600000; });
    var t = S.tick, syms = Object.keys(t).filter(function (s) { return /USDT$/.test(s) && s !== GOLD && !(S.tradfi && S.tradfi[s]) && !/^(USDC|FDUSD|TUSD|BUSD)/.test(s); }).sort(function (a, b) { return t[b].q - t[a].q; }).slice(0, F.pairs);
    syms.forEach(function (s) {
        if (F.open.some(function (p) { return p.sym === s; }) || (F.cd[s] || 0) > now) { return; }
        m7kl(s, F.tf, 160).then(function (k) {
            var closed = k.slice(0, -1); if (closed.length < 70) { return; } var sig = labSignals(closed, F.strat), ls0 = sig[sig.length - 1]; if (!ls0) { return; }
            var sg = ls0 > 0 ? 1 : -1; if (sg < 0 && !F.shorts) { return; } var px0 = t[s] && t[s].p; if (!px0) { return; }
            var lastC = closed[closed.length - 1].c; if (Math.abs(px0 / lastC - 1) > 0.012) { return; }
            F.sigs.unshift({ sym: s, sg: sg, px: px0, at: Date.now() }); F.sigs = F.sigs.slice(0, 12);
            if (F.open.length >= F.maxOpen || F.open.some(function (p) { return p.sym === s; }) || F.lockUntil > Date.now()) { fbSave(); return; }
            var size = F.bal * F.stake / 100; if (size < 5) { return; }
            F.open.push({ sym: s, sg: sg, entry: px0 * (1 + sg * 0.0003), size: size, t0: Date.now(), pk: 0 }); fbSave(); if (S.win === 'botpro') { renderView(true); }
        }).catch(function () {});
    });
}
setInterval(function () { try { fbTick(); } catch (e) {} }, 5000); setInterval(function () { try { fbScan(); } catch (e) {} }, 20000);
function fbStats() {
    var C = S.fb.closed, n = C.length, w = C.filter(function (x) { return x.usd > 0; }), gw = 0, gl = 0, per = {}, sum = 0;
    C.forEach(function (x) { if (x.usd > 0) { gw += x.usd; } else { gl -= x.usd; } sum += x.pct; per[x.sym] = (per[x.sym] || 0) + x.usd; });
    return { n: n, win: n ? w.length / n * 100 : 0, pf: gl > 0 ? gw / gl : (gw > 0 ? 99 : 0), exp: n ? sum / n : 0, per: Object.keys(per).map(function (k) { return [k, per[k]]; }).sort(function (a, b) { return b[1] - a[1]; }) };
}
function fbSpark() { var C = S.fb.closed.slice().reverse(), b = S.fb.start, pts = [b]; C.forEach(function (x) { b += x.usd; pts.push(b); }); if (pts.length < 2) { return ''; } var lo = Math.min.apply(null, pts), hi = Math.max.apply(null, pts), W = 300, H = 60; return '<svg viewBox="0 0 ' + W + ' ' + H + '" style="width:100%;height:60px"><polyline fill="none" stroke="' + (pts[pts.length - 1] >= pts[0] ? '#1f9d55' : '#e5383b') + '" stroke-width="2" points="' + pts.map(function (v, i) { return (i / (pts.length - 1) * W).toFixed(1) + ',' + (H - 4 - (v - lo) / ((hi - lo) || 1) * (H - 8)).toFixed(1); }).join(' ') + '"/></svg>'; }
function vBotPro() {
    var F = S.fb, st = fbStats(), now = Date.now(), h = '', locked = F.lockUntil > now, ret = (F.bal / F.start - 1) * 100;
    h += '<div class="warn" style="margin-top:0">Paper trading only: virtual money, real Binance prices, fees and slippage included (0.16% per round trip). It keeps running only while the app is open. A good paper result is not a promise of real profit.</div>';
    h += '<div class="group pad"><div class="ph"><b style="font-size:18px">Bot Pro ' + (F.on ? (locked ? '⏸ paused' : '🟢 running') : '⚪ stopped') + '</b><b class="' + (ret >= 0 ? 'up' : 'dn') + '">' + (ret >= 0 ? '+' : '') + ret.toFixed(2) + '%</b></div><div class="note" style="margin:4px 0">Balance $' + F.bal.toFixed(2) + ' · start $' + F.start + ' · worst drop ' + F.maxDd.toFixed(1) + '%</div>' + fbSpark() + (F.note ? '<div class="note">' + esc(F.note) + '</div>' : '') + '<button class="btn" data-m7="fbtoggle">' + (F.on ? 'Stop the bot' : 'Start the bot') + '</button></div>';
    h += sh('Performance') + '<div class="group"><div class="row"><span>Closed trades</span><b>' + st.n + '</b></div><div class="row"><span>Win rate</span><b>' + st.win.toFixed(0) + '%</b></div><div class="row"><span>Profit factor</span><b>' + st.pf.toFixed(2) + '</b></div><div class="row"><span>Average per trade (after fees)</span><b class="' + (st.exp >= 0 ? 'up' : 'dn') + '">' + st.exp.toFixed(2) + '%</b></div></div>';
    var ok = [[st.n >= 50, 'At least 50 closed trades (now ' + st.n + ')'], [st.pf >= 1.3, 'Profit factor 1.3 or more (now ' + st.pf.toFixed(2) + ')'], [st.exp > 0.05, 'Positive average after fees'], [F.maxDd <= 15, 'Worst drop 15% or less (now ' + F.maxDd.toFixed(1) + '%)'], [ret > 0, 'Total result above zero']];
    h += sh('Ready to try by hand with real money?') + '<div class="group">' + ok.map(function (x) { return '<div class="row"><span>' + (x[0] ? '✅ ' : '❌ ') + x[1] + '</span></div>'; }).join('') + '</div><div class="note">Only when all five are ticked over days of paper trading is it even worth trying a signal by hand with a tiny amount in the Terminal. Even then, the future can differ.</div>';
    h += sh('Settings (Freqtrade style)') + '<div class="note" style="margin:0 0 4px">Strategy</div><div class="m7row">' + FB_KINDS.map(function (k) { return '<span class="' + (F.strat === k[0] ? 'on' : '') + '" data-m7="fbs:' + k[0] + '">' + k[1] + '</span>'; }).join('') + '</div>' +
        '<div class="note" style="margin:8px 0 4px">Candle size</div><div class="m7row">' + ['5m', '15m', '1h'].map(function (x) { return '<span class="' + (F.tf === x ? 'on' : '') + '" data-m7="fbtf:' + x + '">' + x + '</span>'; }).join('') + '</div>' +
        '<div class="note" style="margin:8px 0 4px">Pairs watched (top by volume)</div><div class="m7row">' + [6, 12, 20, 30].map(function (x) { return '<span class="' + (F.pairs === x ? 'on' : '') + '" data-m7="fbp:' + x + '">' + x + '</span>'; }).join('') + '</div>' +
        '<div class="note" style="margin:8px 0 4px">Max open trades</div><div class="m7row">' + [1, 2, 4, 6, 8].map(function (x) { return '<span class="' + (F.maxOpen === x ? 'on' : '') + '" data-m7="fbm:' + x + '">' + x + '</span>'; }).join('') + '</div>' +
        '<div class="note" style="margin:8px 0 4px">Stake per trade (% of balance)</div><div class="m7row">' + [5, 10, 20, 33].map(function (x) { return '<span class="' + (F.stake === x ? 'on' : '') + '" data-m7="fbk:' + x + '">' + x + '%</span>'; }).join('') + '</div>' +
        '<div class="note" style="margin:8px 0 4px">Stop-loss</div><div class="m7row">' + [1.5, 2, 3, 5].map(function (x) { return '<span class="' + (F.sl === x ? 'on' : '') + '" data-m7="fbsl:' + x + '">' + x + '%</span>'; }).join('') + '</div>' +
        '<div class="note" style="margin:8px 0 4px">Take-profit schedule (ROI table: the longer a trade runs, the smaller the profit it accepts)</div><div class="m7row">' + Object.keys(FB_ROI).map(function (x) { return '<span class="' + (F.roiName === x ? 'on' : '') + '" data-m7="fbr:' + x + '">' + x + '</span>'; }).join('') + '</div><div class="note">' + FB_ROI[F.roiName].map(function (r) { return r[0] + ' min → ' + r[1] + '%'; }).join(' · ') + '</div>' +
        '<div class="m7row" style="margin-top:8px"><span class="' + (F.trail ? 'on' : '') + '" data-m7="fbtrail">Trailing stop ' + (F.trail ? 'ON' : 'OFF') + '</span><span class="' + (F.shorts ? 'on' : '') + '" data-m7="fbshort">Shorts ' + (F.shorts ? 'ON' : 'OFF') + '</span></div><div class="note">Protections: after a stop-loss the pair rests ' + F.cool + ' min; if the balance falls ' + F.ddLock + '% from its peak the bot pauses 24 h; no pair is opened twice.</div>';
    h += sh('Open trades', F.open.length) + (F.open.length ? '<div class="group">' + F.open.map(function (p) { var t = S.tick[p.sym], pct = t ? p.sg * (t.p / p.entry - 1) * 100 : 0; return '<div class="row"><span><b>' + esc(base(p.sym)) + '</b> ' + (p.sg > 0 ? 'LONG' : 'SHORT') + ' <small class="mut">' + Math.round((now - p.t0) / 60000) + ' min</small></span><b class="' + (pct >= 0 ? 'up' : 'dn') + '">' + (pct >= 0 ? '+' : '') + pct.toFixed(2) + '%</b></div>'; }).join('') + '</div>' : '<div class="group pad mut">None right now.</div>');
    var sg = (F.sigs || []).filter(function (s) { return now - s.at < 3 * 3600000; });
    h += sh('Latest signals', sg.length) + (sg.length ? '<div class="group">' + sg.slice(0, 6).map(function (s) { return '<div class="row"><span><b>' + esc(base(s.sym)) + '</b> ' + (s.sg > 0 ? 'LONG' : 'SHORT') + ' <small class="mut">at ' + fmtP(s.px, s.sym) + ' · ' + Math.round((now - s.at) / 60000) + ' min ago</small></span><button class="btn sec" style="padding:6px 10px;width:auto" data-m7="fbterm:' + s.sym + ':' + (s.sg > 0 ? 'LONG' : 'SHORT') + '">Terminal ›</button></div>'; }).join('') + '</div>' : '<div class="group pad mut">Signals appear when a candle closes with the strategy firing.</div>');
    h += sh('Recent closed trades', F.closed.length) + (F.closed.length ? '<div class="group">' + F.closed.slice(0, 10).map(function (x) { return '<div class="row"><span><b>' + esc(base(x.sym)) + '</b> ' + (x.sg > 0 ? 'LONG' : 'SHORT') + ' <small class="mut">' + esc(x.why) + '</small></span><b class="' + (x.usd >= 0 ? 'up' : 'dn') + '">' + (x.pct >= 0 ? '+' : '') + x.pct.toFixed(2) + '%</b></div>'; }).join('') + '</div>' : '<div class="group pad mut">No closed trades yet.</div>');
    if (st.per.length > 1) { h += sh('Best and worst pairs') + '<div class="group">' + [st.per[0], st.per[st.per.length - 1]].map(function (x) { return '<div class="row"><span>' + esc(base(x[0])) + '</span><b class="' + (x[1] >= 0 ? 'up' : 'dn') + '">' + (x[1] >= 0 ? '+' : '') + x[1].toFixed(2) + ' $</b></div>'; }).join('') + '</div>'; }
    h += '<button class="btn sec" style="margin-top:12px" data-m7="fbreset">Reset Bot Pro (back to $1000)</button><div class="note">To test a strategy on past data first, use the Strategy Lab window (backtest with fees, optimiser, out-of-sample check).</div>';
    return h;
}
WINS.push({ id: 'botpro', ic: '🤖', c: '#5e5ce6', n: 'Bot Pro (Freqtrade-style)', t: 'Bot Pro', sub: 'Strategies, ROI table, stop-loss, trailing stop, protections, performance' }); LIVE.botpro = 0; VIEWS.botpro = vBotPro;

// ---------- Copy trading guide + lead-trader scorecard ----------
S.cp = { roi: '', dd: '', win: '', trades: '', days: '', share: '10' };
function cpOut() {
    var C = S.cp, roi = parseFloat(C.roi), dd = parseFloat(C.dd), win = parseFloat(C.win), tr = parseFloat(C.trades), days = parseFloat(C.days), sh0 = parseFloat(C.share) || 0;
    if (!isFinite(roi) || !isFinite(dd) || dd <= 0) { return '<div class="group pad mut">Enter the trader\'s ROI and maximum drawdown (both are shown on their profile) to get a scorecard.</div>'; }
    var net = roi > 0 ? roi * (1 - sh0 / 100) : roi, ratio = roi / dd, fl = [];
    if (dd > 35) { fl.push(['r', 'Drawdown above 35%: a copier can lose a third of the money in a bad run.']); } else if (dd > 20) { fl.push(['a', 'Drawdown above 20%: expect painful stretches.']); } else { fl.push(['g', 'Drawdown ' + dd + '% is moderate.']); }
    if (ratio < 1) { fl.push(['r', 'Profit is smaller than the worst loss (ROI ÷ drawdown ' + ratio.toFixed(2) + ').']); } else if (ratio < 3) { fl.push(['a', 'ROI ÷ drawdown is ' + ratio.toFixed(2) + ': acceptable, not outstanding.']); } else { fl.push(['g', 'ROI ÷ drawdown is ' + ratio.toFixed(2) + ': strong, if it is real and lasts.']); }
    if (isFinite(tr)) { fl.push(tr < 50 ? ['r', 'Only ' + tr + ' trades: too few to judge skill from luck.'] : tr < 150 ? ['a', tr + ' trades: a fair sample.'] : ['g', tr + ' trades: a good sample.']); }
    if (isFinite(days)) { fl.push(days < 90 ? ['r', 'Under 90 days of history is too short to include a bad market.'] : days < 180 ? ['a', days + ' days: ok, prefer 180 or more.'] : ['g', days + ' days of history.']); }
    if (isFinite(win) && win > 90) { fl.push(['a', 'A win rate above 90% often means tiny wins and rare huge losses (martingale or holding losers). Check the biggest single loss.']); }
    var red = fl.filter(function (f) { return f[0] === 'r'; }).length, verdict = red ? '❌ Too risky or too little proof' : fl.some(function (f) { return f[0] === 'a'; }) ? '🟠 Maybe, with a small amount' : '🟢 Looks reasonable on paper';
    return '<div class="group pad"><b style="font-size:17px">' + verdict + '</b><div class="note" style="margin:6px 0">After a ' + sh0 + '% profit share your return would be about ' + net.toFixed(1) + '% for the same period (more if you copy with leverage, but so are the losses).</div>' + fl.map(function (f) { return '<div class="note" style="margin:3px 0">' + (f[0] === 'g' ? '✅ ' : f[0] === 'a' ? '🟠 ' : '❌ ') + esc(f[1]) + '</div>'; }).join('') + '</div>';
}
function vCopy() {
    var C = S.cp, F = S.fb, st = fbStats(), fld = function (k, lab, ph) { return '<div style="flex:1;min-width:46%"><div class="note" style="margin:0 0 3px">' + lab + '</div><input class="tin" data-m7in="cp:' + k + '" inputmode="decimal" placeholder="' + ph + '" value="' + esc(C[k]) + '"></div>'; };
    var h = '<div class="note" style="margin:0 0 8px">Copy trading means choosing a "lead trader" and having their trades copied on your own account in proportion to the amount you allot. You can usually stop at any time, and the lead trader typically takes a share of your profits (shown on their profile). Losses are yours alone. Availability, rules and fees differ by country and change often, so read each platform\'s own page.</div>';
    h += sh('Where it exists') + '<div class="group">' + [['Binance Copy Trading', 'Futures lead traders with ROI, drawdown and followers on their profile.', 'https://www.binance.com/en/copy-trading'], ['Bitget Copy Trading', 'Futures and spot copy trading, with a trader ranking.', 'https://www.bitget.com/copy-trading'], ['XM', 'XM runs its own copy-trading offers for forex/CFDs; check what is available in your country.', 'https://www.xm.com/'], ['MEXC', 'MEXC also lists copy trading; see the MEXC window for markets.', 'https://www.mexc.com/']].map(function (x) { return '<div class="row tap" style="display:block"><b>' + x[0] + '</b><div class="note" style="margin:2px 0 6px">' + x[1] + '</div><a class="btn sec" style="padding:8px;display:block;text-align:center" href="' + x[2] + '" target="_blank" rel="noopener">Open official page ›</a></div>'; }).join('') + '</div>';
    h += sh('Lead-trader scorecard') + '<div class="group pad"><div style="display:flex;flex-wrap:wrap;gap:8px">' + fld('roi', 'ROI (%) for the period', 'e.g. 85') + fld('dd', 'Max drawdown (%)', 'e.g. 18') + fld('win', 'Win rate (%)', 'e.g. 62') + fld('trades', 'Number of trades', 'e.g. 240') + fld('days', 'Days of history', 'e.g. 120') + fld('share', 'Profit share to the trader (%)', '10') + '</div></div><div id="m7cpo">' + cpOut() + '</div>';
    h += sh('Becoming a lead trader') + '<div class="group pad"><div class="note" style="margin:0">Platforms set their own requirements (account size, history, verification). Build a record first: your Bot Pro paper record is ' + (st.n ? st.n + ' trades, win rate ' + st.win.toFixed(0) + '%, profit factor ' + st.pf.toFixed(2) + ', worst drop ' + F.maxDd.toFixed(1) + '%' : 'empty so far (start Bot Pro)') + '. Never promise followers profits; show real numbers including the drawdown.</div></div>';
    return h + '<div class="note">MintooSuite does not copy trades, hold funds or recommend a trader. This window only teaches how to judge one.</div>';
}
WINS.push({ id: 'copy', ic: '👥', c: '#0a84ff', n: 'Copy trading', t: 'Copy trading', sub: 'Binance, Bitget, XM: how it works and a lead-trader scorecard' }); LIVE.copy = 0; VIEWS.copy = vCopy;
document.addEventListener('input', function (e) {
    var el = e.target; if (!el || !el.getAttribute) { return; } var k = el.getAttribute('data-m7in');
    if (k === 'tmsym') { var s = el.value.toUpperCase().replace(/[^A-Z0-9]/g, ''); if (s) { S.tm.sym = /USDT$/.test(s) ? s : s + 'USDT'; tmRefresh(); } }
    else if (k && k.indexOf('cp:') === 0) { S.cp[k.slice(3)] = el.value; var o = $('m7cpo'); if (o) { o.innerHTML = cpOut(); } }
});
document.addEventListener('click', function (e) {
    var el = e.target.closest ? e.target.closest('[data-m7]') : null; if (!el) { return; }
    var a = el.getAttribute('data-m7'), i = a.indexOf(':'), v = i < 0 ? a : a.slice(0, i), x = i < 0 ? '' : a.slice(i + 1), T = S.tm, F = S.fb;
    if (v === 'tmside') { T.side = x; renderView(true); } else if (v === 'tmsl') { T.slp = +x; renderView(true); } else if (v === 'tmtp') { T.tpp = +x; renderView(true); }
    else if (v === 'tmgo') { var lv = tmLv(); if (!lv) { window.alert('No live price for ' + T.sym + '.'); return; } trOpen(tmFake({ 'data-sym': T.sym, 'data-side': T.side, 'data-sl': lv.sl, 'data-tp': lv.tp, 'data-until': 0 })); }
    else if (v === 'tmload') { tmLoad(); }
    else if (v === 'tmclose') { var p = x.split(':'); trClosePos(tmFake({ 'data-sym': p[0], 'data-amt': p[1], 'data-side': p[2] })); setTimeout(tmLoad, 2500); }
    else if (v === 'fbtoggle') { F.on = !F.on; if (F.on) { F.last = 0; F.lockUntil = 0; F.note = ''; fbScan(); } fbSave(); renderView(true); }
    else if (v === 'fbs') { F.strat = x; F.last = 0; fbSave(); renderView(true); } else if (v === 'fbtf') { F.tf = x; F.last = 0; fbSave(); renderView(true); }
    else if (v === 'fbp') { F.pairs = +x; fbSave(); renderView(true); } else if (v === 'fbm') { F.maxOpen = +x; fbSave(); renderView(true); } else if (v === 'fbk') { F.stake = +x; fbSave(); renderView(true); }
    else if (v === 'fbsl') { F.sl = +x; fbSave(); renderView(true); } else if (v === 'fbr') { F.roiName = x; fbSave(); renderView(true); }
    else if (v === 'fbtrail') { F.trail = !F.trail; fbSave(); renderView(true); } else if (v === 'fbshort') { F.shorts = !F.shorts; fbSave(); renderView(true); }
    else if (v === 'fbterm') { var q = x.split(':'); T.sym = q[0]; T.side = q[1]; gotoWin('terminal'); }
    else if (v === 'fbreset') { if (window.confirm('Reset Bot Pro and its history?')) { S.fb = fbDef(); fbSave(); renderView(true); } }
});
// menu groups, help, wallet card
(function () {
    try { MW_GROUPS.forEach(function (g) { if (g[0] === 'Trade & signals') { g[1].push('terminal', 'botpro'); } if (g[0] === 'Money') { g[1].push('copy'); } }); } catch (e) {}
    try {
        MW_HELP.terminal = 'Pick a coin, choose long or short, choose how far the stop-loss and take-profit are, then review. The next screen shows quantity, margin, leverage, money at risk and fees. Nothing is sent until you confirm, and every order gets a stop-loss and take-profit. Start in Test mode (fake money). Use your own Binance API key with Futures permission only and never withdrawals.';
        MW_HELP.botpro = 'A paper-money bot in the style of Freqtrade: choose a strategy, candle size, number of pairs, stake, stop-loss, a take-profit schedule (ROI table), trailing stop and protections. It uses real prices with fees and slippage. The checklist tells you honestly when its record is good enough to even consider a small real trade by hand.';
        MW_HELP.copy = 'Explains copy trading on Binance, Bitget and XM and gives you a scorecard to judge a lead trader from the numbers on their profile (ROI, drawdown, trades, history, profit share).';
    } catch (e) {}
    try { var w = VIEWS.wallet; if (w && !w.__cp) { VIEWS.wallet = function () { return w.apply(this, arguments) + '<div class="group pad" style="margin-top:12px"><b>Traders and copy trading</b><div class="note" style="margin:4px 0 8px">Learn how copy trading works and score a lead trader before you follow anyone.</div><button class="btn sec" data-act="win:copy">Open Copy trading</button> <button class="btn sec" data-act="win:botpro" style="margin-top:8px">Open Bot Pro</button></div>'; }; VIEWS.wallet.__cp = 1; } } catch (e) {}
    ['terminal', 'botpro', 'copy'].forEach(function (k) { var f = VIEWS[k]; if (f && !f.__m7) { VIEWS[k] = function () { return m7label(f.apply(this, arguments)); }; VIEWS[k].__m7 = 1; } });
})();

function renderView(keep) {
    var d = winDef(S.win), y = window.pageYOffset;
    $('winName').innerHTML = esc(d.n) + ' <span class="qm" data-help="' + d.id + '">?</span>'; $('winSub').textContent = d.sub;
    try { $('view').innerHTML = VIEWS[d.id]() + '<div class="note" style="text-align:center;margin-top:18px">MintooSuite build ' + BUILD + '</div>'; } catch (e) { $('view').innerHTML = '<div class="group pad"><b>Something went wrong showing this window.</b><div class="note">' + esc(e && e.message || e) + '</div></div>'; }
    if (d.id === 'chart') { drawChart(); }
    if (keep) { window.scrollTo(0, y); }
    lastKey = renderKey();
}
function livePatch() {
    var els = document.querySelectorAll('[data-px]'), i, t, el, s;
    for (i = 0; i < els.length; i++) { el = els[i]; t = S.tick[el.getAttribute('data-px')]; if (t) { s = fmtP(t.p, el.getAttribute('data-px')); if (el.textContent !== s) { el.textContent = s; } } }
    els = document.querySelectorAll('[data-chg]');
    for (i = 0; i < els.length; i++) { el = els[i]; s = el.getAttribute('data-chg'); if (S.tick[s]) { var cg = chgOf(s); el.textContent = pct(cg.v) + (el.getAttribute('data-lbl') === '1' ? chgLbl(cg.kind) : ''); el.className = 'chg ' + cc(cg.v); } }
    els = document.querySelectorAll('[data-chip]');
    for (i = 0; i < els.length; i++) { el = els[i]; s = el.getAttribute('data-chip'); if (S.tick[s]) { var cq = chgOf(s); el.textContent = pct(cq.v); el.className = 'badge ' + (cq.v >= 0 ? 'long' : 'short'); } }
}
var TABS = [['overview', 'Home', '<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>'],
    ['morning', 'New Day', '<circle cx="12" cy="14" r="4"/><path d="M12 3v3M4.5 7.5l2 2M19.5 7.5l-2 2M2 18h20"/>'],
    ['scanner', 'Scanner', '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 12l6-6"/>'],
    ['bot', 'Auto Bot', '<rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 4v4M9 13h.01M15 13h.01M9 17h6"/>'],
    ['more', 'More', '<rect x="4" y="4" width="7" height="7" rx="1.6"/><rect x="13" y="4" width="7" height="7" rx="1.6"/><rect x="4" y="13" width="7" height="7" rx="1.6"/><rect x="13" y="13" width="7" height="7" rx="1.6"/>']];
function buildNav() {
    $('tabs').innerHTML = TABS.map(function (t) { var act = t[0] === 'more' ? 'openwin' : 'win:' + t[0]; return '<button class="tab' + (t[0] === S.win ? ' on' : '') + '" data-act="' + act + '"><svg viewBox="0 0 24 24">' + t[2] + '</svg>' + t[1] + '</button>'; }).join('');
    $('tiles').innerHTML = mwTiles();
}
S.hist = [];
function updateBack() { var el = $('btnBack'); if (el) { el.style.display = S.hist.length ? '' : 'none'; } }
function gotoWin(id, isBack) {
    if (!VIEWS[id]) { id = 'overview'; }
    var leaving = S.win === 'chart' && id !== 'chart';
    if (!isBack && id !== S.win) { S.hist.push(S.win); if (S.hist.length > 30) { S.hist.shift(); } try { history.pushState({ mw: 1 }, ''); } catch (e) {} }
    S.win = id; lss('mintoosuite_win', id); closeSheets(); buildNav(); renderView(); window.scrollTo(0, 0); updateBack();
    if (leaving) { closeChartWS(); }
    if (id === 'chart') { loadChart(); }
    if (id === 'wallet') { MW.onOpen(); }
    if (id === 'news' && (!S.newsTried || nowMs() - S.newsAt > 60000)) { loadNews(); }
}
function goBack() { if (S.hist.length) { try { history.back(); } catch (e) { gotoWin(S.hist.pop(), true); } } }
window.addEventListener('popstate', function () {
    if ($('sheetWin').classList.contains('open') || $('sheetMenu').classList.contains('open')) { closeSheets(); try { history.pushState({ mw: 1 }, ''); } catch (e) {} return; }
    if (S.hist.length) { gotoWin(S.hist.pop(), true); }
});
function openSheet(id) { closeSheets(); if (id === 'sheetMenu') { renderAbout(); applyTheme(); } $(id).classList.add('open'); }
function closeSheets() { $('sheetWin').classList.remove('open'); $('sheetMenu').classList.remove('open'); }
function renderAbout() {
    var age = dataAge(), f = S.feed, feed = f.mode === 'ws' ? 'Live stream (' + (f.variant + 1) + ')' : f.mode === 'rest' ? 'Fast refresh every 1.5s (live stream blocked here)' : 'Not connected';
    $('aboutBox').innerHTML = '<div class="row"><span>Version</span><b>v8 · build ' + BUILD + '</b></div><div class="row"><span>Live feed</span><b>' + feed + '</b></div><div class="row"><span>Data age</span><b class="' + (age < 15000 ? 'up' : 'org') + '">' + (isFinite(age) ? Math.round(age / 1000) + 's' : 'none yet') + '</b></div>' +
        '<div class="row"><span>Phone clock vs Binance</span><b>' + (Math.abs(S.skew) < 1000 ? 'in sync' : (S.skew / 1000).toFixed(1) + 's off (corrected)') + '</b></div><div class="row"><span>Scanner</span><b>' + (S.threads === 'workers' ? 'background workers' : 'main thread') + '</b></div>' + (f.err ? '<div class="row"><span>Last feed issue</span><b class="org">' + esc(f.err) + '</b></div>' : '') +
        '<div class="row"><span>Trading</span><b class="up">Recommendations only</b></div>';
}
function applyTheme() {
    var pref = ls('mintoosuite_theme', 'light'), t = pref === 'auto' ? ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light') : pref;
    document.documentElement.setAttribute('data-theme', t);
    var m = document.querySelector('meta[name=theme-color]'); if (m) { m.setAttribute('content', t === 'dark' ? '#000000' : '#f2f2f7'); }
    var segs = document.querySelectorAll('#themeSeg span'); for (var i = 0; i < segs.length; i++) { segs[i].className = segs[i].getAttribute('data-act') === 'theme:' + pref ? 'on' : ''; }
    if (S.win === 'chart') { drawChart(); }
}
function setPref(k) {
    function save() { lss('mintoosuite_sys_push', S.sysPush ? 'on' : 'off'); lss('mintoosuite_gold_push', S.goldPush ? 'on' : 'off'); lss('mintoosuite_crypto_push', S.cryptoPush ? 'on' : 'off'); lss('mintoosuite_alert_3m', S.a3m ? 'on' : 'off'); lss('mintoosuite_alert_master', S.aMaster ? 'on' : 'off'); renderView(true); }
    if (k === 'sys') {
        if (!window.MintooNative && 'Notification' in window && Notification.permission !== 'granted') { Notification.requestPermission().then(function (p) { S.sysPush = p === 'granted'; save(); }); return; }
        S.sysPush = !S.sysPush;
    } else if (k === 'gold') { S.goldPush = !S.goldPush; } else if (k === 'crypto') { S.cryptoPush = !S.cryptoPush; }
    else if (k === 'a3m') { S.a3m = !S.a3m; } else if (k === 'amaster') { S.aMaster = !S.aMaster; }
    else if (k === 'test') {
        var go = function () { sendPush('MintooSuite test', 'Push notifications are working.'); };
        if ('Notification' in window && Notification.permission === 'default') { Notification.requestPermission().then(function () { go(); save(); }); return; }
        go(); return;
    }
    save();
}
function reloadFresh() { try { location.replace(location.pathname + '?v=' + Date.now()); } catch (e) { location.reload(); } }
function reconnect() { wsBack = 1000; closeWS(); connectWS(); pollREST(true); loadTime(); }
var askedPerm = false;
document.addEventListener('click', function (e) {
    if (!askedPerm && S.sysPush && 'Notification' in window && Notification.permission === 'default') { askedPerm = true; try { Notification.requestPermission(); } catch (err) {} }
    if (e.target.classList && e.target.classList.contains('sheet')) { if (e.target.id !== 'sheetTerms') { closeSheets(); } return; }
    var el = e.target.closest ? e.target.closest('[data-act]') : null; if (!el) { return; }
    var a = el.getAttribute('data-act'), p = a.split(':'), v = p.slice(1).join(':');
    if (a === 'openwin') { buildNav(); openSheet('sheetWin'); } else if (a === 'openmenu') { $('langSel').value = S.lang; openSheet('sheetMenu'); } else if (a === 'closesheets') { closeSheets(); }
    else if (a === 'back') { goBack(); } else if (a === 'repair') { repairNow(); renderView(true); } else if (a === 'acceptTerms') { lss('mintoosuite_terms', '1'); $('sheetTerms').classList.remove('open'); }
    else if (a === 'bot:toggle') { S.bot.on = !S.bot.on; botSave(); renderView(true); } else if (a === 'bot:reset') { if (window.confirm('Reset the virtual account to $1,000?')) { botReset(); renderView(true); } }
    else if (a === 'reload') { reloadFresh(); } else if (a === 'reconnect') { reconnect(); } else if (a === 'newsrefresh') { loadNews(true); }
    else if (p[0] === 'win') { gotoWin(v); } else if (p[0] === 'theme') { lss('mintoosuite_theme', v); applyTheme(); }
    else if (p[0] === 'mkt') { S.mkt = v; renderView(); } else if (p[0] === 'scanf') { S.scanf = v; renderView(); }
    else if (p[0] === 'chart') { if (SYM_OK.test(v)) { S.chart.sym = v; lss('mintoosuite_chart', v); gotoWin('chart'); } }
    else if (p[0] === 'tf') { S.chart.tf = v; renderView(); loadChart(); }
    else if (p[0] === 'lev') { S.lev = Math.max(1, Math.min(125, +v || 1)); lss('mintoosuite_lev', String(S.lev)); renderView(true); }
    else if (p[0] === 'set') { setPref(v); }
    else if (a === 'clearlog') { S.log = []; lss('mintoosuite_log', '[]'); renderView(); }
});
document.addEventListener('change', function (e) {
    if (e.target.id === 'chartSel' && SYM_OK.test(e.target.value)) { S.chart.sym = e.target.value; lss('mintoosuite_chart', S.chart.sym); loadChart(); drawChart(); }
    else if (e.target.id === 'langSel') { S.lang = e.target.value; lss('mintoosuite_lang', S.lang); applyLang(); }
});
window.addEventListener('resize', function () { if (S.win === 'chart') { drawChart(); } });
var LANG = { en: ['MintooSuite', 'MENU', 'WINDOWS'], ar: ['منتو سويت', 'القائمة', 'النوافذ'], zh: ['MintooSuite', '菜单', '窗口'], ur: ['منٹو سوٹ', 'مینو', 'ونڈوز'], de: ['MintooSuite', 'MENÜ', 'FENSTER'], fr: ['MintooSuite', 'MENU', 'FENÊTRES'] };
function applyLang() { var d = LANG[S.lang] || LANG.en; $('lblTitle').textContent = d[0]; $('lblMenu').textContent = d[1]; $('lblWin').textContent = d[2]; document.documentElement.lang = S.lang; }
function updateStatus() {
    var age = dataAge(), n = Object.keys(S.tick).length, d = $('dot'), t = $('statusTxt'), live = (S.feed.mode === 'ws' && S.wsAt && nowMs() - S.wsAt < 5000) || (S.feed.mode === 'rest' && S.restAt && nowMs() - S.restAt < 4000);
    if (live) { d.className = 'dot ok'; t.textContent = 'LIVE · ' + n + ' coins'; }
    else if (age < 15000) { d.className = 'dot warn'; t.textContent = 'DELAYED · ' + n + ' coins'; }
    else { d.className = 'dot'; t.textContent = n ? 'PAUSED · data ' + Math.round(age / 1000) + 's old' : 'Connecting…'; }
}
function updateBanner() {
    var age = dataAge(), stale = (S.wsAt || S.restAt) && age > 45000, b = $('banner'), html = '';
    if (S.update) { html = '<div class="bn upd">A new version is ready<button data-act="reload">Update now</button></div>'; }
    else if (stale) { html = '<div class="bn stale">Live data paused (' + Math.round(age / 1000) + 's). Prices are hidden until it reconnects<button data-act="reconnect">Retry</button></div>'; }
    if (b.getAttribute('data-h') !== html) { b.innerHTML = html; b.setAttribute('data-h', html); }
    document.body.classList.toggle('is-stale', !!stale);
}
function tick() {
    updateStatus(); updateBanner();
    if (document.hidden) { return; }
    if (LIVE[S.win]) { if (renderKey() !== lastKey) { renderView(true); } else { livePatch(); } }
    if ($('sheetMenu').classList.contains('open')) { renderAbout(); }
}
function onResume() { if (document.hidden) { return; } reconnect(); S.scan.next = 0; S.scan.running = false; runScan(); loadNews(); loadFx(); checkUpdate(); renderView(true); }
document.addEventListener('visibilitychange', onResume);
window.addEventListener('online', onResume);
window.addEventListener('focus', function () { if (dataAge() > 20000) { reconnect(); } });

// ---------- start ----------
if (!VIEWS[S.win]) { S.win = 'overview'; }
applyTheme(); applyLang(); buildNav(); renderView();
if (S.win === 'chart') { loadChart(); }
makeWorkers(false); loadTime(); connectWS(); pollREST(true);
setInterval(pollREST, 8000); setInterval(wsWatchdog, 3000); setInterval(loadTime, 600000);
loadFx(); setInterval(loadFx, 30000);
scanLoop(); loadNews(); setInterval(loadNews, 120000); loadListings(); setInterval(loadListings, 1800000);
setInterval(pollPrices, 1500); setInterval(botStep, 1000); setInterval(healTick, 5000);
history.replaceState({ mw: 1 }, '');
if (ls('mintoosuite_terms', '') !== '1') { $('sheetTerms').classList.add('open'); }
setTimeout(checkUpdate, 15000); setInterval(checkUpdate, 300000); setInterval(tick, 1000);
if ('serviceWorker' in navigator && !window.MintooNative) { navigator.serviceWorker.register('sw.js').catch(function () {}); }
S.dbg = { ACT: ACT_CACHE, processSignals: processSignals, computePicks: computePicks, buildActions: buildActions, botStep: botStep, botStats: botStats, botEquity: botEquity, botReset: botReset, healTick: healTick };
window.__mintoo = S;
})();
</script>
</body></html>
