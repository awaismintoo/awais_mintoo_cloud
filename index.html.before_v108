    var p; try { p = runScan(); } catch (e) { p = Promise.resolve(); }
    Promise.resolve(p).then(function () {}, function () {}).then(function () { var d = Math.max(1500, (S.scan.next || nowMs() + 30000) - nowMs()); setTimeout(scanLoop, S.scan.next ? d : 2000); });
}

function morningUniverse() {
    var t = S.tick, list = [];
    if (t[GOLD]) { list.push({ sym: GOLD, kind: 'gold' }); }
    Object.keys(t).filter(function (s) { return s !== GOLD; }).sort(function (a, b) { return t[b].q - t[a].q; }).slice(0, 10).forEach(function (s) { list.push({ sym: s, kind: 'crypto' }); });
    return list;
}
function usOpen() { var z = zoned('America/New_York'); return !!z && z.wd !== 'Sat' && z.wd !== 'Sun' && z.m >= 570 && z.m < 960; }
function offHours(sym) { return !!S.tradfi[sym] && !usOpen(); }
function isSolid(o) { return !!(o.today && o.today.solid) && !offHours(o.sym); }
function morningSolid() {
    return S.morning.items.filter(isSolid).sort(function (a, b) { return Math.abs(b.today.dayScore) - Math.abs(a.today.dayScore); });
}
function maybeMorningAlert() {
    var D = S.morning.D, T = D + 900000, now = nowMs();
    if (ls('mintoosuite_morning_alert', '') === String(D)) { return; }
    lss('mintoosuite_morning_alert', String(D));
    var solid = morningSolid();
    if (now - T > 45 * 60000 || !solid.length) { return; }
    var top = solid.slice(0, 3).map(function (o) { return nm(o.sym) + ' ' + o.today.day; }).join(', ');
    addLog('NEW DAY', 'New-day plan ready (' + pk(T) + ' PKT): ' + top);
    if (S.aMaster && S.sysPush) { sendPush('🌅 New day plan ready', top + '. Open the New Day window for entries, targets and times.'); }
}
function loadListings() {
    return fetchJSON('/fapi/v1/exchangeInfo', 25000).then(function (j) {
        var now = nowMs(), all = [], fresh = [], tf = {};
        (j.symbols || []).forEach(function (s) {
            if (!SYM_OK.test(s.symbol) || (s.contractType !== 'PERPETUAL' && s.contractType !== 'TRADIFI_PERPETUAL')) { return; }
            all.push(s.symbol); if (s.pricePrecision != null) { S.prec[s.symbol] = +s.pricePrecision; }
            var ff = {}; (s.filters || []).forEach(function (x) { if (x.filterType === 'PRICE_FILTER') { ff.tick = +x.tickSize; } else if (x.filterType === 'LOT_SIZE') { ff.step = +x.stepSize; ff.min = +x.minQty; } else if (x.filterType === 'MARKET_LOT_SIZE') { ff.mstep = +x.stepSize; ff.mmin = +x.minQty; ff.mmax = +x.maxQty; } else if (x.filterType === 'MIN_NOTIONAL') { ff.notional = +x.notional; } }); S.filt[s.symbol] = ff;
            var ut = String(s.underlyingType || '').toUpperCase(), sub = JSON.stringify(s.underlyingSubType || []).toLowerCase();
            if ((s.contractType === 'TRADIFI_PERPETUAL' || ut === 'EQUITY' || /tradfi|equity|stock|etf/.test(sub)) && s.symbol !== 'XAUUSDT' && s.symbol !== 'PAXGUSDT' && !/metal|commodity/.test(sub)) { tf[s.symbol] = 1; }
