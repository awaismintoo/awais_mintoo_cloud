    h += '<div class="m7row">' + [['spot', 'Spot'], ['usdm', 'USDⓈ-M'], ['coinm', 'COIN-M'], ['options', 'Options']].map(function (x) { return '<span class="' + (M.sub === x[0] ? 'on' : '') + '" data-m7="sub:' + x[0] + '">' + x[1] + '</span>'; }).join('') + '</div>';
