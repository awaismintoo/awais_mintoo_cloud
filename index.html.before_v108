function rtGet(urls) { return urls.reduce(function (p, u) { return p.catch(function () { return fetch(u, { cache: 'no-store' }).then(function (r) { if (!r.ok) { throw new Error('http'); } return r.json(); }); }); }, Promise.reject(new Error('start'))); }
function rtLoad() {
