// ===== v10.7 · part 3: professional live chart (tap a candle for the full popup, indicators, pan and pinch, live bars) =====
S.cx = { n: 70, off: 0, ov: { MA: 1, EMA: 0, BOLL: 0, SAR: 0, SUPER: 0, VWAP: 0 }, sub: 'VOL', sel: -1, src: 'f', drag: null, raf: 0, more: 0, q: '' };
