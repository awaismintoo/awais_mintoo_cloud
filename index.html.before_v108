}
function tmAcct() {
    var T = S.tm; if (T.err) { return '<div class="warn">' + esc(T.err) + '</div>'; } if (T.busy) { return skel(2, 60); } if (!T.bal && !T.pos) { return '<div class="group pad mut">Tap "Load my account" to see your futures balance, open positions and open orders from Binance.</div>'; }
