        '<span class="m7star ' + star + '" data-m7="fav:' + esc(r.sym) + '">' + (star ? '★' : '☆') + '</span><div class="r tap" data-act="' + act + '"><div>' + pxs + '</div><small>$' + (r.usd >= 1 ? r.usd.toFixed(2) : r.usd.toPrecision(4)) + '</small></div>' +
        '<span class="m7chg ' + (r.chg >= 0 ? 'u' : 'd') + '" data-m7chip="' + (r.src === 'f' ? r.sym : '') + '">' + (r.chg >= 0 ? '+' : '') + r.chg.toFixed(2) + '%</span></div>';
