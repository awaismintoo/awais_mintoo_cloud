/* ---------- tech data with sparklines for the Home tiles ---------- */
function mwTechFrom(ks) {
    var n = ks ? ks.length : 0, c = [], i, tr = 0, hi, lo, pc;
    if (n < 60) { return null; } for (i = 0; i < n; i++) { c.push(+ks[i][4]); }
    for (i = n - 14; i < n; i++) { hi = +ks[i][2]; lo = +ks[i][3]; pc = +ks[i - 1][4]; tr += Math.max(hi - lo, Math.abs(hi - pc), Math.abs(lo - pc)); }
    return { price: c[n - 1], rsi: mwRsi(c.slice(-100), 14), e20: mwEma(c.slice(-60), 20), e50: mwEma(c, 50), atr: tr / 14 / c[n - 1] * 100, h1: (c[n - 1] - c[n - 5]) / c[n - 5] * 100, h4: (c[n - 1] - c[n - 17]) / c[n - 17] * 100, sp: c.slice(-48), at: nowMs() };
}
function mwTechLoad() {
    [GOLD, 'BTCUSDT', 'ETHUSDT', 'BNBUSDT', 'SOLUSDT', 'XRPUSDT'].forEach(function (sym) {
        fetch('https://fapi.binance.com/fapi/v1/klines?symbol=' + sym + '&interval=15m&limit=120').then(function (r) { return r.json(); }).then(function (ks) { var x = Array.isArray(ks) ? mwTechFrom(ks) : null; if (x) { S.tech[sym] = x; } }).catch(function () {});
    });
}
