        dest = await btcDest(to); me = await btcDest(p.btc);
        if (hex(dest) === hex(me)) { throw new Error('That is your own address. Enter the address you want to send to.'); }
        if (!amt) { throw new Error('Enter an amount such as 0.0005 (more than zero, up to 8 decimals).'); }
        if (amt < DUST) { throw new Error('That amount is too small for Bitcoin (minimum 0.00000294).'); }
