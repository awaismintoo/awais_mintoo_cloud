    fetch(cxURL(sym, tf, '&endTime=' + (first - 1)), { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (rows) { if (sym === c.sym && tf === c.tf && Array.isArray(rows) && rows.length) { c.k = cxMap(rows).concat(c.k); S2.off += 0; cxDraw(); } }).catch(function () {}).then(function () { S2.more = 0; });
