S.px = { rows: null, idx: null, at: 0, busy: false, err: '', q: '', sec: '' };
function pxParse(html) {
    var doc = new DOMParser().parseFromString(html, 'text/html'), tabs = doc.querySelectorAll('table'), out = [];
    tabs.forEach(function (tb) {
        var heads = Array.prototype.map.call(tb.querySelectorAll('thead th, tr:first-child th'), function (h) { return (h.textContent || '').trim().toUpperCase(); }), ix = function (re) { for (var i = 0; i < heads.length; i++) { if (re.test(heads[i])) { return i; } } return -1; };
        var iS = ix(/SYMBOL/), iC = ix(/^CURRENT|^PRICE|^LAST/), iCh = ix(/^CHANGE$/), iP = ix(/CHANGE ?\(?%/), iV = ix(/VOLUME/), iL = ix(/LDCP/), iSec = ix(/SECTOR/); if (iS < 0 || iC < 0) { return; }
        tb.querySelectorAll('tbody tr').forEach(function (tr) { var td = tr.querySelectorAll('td'); if (td.length <= Math.max(iS, iC)) { return; } var num = function (i) { return i >= 0 && td[i] ? parseFloat(String(td[i].textContent).replace(/[, %]/g, '')) : NaN; }, sym = (td[iS].getAttribute('data-search') || td[iS].textContent || '').trim().split(/\s+/)[0]; var cur = num(iC); if (!sym || !isFinite(cur)) { return; } var chg = num(iCh), pc = num(iP); if (!isFinite(pc) && isFinite(chg) && cur - chg) { pc = chg / (cur - chg) * 100; } out.push({ s: sym, p: cur, c: isFinite(chg) ? chg : 0, pc: isFinite(pc) ? pc : 0, v: num(iV) || 0, sec: iSec >= 0 && td[iSec] ? td[iSec].textContent.trim() : '' }); });
    });
    return out;
}
