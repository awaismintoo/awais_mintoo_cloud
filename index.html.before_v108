// ----- paper bot can also take the radar's early movers and healthy running trends (small coins included) -----
function m7botRadar() {
    var b = S.bot, now = nowMs(); if (!b || !b.on || dataAge() > 10000 || b.open.length >= b.maxOpen) { return; }
    try { if (botGate()) { return; } } catch (e) { return; }
    var eq = botEquity(); if (eq <= b.start * 0.5) { return; }
    (S.rd.list || []).filter(function (m) { return (m.kind === 'EARLY' || m.kind === 'TREND') && m.score >= 62 && m.chance >= 60 && !m.wide && m.vr >= 1.8 && now - m.at < 120000; }).slice(0, 3).forEach(function (m) {
        if (b.open.length >= b.maxOpen || b.open.some(function (p) { return p.sym === m.sym; }) || (b.lastTrade[m.sym] && now - b.lastTrade[m.sym] < 45 * 60000)) { return; }
        var t = S.tick[m.sym]; if (!t) { return; } var sg = m.side === 'LONG' ? 1 : -1, entry = t.p * (1 + sg * BOT_SLIP);
        if (m.kind === 'TREND' && (sg > 0 ? t.p > m.entry * 1.004 : t.p < m.entry * 0.996)) { return; }
        var hh = m7health(m.side, m.entry, Math.abs(m.entry - m.stop), Math.abs(m.tgt - m.entry), t.p); if (hh.st !== 'OK') { return; }
        var slPct = Math.abs(entry - m.stop) / entry; if (!(slPct > 0)) { return; }
        var cost = slPct + 2 * BOT_FEE + BOT_SLIP, notional = eq * b.risk / cost, lev = Math.max(1, Math.min(b.lev, Math.floor(100 / (slPct * 100 * 1.6 + 0.5)))), margin = notional / lev, used = b.open.reduce(function (s, p) { return s + p.margin; }, 0), avail = b.bal - used;
        if (margin > avail) { margin = avail * 0.95; notional = margin * lev; } if (notional < 10) { return; }
        b.open.push({ sym: m.sym, side: m.side, sg: sg, entry: entry, sl: m.stop, tp: m.tgt, notional: notional, margin: margin, lev: lev, at: now, pct: m.chance, score: m.score, risk: notional * cost, src: 'radar' });
        b.lastTrade[m.sym] = now; botSave(); addLog('BOT', 'Paper trade opened from the radar: ' + nm(m.sym) + ' ' + m.side + ' at ' + fmtP(entry, m.sym) + ' (' + m.kind + ', model chance ' + m.chance + '%)');
    });
}
