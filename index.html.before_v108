        else if (!rate) { S.zero++; if (S.zero >= 2 && S.threads === 'workers') { makeWorkers(true); S.zero = 0; } }
        var dsN = anchorStart(nowMs()), missing = S.anchor === 'roll' ? 0 : Object.keys(S.tick).filter(function (s) { return S.tick[s].q > 1e6 && (!S.dayOpen[s] || S.dayOpen[s].t !== dsN); }).length, pend = S.morning.D !== D0 || missing > 0;
        S.fup = pend ? (S.fup || 0) + 1 : 0;
        S.scan.next = nowMs() + (!scanned ? 6000 : (pend && S.fup <= 4) ? 8000 : maxw > 1800 ? 60000 : 30000);
