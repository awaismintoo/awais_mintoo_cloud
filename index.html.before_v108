function mvClamp(x) { return Math.max(0, Math.min(1, x)); }
function moverMetrics(sym, ks, chg24) {
    var n = ks ? ks.length : 0, c = [], qv = [], i, r5, r15, r60, vr, vb, dir, late, score, tag, stop, hi, lo, price, risk, tgt, side;
    if (n < 62) { return null; }
