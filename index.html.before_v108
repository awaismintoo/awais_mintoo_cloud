var CX_TF = ['1m', '3m', '5m', '15m', '30m', '1h', '2h', '4h', '1d', '1w'], CX_MS = { '1m': 60, '3m': 180, '5m': 300, '15m': 900, '30m': 1800, '1h': 3600, '2h': 7200, '4h': 14400, '1d': 86400, '1w': 604800 };
