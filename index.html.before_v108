};
document.addEventListener('input', function (e) { var k = e.target.getAttribute ? e.target.getAttribute('data-cmq') : null; if (k) { S.cmp.q = e.target.value; cmpDraw(); } });
document.addEventListener('click', function (e) { var q = e.target.closest ? e.target.closest('[data-cmp]') : null; if (q) { S.cmp.sort = q.getAttribute('data-cmp').slice(5); renderView(true); } });
/* ---- Alerts: more types, price alerts for any coin, background status ---- */
S.pal = (function () { try { return JSON.parse(ls('mintoosuite_pal', '[]')); } catch (e) { return []; } })();
S.aflags = (function () { try { return JSON.parse(ls('mintoosuite_aflags', '{}')); } catch (e) { return {}; } })();
var MW_ATYPES = [['early', '🚀 New early mover', 'EARLY ideas from the Early Movers scan'], ['pump', '📈 Big pump / dump', 'A coin moves 15% or more in one hour'], ['bot', '🧪 Paper bot trades', 'A paper trade closes (profit or loss)'], ['risk', '🎛 Risk meter high', 'Risk above 4% of the account'], ['news', '📰 Gold and world headlines', 'New war, sanctions, Fed or dollar headlines']];
function mwSaveAl() { lss('mintoosuite_pal', JSON.stringify(S.pal.slice(-40))); lss('mintoosuite_aflags', JSON.stringify(S.aflags)); mwSyncNative(); }
function mwSyncNative() { try { if (window.MintooNative && window.MintooNative.bgSet) { window.MintooNative.bgSet(JSON.stringify({ pal: S.pal.filter(function (a) { return !a.done; }), flags: S.aflags })); } } catch (e) {} }
function mwFire(key, title, body) { var n = nowMs(); if (S.mwFired[key] && n - S.mwFired[key] < 3600000) { return; } S.mwFired[key] = n; try { sendPush(title, body); } catch (e) {} addLog('ALERT', title + ': ' + body); }
var mwNewsSeen = {}, mwLastOpenN = null, _bc103 = botClose;
botClose = function (i, exit, why, ct) {
    var p = S.bot.open[i], n0 = S.bot.closed.length, r = _bc103(i, exit, why, ct), c;
    try { if (S.aflags.bot && S.bot.closed.length > n0) { c = S.bot.closed[0]; sendPush('Paper trade closed: ' + base(c.sym), c.side + ' ' + (c.pnl >= 0 ? 'profit ' : 'loss ') + usd(c.pnl) + ' (' + c.why + ')'); } } catch (e) {}
    return r;
};
function mwCheckAlerts() {
    var t, changed = false, c;
    S.pal.forEach(function (a) { if (a.done) { return; } t = S.tick[a.sym]; if (t && (a.dir === 'above' ? t.p >= a.price : t.p <= a.price)) { a.done = true; a.at = nowMs(); changed = true; try { sendPush('Price alert: ' + base(a.sym), base(a.sym) + ' is ' + (a.dir === 'above' ? 'above ' : 'below ') + fmtP(a.price, a.sym) + ' (now ' + fmtP(t.p, a.sym) + ')'); } catch (e) {} addLog('ALERT', base(a.sym) + ' ' + a.dir + ' ' + fmtP(a.price, a.sym)); } });
    if (changed) { mwSaveAl(); if (S.win === 'alerts') { renderView(true); } }
    if (S.aflags.early) { (S.mv.list || []).forEach(function (m) { if (m.tag === 'EARLY') { mwFire('early' + m.sym + m.side, '🚀 Early mover: ' + base(m.sym) + ' ' + m.side, pct(m.r15) + ' in 15 min on volume ×' + m.vr.toFixed(1)); } }); }
    if (S.aflags.pump) { (S.mv.list || []).forEach(function (m) { if (Math.abs(m.r60) >= 15) { mwFire('pump' + m.sym, (m.r60 > 0 ? '📈 Pump: ' : '📉 Dump: ') + base(m.sym), pct(m.r60) + ' in the last hour'); } }); }
    if (S.aflags.risk) { c = mwRiskCalc(); if (c.heatPct >= 4) { mwFire('risk', '🎛 Risk meter high', 'Risk is ' + c.heatPct.toFixed(1) + '% of the paper account'); } }
    if (S.aflags.news) { (S.news || []).slice(0, 25).forEach(function (n) { if (n.title && !mwNewsSeen[n.title] && /war|attack|missile|sanction|ceasefire|rate cut|rate hike|fed |gold|dollar/i.test(n.title) && (!n.t || nowMs() - n.t < 6 * 3600000)) { mwNewsSeen[n.title] = 1; if (mwNewsSeen.__ready) { mwFire('news' + n.title.slice(0, 30), '📰 ' + (n.src || 'News'), n.title); } } }); mwNewsSeen.__ready = 1; }
}
setInterval(function () { try { mwCheckAlerts(); } catch (e) {} }, 5000);
var _valerts103 = VIEWS.alerts;
VIEWS.alerts = function () {
    var h = _valerts103(), bg = !!(window.MintooNative && window.MintooNative.bgSet);
    h += sh('More alert types') + '<div class="group">' + MW_ATYPES.map(function (a) { return '<div class="row"><span><b>' + a[1] + '</b><br><small class="mut">' + a[2] + '</small></span><span class="mwsw' + (S.aflags[a[0]] ? ' on' : '') + '" data-al="tog:' + a[0] + '"></span></div>'; }).join('') + '</div>';
    h += sh('Your price alerts', S.pal.filter(function (a) { return !a.done; }).length) + '<div class="group pad"><input data-alf="sym" placeholder="Coin, for example BTC or ARIA" value="' + esc(S.alf.sym || '') + '" autocomplete="off" style="width:100%;box-sizing:border-box;padding:12px;margin:4px 0;border-radius:10px;border:1px solid #8e8e9355;font-size:16px;background:transparent;color:inherit"><input data-alf="price" inputmode="decimal" placeholder="Price" value="' + esc(S.alf.price || '') + '" autocomplete="off" style="width:100%;box-sizing:border-box;padding:12px;margin:4px 0;border-radius:10px;border:1px solid #8e8e9355;font-size:16px;background:transparent;color:inherit"><div class="segc"><span class="' + (S.alf.dir !== 'below' ? 'on' : '') + '" data-al="dir:above">Rises above</span><span class="' + (S.alf.dir === 'below' ? 'on' : '') + '" data-al="dir:below">Falls below</span></div><button class="btn" data-al="add">Add price alert</button>' + (S.alf.msg ? '<div class="note">' + esc(S.alf.msg) + '</div>' : '') + '</div>';
    if (S.pal.length) { h += '<div class="group">' + S.pal.slice().reverse().map(function (a) { return '<div class="row"><span><b>' + esc(base(a.sym)) + '</b> ' + (a.dir === 'above' ? 'above ' : 'below ') + fmtP(a.price, a.sym) + '<br><small class="mut">' + (a.done ? 'reached ' + ago(a.at) : 'waiting') + '</small></span><span class="badge wait" data-al="del:' + a.id + '">Delete</span></div>'; }).join('') + '</div>'; }
    h += sh('When the app is closed') + '<div class="group"><div class="row"><span>Background alerts</span><b class="' + (bg ? 'up' : 'org') + '">' + (bg ? 'ON: price alerts keep working' : 'needs the Android extras update') + '</b></div></div><div class="note">While the app is open, every alert above works. With the Android extras update, price alerts are also checked about every 15 minutes while the app is closed (Android decides the exact timing to save battery). Early movers, risk and news alerts need the app open.</div>';
    return h;
};
document.addEventListener('input', function (e) { var k = e.target.getAttribute ? e.target.getAttribute('data-alf') : null; if (k) { S.alf[k] = e.target.value; } });
document.addEventListener('click', function (e) {
    var q = e.target.closest ? e.target.closest('[data-al]') : null, a, sym, p, k, i;
    if (!q) { return; } a = q.getAttribute('data-al');
    if (a.indexOf('tog:') === 0) { k = a.slice(4); S.aflags[k] = !S.aflags[k]; mwSaveAl(); renderView(true); }
    else if (a.indexOf('dir:') === 0) { S.alf.dir = a.slice(4); renderView(true); }
    else if (a.indexOf('del:') === 0) { i = +a.slice(4); S.pal = S.pal.filter(function (x) { return x.id !== i; }); mwSaveAl(); renderView(true); }
    else if (a === 'add') {
        sym = (S.alf.sym || '').trim().toUpperCase().replace(/[^A-Z0-9]/g, ''); if (sym && !/USDT$/.test(sym)) { sym += 'USDT'; } p = parseFloat(S.alf.price);
        if (!S.tick[sym]) { S.alf.msg = 'Coin not found on Binance Futures. Try the short name, for example BTC.'; }
        else if (!(p > 0)) { S.alf.msg = 'Enter a price above zero.'; }
        else { S.pal.push({ id: Date.now(), sym: sym, dir: S.alf.dir === 'below' ? 'below' : 'above', price: p, done: false }); S.alf = { dir: S.alf.dir, msg: 'Alert added.' }; mwSaveAl(); }
        renderView(true);
    }
});
(function () { var css = document.createElement('style'); css.textContent = '.mwsw{width:46px;height:26px;border-radius:14px;background:rgba(127,127,127,.4);position:relative;flex:0 0 auto;cursor:pointer;transition:background .2s}.mwsw:after{content:"";position:absolute;left:3px;top:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .2s}.mwsw.on{background:#30d158}.mwsw.on:after{left:23px}'; document.head.appendChild(css); })();
mwSyncNative();
/* ---- Gold / Exness: professional bias ---- */
var MW_BULL = /war|attack|missile|strike|tension|sanction|escalat|conflict|crisis|haven|rate cut|dovish|recession|tariff|default|bank run/i, MW_BEAR = /rate hike|hawkish|strong dollar|ceasefire|peace deal|de-?escalat|yields? (rise|jump|surge)|strong jobs|risk-on|record high/i;
function mwBias() {
    var x = S.tech[GOLD], fx = S.fx, usdP = (fx && fx.eur != null && fx.gbp != null) ? -(0.829 * fx.eur + 0.171 * fx.gbp) : null, btc = S.tick.BTCUSDT, score = 0, why = [], news, bu = 0, be = 0, ex = [], lean, hs = [];
    if (x) {
        if (x.e20 > x.e50) { score += 2; why.push(['up', 'Gold trend (15-minute EMA20 above EMA50): UP']); } else { score -= 2; why.push(['dn', 'Gold trend (15-minute EMA20 below EMA50): DOWN']); }
        if (x.rsi >= 70) { score -= 1; why.push(['dn', 'RSI ' + x.rsi.toFixed(0) + ': overbought, a pullback is more likely']); } else if (x.rsi <= 30) { score += 1; why.push(['up', 'RSI ' + x.rsi.toFixed(0) + ': oversold, a bounce is more likely']); } else { why.push(['nt', 'RSI ' + x.rsi.toFixed(0) + ': neutral']); }
        if (x.h1 > 0.25) { score += 1; why.push(['up', 'Last hour ' + pct(x.h1) + ': buyers in control']); } else if (x.h1 < -0.25) { score -= 1; why.push(['dn', 'Last hour ' + pct(x.h1) + ': sellers in control']); }
    } else { why.push(['nt', 'Gold technical data is still loading']); }
    if (usdP != null) {
        if (usdP < -0.15) { score += 2; why.push(['up', 'Dollar proxy weaker (' + pct(usdP) + ' in 24h): usually supports gold']); } else if (usdP > 0.15) { score -= 2; why.push(['dn', 'Dollar proxy stronger (' + pct(usdP) + ' in 24h): usually presses gold']); } else { why.push(['nt', 'Dollar proxy flat: no push either way']); }
    } else { why.push(['nt', 'Dollar proxy not loaded yet']); }
    if (btc) { if (btc.chg <= -3) { score += 0.5; why.push(['up', 'Bitcoin ' + pct(btc.chg) + ': risk-off mood can lift gold']); } else if (btc.chg >= 3) { score -= 0.5; why.push(['dn', 'Bitcoin ' + pct(btc.chg) + ': risk-on mood, less safe-haven demand']); } }
    news = (S.news || []).filter(function (n) { return n.title && n.t && nowMs() - n.t < 18 * 3600000 && (n.g === 'geo' || n.g === 'macro' || /gold|dollar|fed |yield/i.test(n.title)); });
    news.forEach(function (n) { var u = MW_BULL.test(n.title), d = MW_BEAR.test(n.title); if (u) { bu++; } if (d) { be++; } if ((u || d) && hs.length < 3) { hs.push((u ? '▲ ' : '▼ ') + n.title); } });
    if (bu || be) { var ns = Math.max(-2, Math.min(2, bu - be)); score += ns; why.push([ns > 0 ? 'up' : ns < 0 ? 'dn' : 'nt', 'Headlines (18h): ' + bu + ' gold-positive vs ' + be + ' gold-negative']); } else { why.push(['nt', 'No clear gold-moving headline in the last 18 hours']); }
    lean = score >= 2.5 ? 'LONG' : score <= -2.5 ? 'SHORT' : 'WAIT';
    ex.push('A strong rise in the dollar or in US yields would weaken a long idea.'); ex.push('A sudden geopolitical shock (attack, sanctions) usually lifts gold within minutes.'); ex.push('Fed rate decisions, US jobs and inflation releases can reverse a trend in seconds: avoid new entries just before them.');
    return { lean: lean, score: score, why: why, hs: hs, ex: ex };
}
function mwBiasCard() {
    var b = mwBias(), col = b.lean === 'LONG' ? '#30d158' : b.lean === 'SHORT' ? '#ff453a' : '#ff9f0a';
    return sh('Professional bias for gold') + '<div class="group pad"><div class="mwh"><b style="font-size:20px;color:' + col + '">LEAN ' + b.lean + '</b><span class="badge wait">score ' + (b.score >= 0 ? '+' : '') + b.score.toFixed(1) + '</span></div>' +
        b.why.map(function (w) { return '<div class="mwd" style="margin:6px 0">' + (w[0] === 'up' ? '▲ ' : w[0] === 'dn' ? '▼ ' : '• ') + esc(w[1]) + '</div>'; }).join('') +
        (b.hs.length ? '<div class="note"><b>Headlines used</b><br>' + b.hs.map(esc).join('<br>') + '</div>' : '') +
        '<div class="note"><b>What would change this</b><br>' + b.ex.map(function (e) { return '• ' + esc(e); }).join('<br>') + '</div>' +
        '<div class="note">How gold usually reacts: stronger dollar and higher yields = gold down; weaker dollar and lower yields = gold up; war and crisis = gold up; calm and strong stocks = gold flat or down. Bitcoin and the S&P 500 are shown for context: open them live in Split Charts.</div><button class="btn sec" data-sp="preset:gold" data-act="win:split">🧩 Open gold, dollar, S&P 500 and 10-year yield together</button><div class="note">Educational analysis from public data, not financial advice. The exact dollar index (DXY), S&P 500 and yields have no free live feed here; use the Split Charts window for them.</div></div>';
}
var _vg103 = VIEWS.gold, _vx103 = VIEWS.exness;
VIEWS.gold = function () { return _vg103() + mwBiasCard(); };
VIEWS.exness = function () { return _vx103() + mwBiasCard(); };
/* ---- Split Charts (1 to 8 TradingView panes) ---- */
var SP_SYMS = [['Gold (OANDA)', 'OANDA:XAUUSD'], ['Gold futures', 'COMEX:GC1!'], ['Dollar index', 'TVC:DXY'], ['S&P 500', 'SP:SPX'], ['Nasdaq 100', 'NASDAQ:NDX'], ['US 10Y yield', 'TVC:US10Y'], ['Bitcoin perp', 'BINANCE:BTCUSDT.P'], ['Ethereum perp', 'BINANCE:ETHUSDT.P'], ['Oil (WTI)', 'TVC:USOIL'], ['EUR/USD', 'OANDA:EURUSD'], ['VIX', 'TVC:VIX'], ['Silver', 'OANDA:XAGUSD']];
var SP_INT = [['1', '1 min'], ['5', '5 min'], ['15', '15 min'], ['60', '1 hour'], ['240', '4 hour'], ['D', 'Day']];
var SP_SPANS = { 1: [12], 2: [12, 12], 3: [12, 6, 6], 4: [6, 6, 6, 6], 5: [6, 6, 4, 4, 4], 6: [6, 6, 6, 6, 6, 6], 7: [4, 4, 4, 3, 3, 3, 3], 8: [6, 6, 6, 6, 6, 6, 6, 6] };
var SP_PRE = { gold: ['OANDA:XAUUSD', 'TVC:DXY', 'SP:SPX', 'TVC:US10Y', 'COMEX:GC1!', 'TVC:VIX', 'BINANCE:BTCUSDT.P', 'TVC:USOIL'], crypto: ['BINANCE:BTCUSDT.P', 'BINANCE:ETHUSDT.P', 'BINANCE:SOLUSDT.P', 'BINANCE:BNBUSDT.P', 'BINANCE:XRPUSDT.P', 'BINANCE:DOGEUSDT.P', 'TVC:DXY', 'NASDAQ:NDX'], macro: ['SP:SPX', 'NASDAQ:NDX', 'TVC:DXY', 'TVC:US10Y', 'TVC:VIX', 'TVC:USOIL', 'OANDA:EURUSD', 'OANDA:XAUUSD'] };
var mwSplitHost = null;
function spDefault() { var p = [], i; for (i = 0; i < 8; i++) { p.push({ s: SP_PRE.gold[i], i: '15' }); } return { n: 4, panes: p }; }
function spLoad() { try { var j = JSON.parse(ls('mintoosuite_split', 'null')); if (j && j.panes && j.panes.length === 8 && j.n >= 1 && j.n <= 8) { return j; } } catch (e) {} return spDefault(); }
S.sp = spLoad();
function spSave() { lss('mintoosuite_split', JSON.stringify(S.sp)); }
function spSrc(p, i) { var dark = false; try { dark = window.matchMedia('(prefers-color-scheme: dark)').matches; } catch (e) {} return 'https://s.tradingview.com/widgetembed/?frameElementId=mwtv' + i + '&symbol=' + encodeURIComponent(p.s) + '&interval=' + encodeURIComponent(p.i) + '&hidesidetoolbar=1&symboledit=1&saveimage=0&toolbarbg=f1f3f6&studies=%5B%5D&theme=' + (dark ? 'dark' : 'light') + '&style=1&timezone=Asia%2FKarachi&withdateranges=1&locale=en'; }
function spBuild() {
    var sp = S.sp, n = sp.n, spans = SP_SPANS[n], hgt = n <= 2 ? 380 : 270, h = '', i, j, p, known;
    h += '<div class="segc">' + [1, 2, 3, 4, 5, 6, 7, 8].map(function (k) { return '<span class="' + (k === n ? 'on' : '') + '" data-sp="n:' + k + '">' + k + '</span>'; }).join('') + '</div>';
    h += '<div style="display:flex;gap:6px;flex-wrap:wrap;margin:6px 0"><span class="badge wait tap" data-sp="preset:gold">Gold & macro</span><span class="badge wait tap" data-sp="preset:crypto">Crypto</span><span class="badge wait tap" data-sp="preset:macro">World markets</span><span class="badge wait tap" data-sp="reset">Reset</span></div>';
    h += '<div style="display:grid;grid-template-columns:repeat(12,1fr);gap:8px">';
    for (i = 0; i < n; i++) {
        p = sp.panes[i]; known = SP_SYMS.some(function (x) { return x[1] === p.s; });
        h += '<div style="grid-column:span ' + spans[i] + ';background:var(--card,#fff);border-radius:14px;overflow:hidden;box-shadow:var(--shadow)"><div style="display:flex;gap:4px;padding:6px;align-items:center"><select data-spsel="s:' + i + '" style="flex:1;min-width:0;padding:6px;border-radius:8px;border:1px solid #8e8e9355;background:transparent;color:inherit">' + (known ? '' : '<option selected value="' + esc(p.s) + '">' + esc(p.s) + '</option>') + SP_SYMS.map(function (x) { return '<option value="' + x[1] + '"' + (x[1] === p.s ? ' selected' : '') + '>' + x[0] + '</option>'; }).join('') + '</select><select data-spsel="i:' + i + '" style="padding:6px;border-radius:8px;border:1px solid #8e8e9355;background:transparent;color:inherit">' + SP_INT.map(function (x) { return '<option value="' + x[0] + '"' + (x[0] === p.i ? ' selected' : '') + '>' + x[1] + '</option>'; }).join('') + '</select><a href="https://www.tradingview.com/chart/?symbol=' + encodeURIComponent(p.s) + '" target="_blank" rel="noopener" style="text-decoration:none;font-size:18px" title="Open in browser">↗</a></div><iframe id="mwtv' + i + '" src="' + spSrc(p, i) + '" style="width:100%;height:' + hgt + 'px;border:0;display:block" loading="lazy" allowfullscreen></iframe></div>';
    }
    h += '</div><div class="note">Charts come from TradingView\'s free embed. If a pane stays blank, tap the arrow to open it in your browser. Type any TradingView symbol (for example NASDAQ:AAPL) below to change the first pane:</div><input data-spc="0" placeholder="Symbol for pane 1, for example NASDAQ:AAPL" autocomplete="off" style="width:100%;box-sizing:border-box;padding:10px;border-radius:10px;border:1px solid #8e8e9355;background:transparent;color:inherit;font-size:15px">';
    return h;
}
function mwSplitMount() {
    var m = document.getElementById('mwSplitMount'); if (!m) { return; }
    if (!mwSplitHost) { mwSplitHost = document.createElement('div'); mwSplitHost.id = 'mwSplitHost'; mwSplitHost.innerHTML = spBuild(); }
    if (mwSplitHost.parentNode !== m) { m.appendChild(mwSplitHost); }
}
function spRebuild() { if (mwSplitHost) { mwSplitHost.innerHTML = spBuild(); } }
function vSplit() { return '<div class="note" style="margin:0 0 8px">Study several markets at once. Pick how many charts (1 to 8), then choose the market and time frame in each pane.</div><div id="mwSplitMount"></div>'; }
document.addEventListener('click', function (e) {
    var q = e.target.closest ? e.target.closest('[data-sp]') : null, a, k, i; if (!q) { return; } a = q.getAttribute('data-sp');
    if (a.indexOf('n:') === 0) { S.sp.n = +a.slice(2); spSave(); spRebuild(); }
    else if (a.indexOf('preset:') === 0) { k = SP_PRE[a.slice(7)]; if (k) { for (i = 0; i < 8; i++) { S.sp.panes[i].s = k[i]; } if (S.sp.n < 4) { S.sp.n = 4; } spSave(); spRebuild(); } }
    else if (a === 'reset') { S.sp = spDefault(); spSave(); spRebuild(); }
});
function spChange(e) {
    var t = e.target, a = t.getAttribute ? (t.getAttribute('data-spsel') || '') : '', c = t.getAttribute ? t.getAttribute('data-spc') : null, i, f, fr;
    if (c !== null && c !== undefined && t.value) { S.sp.panes[0].s = t.value.trim().toUpperCase(); spSave(); spRebuild(); return; }
    if (!a) { return; } f = a.split(':')[0]; i = +a.split(':')[1];
    if (f === 's') { S.sp.panes[i].s = t.value; } else { S.sp.panes[i].i = t.value; }
    spSave(); fr = document.getElementById('mwtv' + i); if (fr) { fr.src = spSrc(S.sp.panes[i], i); }
}
document.addEventListener('change', spChange);
/* ---- Help v2 ---- */
function mwYt(q) { return 'https://www.youtube.com/results?search_query=' + encodeURIComponent(q); }
var MW_LINKS = { academy: ['Binance Academy', 'https://academy.binance.com/en'], bfaq: ['Binance support (Futures)', 'https://www.binance.com/en/support/faq'], tv: ['TradingView help', 'https://www.tradingview.com/support/'], inv: ['Investopedia', 'https://www.investopedia.com'], ex: ['Exness', 'https://www.exness.com'], mt5: ['MetaTrader 5 help', 'https://www.metatrader5.com/en/terminal/help'] };
var MW_TOPICS = [
    { id: 'start', t: '🚀 Start here (5 steps)', win: 'overview', b: '1. Home shows the best ideas first. 2. Read the card: entry, stop, target and the VALID time. 3. Choose your leverage on the 1× to 50× bar (swipe it left or right). 4. Practise with the paper bot and Practice sends first. 5. Only trade money you can afford to lose.', l: ['academy'], v: 'crypto futures for beginners' },
    { id: 'card', t: '🃏 How to read a signal card', win: 'overview', b: 'ENTRY is the price to buy (LONG) or sell (SHORT). STOP is where you accept being wrong and close. TARGET is where you take profit. VALID shows the time window in which the idea still applies; after it ends the card is marked ENDED and should not be used. "Indicators agree" shows how many checks point the same way. It is not the chance of profit.', l: ['academy', 'inv'], v: 'stop loss take profit explained' },
    { id: 'lev', t: '⚙️ Leverage and risk', win: 'overview', b: 'Leverage multiplies both profit and loss. At 10× a 10% move against you can wipe out the money you put in. Use small size, always use a stop, and never add to a losing trade. The "profit boxes" on each card show what each leverage would earn or lose.', l: ['bfaq', 'academy'], v: 'futures leverage liquidation explained' },
    { id: 'newday', t: '🌅 New Day plan', win: 'morning', b: 'Plans are locked at 05:15 PKT for the whole day and for a few hours. A badge shows if the window is still running or has ENDED. Tap the chart under any card to see the candles. The track record shows what really happened over the last 9 days.', l: ['academy'], v: 'trading plan daily routine' },
    { id: 'movers', t: '🚀 Early Movers', win: 'movers', b: 'Scans the top coins every minute for a fast move on rising volume while the day change is still small. EARLY = just starting, WATCH = building, LATE = already stretched. Many fast moves reverse: use a small size and the stop shown.', l: ['academy'], v: 'volume breakout trading' },
    { id: 'bot', t: '🧪 Paper bot', win: 'bot', b: 'A practice bot with virtual money and real prices. It risks 1% per trade, moves its stop to break-even at 50% of the way to the target, trails at 75%, pauses after a 3% daily loss or 3 losses in a row, and closes after 3 hours. It never places real orders. Judge it only after 50+ trades.', l: ['inv'], v: 'paper trading explained' },
    { id: 'risk', t: '🎛 Risk Meter', win: 'risk', b: 'The dial shows the part of your paper account you would lose if every open trade hit its stop. Tabs: Overview, Trades (with Close buttons), Exposure (long vs short) and Limits (safety rules).', l: ['inv'], v: 'portfolio risk management trading' },
    { id: 'gold', t: '🥇 Gold and Exness', win: 'gold', b: 'Gold prices use Binance gold futures as a close stand-in for Exness (they can differ slightly). The Professional bias card combines the gold trend, a dollar-strength proxy, Bitcoin mood and headlines. For the exact dollar index, S&P 500 and yields, use Split Charts.', l: ['ex', 'inv'], v: 'gold price drivers dollar yields' },
    { id: 'wallet', t: '👛 My Wallet', win: 'wallet', b: 'Your keys are made and kept only on this phone. Write the 12 words on paper: they are the only way to recover the wallet. Receive on BNB Smart Chain (BEP-20), Ethereum, Polygon, Arbitrum, Base and Bitcoin. Practice sends first, then very small real amounts. Never share the 12 words with anyone.', l: ['academy'], v: 'crypto wallet seed phrase safety' },
    { id: 'split', t: '🧩 Split Charts', win: 'split', b: 'Up to 8 live TradingView charts at once with their own market and time frame. Use the presets for gold, crypto or world markets.', l: ['tv'], v: 'tradingview multi chart layout' },
    { id: 'alerts', t: '🔔 Alerts', win: 'alerts', b: 'Switch on the alert types you want and add price alerts for any coin. Alerts work while the app is open; price alerts also work in the background with the Android extras update.', l: [], v: 'price alerts crypto' },
    { id: 'fix', t: '🛠 Troubleshooting', win: 'health', b: 'No news: open News, tap Try again and read the source list at the bottom. Prices look slow: Health shows how old the data is. Clock off by a few seconds: turn on Automatic date and time in phone settings. Screen blank: pull down to refresh.', l: [], v: '' },
    { id: 'safe', t: '⚠️ Safety and legal', win: '', b: 'This app gives information, not financial advice. Trading and leverage can lose all your money. Rules for crypto differ by country; in Pakistan check the current PVARA rules. Never send money to anyone who promises guaranteed profit.', l: ['academy'], v: '' }
];
S.hp = S.hp || { open: 'start' };
VIEWS.help = function () {
    var h = '<div class="note" style="margin:0 0 8px">Tap a topic. Links open the official sites of Binance, TradingView, Exness and Investopedia in your phone browser. Video links open YouTube searches, so you always see current videos.</div><div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">' + MW_TOPICS.map(function (t) { return '<span class="badge ' + (S.hp.open === t.id ? 'long' : 'wait') + ' tap" data-hp="' + t.id + '">' + t.t + '</span>'; }).join('') + '</div>';
    MW_TOPICS.forEach(function (t) {
        if (S.hp.open !== t.id) { return; }
        h += '<div class="group pad"><b style="font-size:18px">' + t.t + '</b><p style="line-height:1.5">' + esc(t.b) + '</p>' + (t.win ? '<button class="btn sec" data-act="win:' + t.win + '">Open this window ›</button>' : '') + (t.l.length ? '<div class="note"><b>Learn more (official sites)</b><br>' + t.l.map(function (k) { return '<a href="' + MW_LINKS[k][1] + '" target="_blank" rel="noopener">' + MW_LINKS[k][0] + ' ›</a>'; }).join('<br>') + '</div>' : '') + (t.v ? '<div class="note"><a href="' + mwYt(t.v) + '" target="_blank" rel="noopener">▶ Watch videos about this on YouTube ›</a></div>' : '') + '</div>';
    });
    h += sh('Glossary') + '<div class="group pad"><div class="note" style="margin:0"><b>Entry</b> the price to buy or sell. <b>Stop</b> where you accept being wrong. <b>Target</b> where you take profit. <b>Leverage</b> multiplies profit and loss. <b>LONG</b> bet on a rise. <b>SHORT</b> bet on a fall. <b>VALID</b> the time window of an idea. <b>Indicators agree</b> how many checks point the same way. <b>Paper trading</b> practice with virtual money. <b>Liquidation</b> the exchange closes your trade because the margin is gone. <b>DXY</b> the US dollar index. <b>RSI</b> a 0 to 100 gauge: above 70 is stretched up, below 30 stretched down. <b>EMA</b> a smoothed average price.</div></div>';
    h += sh('Frequently asked') + '<div class="group pad"><div class="note" style="margin:0"><b>Does the app place real trades?</b> Only when you press the Trade button yourself, with your own Binance keys. The paper bot never does.<br><br><b>Why did a signal lose?</b> No signal wins every time. Check the stop and use small size.<br><br><b>Is my wallet safe?</b> Keys stay on this phone, encrypted with your password. Keep the 12 words on paper.<br><br><b>Where does the data come from?</b> Binance public data, TradingView embeds and public news feeds.</div></div>';
    return h + sh('Support') + '<div class="group pad"><div class="note" style="margin:0">Email: awaisrajpoot2@yahoo.com<br>Muhammad Awais, Broadway Street, Greens Avenue, Park Road, Islamabad, Pakistan<br>Information only, not financial advice.</div></div>';
