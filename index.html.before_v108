    firstOk(tries.map(function (p) { return p.then(function (t) { var r = pxParse(t); if (r.length < 20) { throw new Error('empty'); } return r; }); })).then(function (r) { S.px.rows = r; S.px.at = Date.now(); }).catch(function () { S.px.err = 'The PSX market-watch page could not be read from here (the PSX site may block apps or change its layout). Open the official PSX portal or your broker app below.'; S.px.at = Date.now() - 30000; }).then(function () { S.px.busy = false; if (S.win === 'psx') { m7pxRefresh(); } });
    fetchText('https://dps.psx.com.pk/timeseries/int/KSE100', 10000).then(function (t) { var j = JSON.parse(t), d = j && j.data; if (d && d.length) { var l = d[0], f = d[d.length - 1]; S.px.idx = { last: +(l[1] !== undefined ? l[1] : l.c), first: +(f[1] !== undefined ? f[1] : f.c), n: d.length }; } }).catch(function () {});
}
