        return _vh() + sh('Glossary') + '<div class="group pad"><div class="note" style="margin:0"><b>Entry</b>: the price to buy (LONG) or sell (SHORT). <b>Stop</b>: the price where you accept being wrong and close. <b>Target</b>: where you take profit. <b>Leverage (5×)</b>: multiplies profit and loss; high leverage can wipe out your money fast. <b>Indicators agree</b>: how many checks point the same way, not the chance of profit. <b>VALID</b>: the time window in which the idea still applies. <b>Paper trading</b>: virtual money with real prices.</div></div>' + sh('Support') + '<div class="group pad"><div class="note" style="margin:0">Email: awaisrajpoot2@yahoo.com<br>Muhammad Awais, Broadway Street, Greens Avenue, Park Road, Islamabad, Pakistan<br>This app gives information, not financial advice. Trading can lose money.</div></div>';
    };
    /* pull down to refresh (when the page is at the top) */
    var py = null, px0 = 0, pd = 0, bar = null;
    function pbar(txt) { if (!bar) { bar = document.createElement('div'); bar.className = 'mwptr'; document.body.appendChild(bar); } bar.textContent = txt; bar.style.display = txt ? 'block' : 'none'; }
    function doRefresh() {
        pbar('Refreshing…');
        try {
            if (S.win === 'news') { loadNews(true); } else if (S.win === 'wallet') { MW.refresh(); } else { try { runScan(); } catch (e) {} try { loadFx(); } catch (e) {} renderView(true); }
        } catch (e) {}
