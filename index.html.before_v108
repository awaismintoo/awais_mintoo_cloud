// ----- indicators -----
function iSMA(a, n) { var o = [], s = 0, i; for (i = 0; i < a.length; i++) { s += a[i]; if (i >= n) { s -= a[i - n]; } o.push(i >= n - 1 ? s / n : null); } return o; }
function iEMA(a, n) { var k = 2 / (n + 1), e = null, o = [], i; for (i = 0; i < a.length; i++) { e = e === null ? a[i] : a[i] * k + e * (1 - k); o.push(i >= n - 1 ? e : null); } return o; }
function iBOLL(a, n, m) { var mid = iSMA(a, n), up = [], lo = [], i, j, s, d; for (i = 0; i < a.length; i++) { if (mid[i] === null) { up.push(null); lo.push(null); continue; } s = 0; for (j = i - n + 1; j <= i; j++) { s += (a[j] - mid[i]) * (a[j] - mid[i]); } d = Math.sqrt(s / n) * m; up.push(mid[i] + d); lo.push(mid[i] - d); } return { mid: mid, up: up, lo: lo }; }
function iRSI(a, n) { var o = [null], g = 0, l = 0, i, d; for (i = 1; i < a.length; i++) { d = a[i] - a[i - 1]; if (i <= n) { g += Math.max(0, d); l += Math.max(0, -d); if (i === n) { g /= n; l /= n; o.push(l === 0 ? 100 : 100 - 100 / (1 + g / l)); } else { o.push(null); } } else { g = (g * (n - 1) + Math.max(0, d)) / n; l = (l * (n - 1) + Math.max(0, -d)) / n; o.push(l === 0 ? 100 : 100 - 100 / (1 + g / l)); } } return o; }
function iMACD(a) { var e12 = iEMA(a, 12), e26 = iEMA(a, 26), dif = [], i; for (i = 0; i < a.length; i++) { dif.push(e12[i] !== null && e26[i] !== null ? e12[i] - e26[i] : null); } var dd = dif.map(function (x) { return x === null ? 0 : x; }), dea = iEMA(dd, 9), hist = dif.map(function (x, j) { return x === null || j < 33 ? null : x - dea[j]; }); return { dif: dif, dea: dea.map(function (x, j) { return j < 33 ? null : x; }), hist: hist }; }
function iKDJ(k) { var n = 9, K = 50, D = 50, o = { k: [], d: [], j: [] }, i, j, hi, lo, rsv; for (i = 0; i < k.length; i++) { hi = -Infinity; lo = Infinity; for (j = Math.max(0, i - n + 1); j <= i; j++) { hi = Math.max(hi, k[j].h); lo = Math.min(lo, k[j].l); } rsv = hi === lo ? 50 : (k[i].c - lo) / (hi - lo) * 100; K = 2 / 3 * K + rsv / 3; D = 2 / 3 * D + K / 3; o.k.push(i >= n - 1 ? K : null); o.d.push(i >= n - 1 ? D : null); o.j.push(i >= n - 1 ? 3 * K - 2 * D : null); } return o; }
function iOBV(k) { var o = [], v = 0, i; for (i = 0; i < k.length; i++) { if (i) { v += k[i].c > k[i - 1].c ? k[i].v : k[i].c < k[i - 1].c ? -k[i].v : 0; } o.push(v); } return o; }
function iVWAP(k) { var o = [], pv = 0, vv = 0, day = -1, i, d, tp; for (i = 0; i < k.length; i++) { d = Math.floor(k[i].t / 86400000); if (d !== day) { day = d; pv = 0; vv = 0; } tp = (k[i].h + k[i].l + k[i].c) / 3; pv += tp * k[i].v; vv += k[i].v; o.push(vv ? pv / vv : null); } return o; }
function iSAR(k) { var o = [], up = true, af = 0.02, ep = k[0].h, sar = k[0].l, i; o.push(null); for (i = 1; i < k.length; i++) { sar = sar + af * (ep - sar); if (up) { sar = Math.min(sar, k[i - 1].l, i > 1 ? k[i - 2].l : k[i - 1].l); if (k[i].l < sar) { up = false; sar = ep; ep = k[i].l; af = 0.02; } else if (k[i].h > ep) { ep = k[i].h; af = Math.min(0.2, af + 0.02); } } else { sar = Math.max(sar, k[i - 1].h, i > 1 ? k[i - 2].h : k[i - 1].h); if (k[i].h > sar) { up = true; sar = ep; ep = k[i].h; af = 0.02; } else if (k[i].l < ep) { ep = k[i].l; af = Math.min(0.2, af + 0.02); } } o.push({ v: sar, up: up }); } return o; }
function iSUPER(k, n, m) { var o = [], atr = [], i, tr, fu = null, fl = null, dir = 1, a = 0; for (i = 0; i < k.length; i++) { tr = i ? Math.max(k[i].h - k[i].l, Math.abs(k[i].h - k[i - 1].c), Math.abs(k[i].l - k[i - 1].c)) : k[i].h - k[i].l; a = i < n ? (a * i + tr) / (i + 1) : (a * (n - 1) + tr) / n; atr.push(a); if (i < n) { o.push(null); continue; } var hl2 = (k[i].h + k[i].l) / 2, bu = hl2 + m * a, bl = hl2 - m * a; fu = (fu === null || bu < fu || k[i - 1].c > fu) ? bu : fu; fl = (fl === null || bl > fl || k[i - 1].c < fl) ? bl : fl; if (dir > 0 && k[i].c < fl) { dir = -1; } else if (dir < 0 && k[i].c > fu) { dir = 1; } o.push({ v: dir > 0 ? fl : fu, up: dir > 0 }); } return o; }
// ----- screen -----
function vChart() {
    var c = S.chart, C = S.cx, h = '';
    h += '<div class="m7q"><span>🔍</span><input data-m7in="chs" placeholder="Search any coin: ' + esc(nm(c.sym)) + '" autocomplete="off"></div><div id="m7chs"></div>';
    h += '<div class="m7row">' + CX_TF.map(function (tf) { return '<span class="' + (c.tf === tf ? 'on' : '') + '" data-act="tf:' + tf + '">' + tf + '</span>'; }).join('') + '</div>';
    h += '<div class="group pad" style="padding:10px 8px"><div class="note" id="chartInfo" style="margin:0 0 6px;font-size:11.5px"></div><div class="m7cw" id="m7cw" style="position:relative"><canvas id="cv" style="height:440px;touch-action:none;border-radius:10px"></canvas><div class="m7pop" id="m7pop" style="display:none"></div></div>';
    h += '<div class="m7ind">' + ['MA', 'EMA', 'BOLL', 'SAR', 'SUPER', 'VWAP'].map(function (n) { return '<span class="' + (C.ov[n] ? 'on' : '') + '" data-m7="ov:' + n + '">' + n + '</span>'; }).join('') + '</div>';
    h += '<div class="m7ind">' + ['VOL', 'MACD', 'RSI', 'KDJ', 'OBV'].map(function (n) { return '<span class="' + (C.sub === n ? 'on' : '') + '" data-m7="sub2:' + n + '">' + n + '</span>'; }).join('') + '</div>';
    h += '<div class="note" id="chartNote" style="margin:4px 0 0"></div></div>';
    h += '<div class="group pad"><div class="sh" style="margin:0 0 6px">Why this chart</div><div class="note" style="margin:0">Tap any candle to see its open and close time, open, high, low, close, change, range and volume. Drag to move through time, pinch (or use the buttons below) to zoom. The last candle moves live. Layman view: green = price closed higher than it opened, red = lower. The thin line shows how far price went; the thick part is open to close.</div><div class="m7ind" style="margin-top:8px"><span data-m7="zoom:in">Zoom in ＋</span><span data-m7="zoom:out">Zoom out －</span><span data-m7="zoom:live">Jump to now ▶</span><span data-m7="analyze:' + esc(c.sym) + '">🤖 Ask the bot</span></div></div>';
    return h;
}
function cxChSearch() {
    var q = (S.cx.q || '').toUpperCase().trim(), box = $('m7chs'); if (!box) { return; }
    if (!q) { box.innerHTML = ''; return; }
    var rows = m7rowsAll(q).slice(0, 8);
    box.innerHTML = '<div class="group">' + (rows.length ? rows.map(function (r) { return '<div class="m7r tap" data-m7="chsel:' + r.src + ':' + esc(r.sym) + '"><div class="l"><b>' + esc(r.sym) + '</b><span class="m7tag">' + esc(r.tag) + '</span></div><div class="r"><div>' + fmtP(r.p, r.sym) + '</div></div></div>'; }).join('') : '<div class="pad mut" style="padding:12px 14px">No match</div>') + '</div>';
}
function m7rowsAll(q) { var sv = S.m7.mk.q; S.m7.mk.q = q; var r = m7rows(); S.m7.mk.q = sv; return r; }
function drawChart() {
    var cvs = $('cv'); if (!cvs) { return; }
    var dpr = window.devicePixelRatio || 1, w = cvs.clientWidth, h = cvs.clientHeight; if (!w || !h) { return; }
    if (cvs.width !== Math.round(w * dpr) || cvs.height !== Math.round(h * dpr)) { cvs.width = Math.round(w * dpr); cvs.height = Math.round(h * dpr); }
    var g = cvs.getContext('2d'); g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, w, h);
    var C = S.cx, ch = S.chart, K = ch.k, note = $('chartNote'), info = $('chartInfo'), GR = '#2ebd85', RD = '#f6465d', LN = cv('--line'), MT = cv('--mut'), TX = cv('--tx');
    g.font = '11px -apple-system,Segoe UI,sans-serif';
    if (!K.length) { g.fillStyle = MT; g.fillText(ch.err || 'Loading candles…', 12, 24); if (note) { note.textContent = ch.err || ''; } return; }
    var padR = 62, padT = 6, axisH = 18, subH = C.sub === 'VOL' ? 70 : 84, ph = h - padT - axisH - subH - 8, W = w - padR;
    var n = Math.max(15, Math.min(C.n, K.length)), maxOff = Math.max(0, K.length - n); C.off = Math.max(0, Math.min(C.off, maxOff + Math.floor(n / 2)));
    var end = K.length - Math.min(C.off, maxOff), start = Math.max(0, end - n), v = K.slice(start, end), cw = W / (n + 2), i;
    if (start < 30 && !C.more) { cxMore(); }
    var closes = K.map(function (x) { return x.c; }), ind = {};
    if (C.ov.MA) { ind.ma7 = iSMA(closes, 7); ind.ma25 = iSMA(closes, 25); ind.ma99 = iSMA(closes, 99); }
    if (C.ov.EMA) { ind.e9 = iEMA(closes, 9); ind.e21 = iEMA(closes, 21); ind.e50 = iEMA(closes, 50); }
    if (C.ov.BOLL) { ind.bo = iBOLL(closes, 20, 2); }
    if (C.ov.SAR) { ind.sar = iSAR(K); }
    if (C.ov.SUPER) { ind.sup = iSUPER(K, 10, 3); }
    if (C.ov.VWAP) { ind.vw = iVWAP(K); }
    var hi = -Infinity, lo = Infinity, vmax = 0;
    v.forEach(function (x) { if (x.h > hi) { hi = x.h; } if (x.l < lo) { lo = x.l; } if (x.v > vmax) { vmax = x.v; } });
    function inc(arr) { if (!arr) { return; } for (var j = start; j < end; j++) { var q = arr[j]; if (q !== null && q !== undefined) { var val = typeof q === 'object' ? q.v : q; if (val > hi) { hi = val; } if (val < lo) { lo = val; } } } }
    inc(ind.ma7); inc(ind.ma25); inc(ind.e9); inc(ind.e21); if (ind.bo) { inc(ind.bo.up); inc(ind.bo.lo); } inc(ind.vw);
    var pad = (hi - lo) * 0.06 || hi * 0.001; hi += pad; lo -= pad; var span = hi - lo, y = function (p) { return padT + (hi - p) / span * ph; }, xs = function (j) { return (j - start) * cw + cw * 1.0 + cw / 2; };
    g.lineWidth = 1;
    for (i = 0; i <= 4; i++) { var gy = padT + ph * i / 4, gp = hi - span * i / 4; g.strokeStyle = LN; g.beginPath(); g.moveTo(0, gy); g.lineTo(W, gy); g.stroke(); g.fillStyle = MT; g.textAlign = 'left'; g.fillText(fmtP(gp, ch.sym), W + 4, gy + 4); }
    // time axis in the chosen time zone
    var every = Math.max(1, Math.ceil(n / Math.max(2, Math.floor(W / (CX_MS[ch.tf] >= 86400 ? 70 : 115))))); g.fillStyle = MT; g.textAlign = 'center';
    for (i = start; i < end; i += every) { var tt = K[i].t, lab = CX_MS[ch.tf] >= 86400 ? m7fmt(tt, 'd') : m7fmt(tt, 'dt'); g.fillText(lab, Math.min(W - 24, Math.max(24, xs(i))), padT + ph + 14); }
    g.textAlign = 'left';
    // Bollinger fill
    if (ind.bo) { g.fillStyle = 'rgba(240,185,11,.07)'; g.beginPath(); var f1 = true, j; for (j = start; j < end; j++) { if (ind.bo.up[j] === null) { continue; } if (f1) { g.moveTo(xs(j), y(ind.bo.up[j])); f1 = false; } else { g.lineTo(xs(j), y(ind.bo.up[j])); } } for (j = end - 1; j >= start; j--) { if (ind.bo.lo[j] === null) { continue; } g.lineTo(xs(j), y(ind.bo.lo[j])); } g.closePath(); g.fill(); }
    // candles with a soft 3D look
    var bw = Math.max(2, cw * 0.72);
    v.forEach(function (x, jj) {
        var j = start + jj, up = x.c >= x.o, col = up ? GR : RD, cx = xs(j), yt = y(Math.max(x.o, x.c)), yb = y(Math.min(x.o, x.c)), bh = Math.max(1.5, yb - yt), live = (j === K.length - 1);
        g.strokeStyle = col; g.lineWidth = Math.max(1, Math.min(2, cw * 0.12)); g.beginPath(); g.moveTo(cx, y(x.h)); g.lineTo(cx, y(x.l)); g.stroke();
        var gr = g.createLinearGradient(cx - bw / 2, 0, cx + bw / 2, 0); gr.addColorStop(0, up ? '#58e0a8' : '#ff8396'); gr.addColorStop(0.45, col); gr.addColorStop(1, up ? '#168a63' : '#b8293c');
        if (live) { g.shadowColor = col; g.shadowBlur = 10; } else { g.shadowColor = 'rgba(0,0,0,.22)'; g.shadowBlur = 3; g.shadowOffsetY = 1; }
        g.fillStyle = gr; g.fillRect(cx - bw / 2, yt, bw, bh); g.shadowBlur = 0; g.shadowOffsetY = 0;
        if (C.sub === 'VOL') { var vh = vmax ? x.v / vmax * (subH - 18) : 0, vg = g.createLinearGradient(0, h - axisH - vh, 0, h - axisH); vg.addColorStop(0, up ? 'rgba(46,189,133,.85)' : 'rgba(246,70,93,.85)'); vg.addColorStop(1, up ? 'rgba(46,189,133,.25)' : 'rgba(246,70,93,.25)'); g.fillStyle = vg; g.fillRect(cx - bw / 2, padT + ph + axisH + (subH - 18 - vh) + 8, bw, vh); }
    });
    function line(arr, col, wd) { if (!arr) { return; } g.strokeStyle = col; g.lineWidth = wd || 1.2; g.beginPath(); var st = true; for (var j = start; j < end; j++) { var q = arr[j]; if (q === null || q === undefined) { st = true; continue; } var val = typeof q === 'object' ? q.v : q; if (st) { g.moveTo(xs(j), y(val)); st = false; } else { g.lineTo(xs(j), y(val)); } } g.stroke(); }
    if (ind.ma7) { line(ind.ma7, '#f0b90b'); line(ind.ma25, '#e91e63'); line(ind.ma99, '#9c6bff'); }
    if (ind.e9) { line(ind.e9, '#00bcd4'); line(ind.e21, '#ff9800'); line(ind.e50, '#8bc34a'); }
    if (ind.bo) { line(ind.bo.mid, '#f0b90b', 1); line(ind.bo.up, '#9c6bff', 1); line(ind.bo.lo, '#9c6bff', 1); }
    if (ind.vw) { line(ind.vw, '#ffffff'.replace('#fff', TX === '#fff' ? '#fff' : '#555'), 1.2); }
    if (ind.sar) { for (var s2 = start; s2 < end; s2++) { var q2 = ind.sar[s2]; if (q2) { g.fillStyle = q2.up ? GR : RD; g.beginPath(); g.arc(xs(s2), y(q2.v), 1.8, 0, 6.3); g.fill(); } } }
    if (ind.sup) { for (var u2 = start + 1; u2 < end; u2++) { var a = ind.sup[u2], b = ind.sup[u2 - 1]; if (a && b && a.up === b.up) { g.strokeStyle = a.up ? GR : RD; g.lineWidth = 2; g.beginPath(); g.moveTo(xs(u2 - 1), y(b.v)); g.lineTo(xs(u2), y(a.v)); g.stroke(); } } }
    // high / low tags
    var hiC = v.reduce(function (m, x, j) { return x.h > v[m].h ? j : m; }, 0), loC = v.reduce(function (m, x, j) { return x.l < v[m].l ? j : m; }, 0); g.fillStyle = TX;
    g.textAlign = xs(start + hiC) > W / 2 ? 'right' : 'left'; g.fillText(fmtP(v[hiC].h, ch.sym), xs(start + hiC) + (g.textAlign === 'right' ? -4 : 4), y(v[hiC].h) - 3);
    g.textAlign = xs(start + loC) > W / 2 ? 'right' : 'left'; g.fillText(fmtP(v[loC].l, ch.sym), xs(start + loC) + (g.textAlign === 'right' ? -4 : 4), y(v[loC].l) + 11); g.textAlign = 'left';
    // sub pane
    var sy0 = padT + ph + axisH + 8, sh0 = subH - 18;
    g.strokeStyle = LN; g.beginPath(); g.moveTo(0, sy0 - 4); g.lineTo(W, sy0 - 4); g.stroke(); g.fillStyle = MT;
    function subLine(arr, col, mn, mx) { g.strokeStyle = col; g.lineWidth = 1.2; g.beginPath(); var st = true; for (var j = start; j < end; j++) { var q = arr[j]; if (q === null || q === undefined) { st = true; continue; } var yy = sy0 + (mx - q) / (mx - mn) * sh0; if (st) { g.moveTo(xs(j), yy); st = false; } else { g.lineTo(xs(j), yy); } } g.stroke(); }
    var lastIdx = C.sel >= 0 && C.sel < K.length ? C.sel : K.length - 1, legend = '';
    if (C.sub === 'MACD') { var mc = iMACD(closes), mm = 0; for (i = start; i < end; i++) { [mc.dif[i], mc.dea[i], mc.hist[i]].forEach(function (q) { if (q !== null) { mm = Math.max(mm, Math.abs(q)); } }); } mm = mm || 1; for (i = start; i < end; i++) { var hv = mc.hist[i]; if (hv === null) { continue; } var h0 = sy0 + sh0 / 2, hh = hv / mm * sh0 / 2; g.fillStyle = hv >= 0 ? GR : RD; g.fillRect(xs(i) - bw / 2, hv >= 0 ? h0 - hh : h0, bw, Math.abs(hh)); } subLine(mc.dif, '#f0b90b', -mm, mm); subLine(mc.dea, '#e91e63', -mm, mm); legend = 'DIF ' + m7num(mc.dif[lastIdx], 6) + '  DEA ' + m7num(mc.dea[lastIdx], 6) + '  MACD ' + m7num(mc.hist[lastIdx], 6); }
    else if (C.sub === 'RSI') { var rs = iRSI(closes, 14); [30, 70].forEach(function (lv) { var yy = sy0 + (100 - lv) / 100 * sh0; g.strokeStyle = LN; g.setLineDash([3, 3]); g.beginPath(); g.moveTo(0, yy); g.lineTo(W, yy); g.stroke(); g.setLineDash([]); g.fillStyle = MT; g.fillText(String(lv), W + 4, yy + 4); }); subLine(rs, '#9c6bff', 0, 100); legend = 'RSI(14) ' + m7num(rs[lastIdx], 2); }
    else if (C.sub === 'KDJ') { var kd = iKDJ(K), kmn = 0, kmx = 100; for (i = start; i < end; i++) { if (kd.j[i] !== null) { kmn = Math.min(kmn, kd.j[i]); kmx = Math.max(kmx, kd.j[i]); } } subLine(kd.k, '#f0b90b', kmn, kmx); subLine(kd.d, '#e91e63', kmn, kmx); subLine(kd.j, '#9c6bff', kmn, kmx); legend = 'K ' + m7num(kd.k[lastIdx], 2) + '  D ' + m7num(kd.d[lastIdx], 2) + '  J ' + m7num(kd.j[lastIdx], 2); }
    else if (C.sub === 'OBV') { var ob = iOBV(K), omn = Infinity, omx = -Infinity; for (i = start; i < end; i++) { omn = Math.min(omn, ob[i]); omx = Math.max(omx, ob[i]); } if (omx === omn) { omx = omn + 1; } subLine(ob, '#00bcd4', omn, omx); legend = 'OBV ' + m7vol(ob[lastIdx]); }
    else { legend = 'Vol ' + m7vol(K[lastIdx].v) + '  MA(5) ' + m7vol(iSMA(K.map(function (x) { return x.v; }), 5)[lastIdx] || 0); }
    g.fillStyle = MT; g.fillText(legend, 4, sy0 + 8);
    // live price line + countdown
    var lastC = K[K.length - 1], tk = ch.sym && cxSrc() === 'f' ? S.tick[ch.sym] : null, lp = lastC.c, ly = Math.min(padT + ph, Math.max(padT, y(lp))), lc = lp >= lastC.o ? GR : RD;
    g.setLineDash([4, 3]); g.strokeStyle = lc; g.lineWidth = 1; g.beginPath(); g.moveTo(0, ly); g.lineTo(W, ly); g.stroke(); g.setLineDash([]);
    var rem = Math.max(0, Math.round((lastC.t + CX_MS[ch.tf] * 1000 - Date.now()) / 1000)), remT = rem >= 3600 ? Math.floor(rem / 3600) + 'h' + ('0' + Math.floor(rem % 3600 / 60)).slice(-2) : Math.floor(rem / 60) + ':' + ('0' + rem % 60).slice(-2);
    g.fillStyle = lc; g.fillRect(W, ly - 16, padR, 32); g.fillStyle = '#fff'; g.fillText(fmtP(lp, ch.sym), W + 3, ly - 3); g.font = '10px -apple-system,Segoe UI,sans-serif'; g.fillText(remT, W + 3, ly + 11); g.font = '11px -apple-system,Segoe UI,sans-serif';
    // selected candle: crosshair
    var pop = $('m7pop');
    if (C.sel >= start && C.sel < end) {
        var sx = xs(C.sel), sk = K[C.sel]; g.strokeStyle = MT; g.setLineDash([3, 3]); g.beginPath(); g.moveTo(sx, padT); g.lineTo(sx, padT + ph + axisH + subH); g.stroke(); var sp = y(sk.c); g.beginPath(); g.moveTo(0, sp); g.lineTo(W, sp); g.stroke(); g.setLineDash([]);
        if (pop) { pop.innerHTML = cxInfo(sk, C.sel, closes, ind); pop.style.display = 'block'; pop.style.left = (sx > W / 2 ? Math.max(4, sx - 205) : Math.min(w - 200, sx + 14)) + 'px'; pop.style.top = '24px'; }
    } else if (pop) { pop.style.display = 'none'; }
    if (info) {
        var ix = C.sel >= 0 && C.sel < K.length ? C.sel : K.length - 1, kk = K[ix], leg = '';
        if (ind.ma7) { leg += ' · MA7 ' + fmtP(ind.ma7[ix] || 0, ch.sym) + ' MA25 ' + fmtP(ind.ma25[ix] || 0, ch.sym); }
        info.innerHTML = '<b>' + esc(ch.sym) + '</b> · ' + ch.tf + (cxSrc() === 's' ? ' · Spot' : cxSrc() === 'd' ? ' · Coin-M' : ' · Perp') + ' · O ' + fmtP(kk.o, ch.sym) + ' H ' + fmtP(kk.h, ch.sym) + ' L ' + fmtP(kk.l, ch.sym) + ' C ' + fmtP(kk.c, ch.sym) + ' <b class="' + (kk.c >= kk.o ? 'up' : 'dn') + '">' + pct((kk.c - kk.o) / kk.o * 100) + '</b>' + leg;
    }
    if (note) { note.textContent = 'Live from Binance (' + (cxSrc() === 's' ? 'Spot' : cxSrc() === 'd' ? 'Coin-M' : 'Futures') + '). The last candle moves in real time. Times use your chosen time zone.'; }
}
function cxInfo(k, i, closes, ind) {
