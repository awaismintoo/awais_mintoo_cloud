    if (!M.q && top === 'alpha') { return '<div class="group pad"><b>Alpha</b><div class="note">Binance Alpha lists early on-chain tokens that are not on the Futures list, so the live data feed here does not include them. Open Alpha in Binance to browse them.</div><a class="btn sec" style="display:block;text-align:center;text-decoration:none" target="_blank" rel="noopener" href="https://www.binance.com/en/alpha">Open Binance Alpha</a></div>'; }
