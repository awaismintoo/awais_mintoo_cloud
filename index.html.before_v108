    workers.forEach(function (w) { w.onmessage = onWorkerMsg; });
}
function planPicks() {
    var t = S.tick, all = Object.keys(t), liq = all.filter(function (s) { return t[s].q > 50e6; }), list = [];
    function add(s, k) { if (!t[s] || list.some(function (x) { return x.sym === s; })) { return; } list.push({ sym: s, chg: t[s].chg, kind: k || 'crypto' }); }
