        r = { net: net, asset: tok ? 'TOKEN' : 'COIN', sym: sym, dec: dec, fsym: nd.sym, fdec: 18, custom: custom, caddr: custom ? tok[1] : '', to: to, amt: amt, tx: tx, chainId: nd.id };
        if (net === 'prac') { r.nonce = 0n; r.gasPrice = 5000000000n; r.gas = tok ? 65000n : 21000n; r.balN = 10n * 10n ** 18n; r.balT = 1000n * 10n ** BigInt(dec); }
