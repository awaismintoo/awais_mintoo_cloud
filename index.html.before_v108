        } else if (m === 'show') {
            h += '<b>Write these 12 words on paper, in order</b><div style="font-size:18px;line-height:2;margin:10px 0">';
            f.ph.split(' ').forEach(function (w, j) { h += '<span style="display:inline-block;min-width:46%"><span style="opacity:.5">' + (j + 1) + '.</span> <b>' + esc(w) + '</b></span>'; });
            h += '</div><div class="note">Never photograph them, never type them into any website or chat, never share them. Anyone with these words owns your money.</div>' + btn('written', 'I have written them down') + btn('cancel', 'Cancel', 1);
        } else if (m === 'confirm') {
            h += '<b>Check your paper</b><div class="note">Type word number ' + (f.q[0] + 1) + ' and word number ' + (f.q[1] + 1) + '.</div>' + inp('w1', 'text', 'Word ' + (f.q[0] + 1)) + inp('w2', 'text', 'Word ' + (f.q[1] + 1)) + btn('finish', st.busy ? 'Saving…' : 'Create my wallet') + btn('cancel', 'Cancel', 1);
        } else if (m === 'import') {
            h += '<b>Import your 12 words</b>' + '<textarea data-wf="ph" rows="3" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="word1 word2 word3 …" style="width:100%;box-sizing:border-box;padding:12px;margin:6px 0;border-radius:10px;border:1px solid #8e8e9355;font-size:16px;background:transparent;color:inherit">' + esc(f.ph || '') + '</textarea>' + inp('pw', 'password', 'New wallet password (8+ characters)') + btn('doimport', st.busy ? 'Working…' : 'Import') + btn('cancel', 'Cancel', 1);
        } else if (m === 'reveal') {
            h += '<b>Enter your wallet password</b>' + inp('pw', 'password', 'Password') + btn('doreveal', st.busy ? 'Working…' : 'Show my 12 words') + btn('cancel', 'Cancel', 1);
        } else if (m === 'shown') {
            h += '<b>Your 12 words</b><div style="font-size:18px;line-height:2;margin:10px 0">'; f.ph.split(' ').forEach(function (w, j) { h += '<span style="display:inline-block;min-width:46%"><span style="opacity:.5">' + (j + 1) + '.</span> <b>' + esc(w) + '</b></span>'; }); h += '</div>' + btn('cancel', 'Hide them', 1);
        } else if (m === 'send') {
            var cn = f.net || 'prac';
            h += '<b>Send coins</b><div class="note">Start with Practice. It uses virtual money and sends nothing.</div>' + sel('net', Object.keys(NETS).map(function (k) { return [k, NETS[k].n]; })) + sel('asset', assetsFor(cn)) + (f.asset === 'C' ? inp('caddr', 'text', 'Token contract address (0x…)') + '<div class="note">Anyone can create a fake token with a famous name. Only use a contract address from the token\'s official website.</div>' : '') + inp('to', 'text', cn === 'btc' || f.asset === 'BTC' ? 'Send to address (bc1q… or 1… or 3…)' : 'Send to address (0x…)') + inp('amt', 'text', 'Amount, for example 0.01') + btn('sreview', st.busy ? 'Checking…' : 'Review') + btn('cancel', 'Cancel', 1);
        } else if (m === 'sreview') {
            var r = f.rev;
            h += '<b>Please check everything</b>' + (NETS[r.net].real ? '<div class="note" style="color:#ff453a;font-weight:700">REAL MONEY. Sent coins cannot be taken back.</div>' : '<div class="note" style="font-weight:700">' + esc(NETS[r.net].n) + '</div>') + '<div class="row"><span>Send</span><b>' + fmt(r.amt, r.dec) + ' ' + esc(r.sym) + '</b></div><div class="row" style="display:block"><span>To</span><div style="word-break:break-all;font-family:monospace;font-size:14px;margin:4px 0">' + esc(chunk(r.to)) + '</div></div><div class="row"><span>Network fee</span><b>' + fmt(r.fee, r.fdec) + ' ' + esc(r.fsym) + '</b></div>' + (r.asset === 'BTC' ? '<div class="note">Fee rate ' + r.rate + ' sat/vB. Change (if any) returns to your own Bitcoin address.</div>' : '') + (r.custom ? '<div class="note" style="color:#ff9f0a;font-weight:700">Other token: the contract says it is "' + esc(r.sym) + '". Contract: ' + esc(r.caddr) + '</div>' + inp('symc', 'text', 'Type the token name (' + esc(r.sym) + ') to confirm') : '') + '<div class="note" style="margin:8px 0">Type the last 6 characters of the address to prove you checked it, then your wallet password.</div>' + inp('last6', 'text', 'Last 6 characters of the address') + (cacheMins() ? '<div class="note">Password remembered for about ' + cacheMins() + ' more minute(s), only while the app stays open.</div>' + btn('forget', 'Forget my password now', 1) : inp('pw', 'password', 'Wallet password') + sel('rem', [['0', 'Do not remember my password'], ['5', 'Remember it for 5 minutes'], ['15', 'Remember it for 15 minutes'], ['30', 'Remember it for 30 minutes']])) + btn('dosend', st.busy ? 'Signing…' : (r.net === 'prac' ? 'Practice send' : 'Send now')) + btn('send', 'Back', 1) + btn('cancel', 'Cancel', 1);
        } else if (m === 'sdone') {
            h += '<b>' + (f.res.practice ? 'Practice complete' : 'Sent') + '</b><div class="note" style="margin:6px 0">' + (f.res.practice ? 'Nothing was sent and no real or test coins moved. This is exactly what a real send would sign.' : 'Your transaction was submitted. It usually confirms within a minute. Refresh balances to see it.') + '</div><div class="row" style="display:block"><span>Transaction ID</span><div style="word-break:break-all;font-family:monospace;font-size:12px;margin:4px 0 8px">' + esc(f.res.hash) + '</div><button class="btn sec" data-w="copy:' + esc(f.res.hash) + '" style="width:100%">Copy transaction ID</button></div>' + btn('cancel', 'Done');
        } else if (m === 'remove') {
            h += '<b>Remove the wallet from this phone?</b><div class="note">Without your 12 words written on paper, the money in it is lost forever. Type DELETE to confirm.</div>' + inp('del', 'text', 'DELETE') + btn('doremove', 'Remove wallet') + btn('cancel', 'Cancel', 1);
        }
        return h + '</div>';
    }
    function draw() { try { if (typeof S !== 'undefined' && S.win === 'wallet') { renderView(true); } } catch (e) {} }
    function clear() { f = {}; }
    async function run(fn) { st.busy = true; st.msg = ''; draw(); try { await fn(); } catch (e) { st.msg = e && e.message ? e.message : 'Something went wrong.'; } st.busy = false; draw(); }
    function act(a) {
        if (st.busy) { return; }
        if (a.indexOf('copy:') === 0) { var t = a.slice(5); try { navigator.clipboard.writeText(t); st.msg = 'Address copied.'; } catch (e) { st.msg = 'Could not copy. Select the address and copy it by hand.'; } draw(); return; }
        if (a === 'forget') { cache = null; st.msg = 'Password forgotten.'; draw(); return; }
        if (a === 'cancel') { clear(); st.mode = 'home'; st.msg = ''; draw(); }
        else if (a === 'create') { clear(); st.mode = 'create'; st.msg = ''; draw(); }
        else if (a === 'import') { clear(); st.mode = 'import'; st.msg = ''; draw(); }
        else if (a === 'reveal') { clear(); st.mode = 'reveal'; st.msg = ''; draw(); }
        else if (a === 'remove') { clear(); st.mode = 'remove'; st.msg = ''; draw(); }
        else if (a === 'gen') { run(async function () { if ((f.pw || '').length < 8) { throw new Error('The password needs at least 8 characters.'); } if (f.pw !== f.pw2) { throw new Error('The two passwords do not match.'); } f.ph = await genPhrase(); f.q = [1 + Math.floor(Math.random() * 5), 6 + Math.floor(Math.random() * 6)]; f.q = [f.q[0] - 1 + 0, f.q[1] - 1 + 0]; st.mode = 'show'; }); }
        else if (a === 'written') { st.mode = 'confirm'; st.msg = ''; draw(); }
        else if (a === 'finish') { run(async function () { var w = f.ph.split(' '); if ((f.w1 || '').trim().toLowerCase() !== w[f.q[0]] || (f.w2 || '').trim().toLowerCase() !== w[f.q[1]]) { throw new Error('Those words do not match. Check your paper (or go back and write them again).'); } await save(f.ph, f.pw); clear(); st.mode = 'home'; st.msg = 'Wallet created. Keep your paper safe.'; st.bal = null; }); }
        else if (a === 'doimport') { run(async function () { var e = await checkPhrase(f.ph || ''); if (e) { throw new Error(e); } if ((f.pw || '').length < 8) { throw new Error('The password needs at least 8 characters.'); } await save(f.ph.trim().toLowerCase().split(/\s+/).join(' '), f.pw); clear(); st.mode = 'home'; st.msg = 'Wallet imported.'; st.bal = null; }); }
        else if (a === 'doreveal') { run(async function () { var ph = await getPhrase(f.pw, true); f = { ph: ph }; st.mode = 'shown'; setTimeout(function () { if (st.mode === 'shown') { clear(); st.mode = 'home'; draw(); } }, 60000); }); }
        else if (a === 'doremove') { if ((f.del || '').trim() !== 'DELETE') { st.msg = 'Type DELETE exactly to confirm.'; draw(); return; } store('mw_vault', null); store('mw_pub', null); clear(); st.mode = 'home'; st.bal = null; st.msg = 'Wallet removed from this phone.'; draw(); }
        else if (a === 'send') { f = { net: f.net || 'prac', asset: f.asset || 'N', to: f.to || '', amt: f.amt || '', caddr: f.caddr || '' }; st.mode = 'send'; st.msg = ''; draw(); }
        else if (a === 'sreview') { run(async function () { f.rev = await prepare(); f.last6 = ''; f.pw = ''; st.mode = 'sreview'; }); }
        else if (a === 'dosend') { run(async function () { var res = await doSend(); clear(); f.res = res; st.mode = 'sdone'; st.bal = null; }); }
        else if (a === 'bal') { run(async function () { st.bal = await balances(); st.msg = ''; }); }
    }
    if (typeof document !== 'undefined' && document.addEventListener) {
        document.addEventListener('click', function (e) { var b = e.target.closest ? e.target.closest('[data-w]') : null; if (b) { act(b.getAttribute('data-w')); } });
        var onIn = function (e) { var k = e.target.getAttribute ? e.target.getAttribute('data-wf') : null; if (k) { f[k] = e.target.value; if (k === 'net') { f.asset = NETS[f.net].kind === 'btc' ? 'BTC' : 'N'; draw(); } else if (k === 'asset') { draw(); } } };
        document.addEventListener('input', onIn); document.addEventListener('change', onIn);
        document.addEventListener('visibilitychange', function () { if (document.hidden) { cache = null; } if (document.hidden && (st.mode === 'shown' || st.mode === 'sreview')) { var keep = st.mode === 'sreview'; if (!keep) { clear(); st.mode = 'home'; } else { f.pw = ''; } draw(); } });
    }
    return { bal: function () { return st.bal; }, refresh: function () { if (pubs() && !st.busy) { st.bal = null; act('bal'); } }, html: html, onOpen: function () { if (pubs() && !st.bal && !st.busy) { act('bal'); } }, _t: { TOK: TOK, NETS: NETS, tokenMeta: tokenMeta, strDec: strDec, okAddr: okAddr, bip143: bip143, btcBuild: btcBuild, btcDest: btcDest, der: der, le: le, unhex: unhex, dsha: dsha, pub: pub, signTx: signTx, sign: sign, rlpL: rlpL, okAddr: okAddr, parseAmt: parseAmt, csum: csum, keccak: keccak, ripemd: ripemd, evmAddr: evmAddr, btcAddr: btcAddr, derive: derive, checkPhrase: checkPhrase, genPhrase: genPhrase, seal: seal, unseal: unseal, pbkdf: pbkdf, hex: hex, fmt: fmt } };
})();

