<?xml version="1.0" encoding="utf-8"?>
<!-- build 544: modern widget card: header with time, big main line, two detail lines and up to three action buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mw_tool_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/mw_wbg_qibla">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/mw_t0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="MintooSuite"
            android:textColor="#D9FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/mw_tt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/mw_t1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text=""
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/mw_t2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#F2FFFFFF"
        android:textSize="13.5sp" />
    <TextView
        android:id="@+id/mw_t3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#CCFFFFFF"
        android:textSize="12.5sp" />
    <LinearLayout
        android:id="@+id/mw_acts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/mw_a1" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:background="@drawable/mw_wbtn" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/mw_a2" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:background="@drawable/mw_wbtn" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/mw_a3" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/mw_wbtn" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
