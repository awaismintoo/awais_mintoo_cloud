    var t = S.tick[sym]; if (!t) { return { v: 0, kind: '24h', roll: 0 }; }
    if (S.anchor !== 'roll') { var d = S.dayOpen[sym]; if (d && d.o && d.t === anchorStart(nowMs())) { return { v: (t.p - d.o) / d.o * 100, kind: 'today', roll: t.chg }; } }
    return { v: t.chg, kind: '24h', roll: t.chg };
}
function agreePct(v, side) { if (!v || !v.length) { return 0; } var sg = side === 'LONG' ? 1 : -1, n = 0; v.forEach(function (x) { if (x === sg) { n++; } }); return Math.round(n / v.length * 100); }
function confOf(p) { return p >= 75 ? 'HIGH' : p >= 55 ? 'MEDIUM' : 'LOW'; }

// ---------- formatting ----------
function fmtP(p, sym) {
    var d = sym && S.prec && S.prec[sym] != null ? S.prec[sym] : (p >= 1000 ? 2 : p >= 1 ? 4 : p >= 0.1 ? 5 : p >= 0.001 ? 6 : 8);
    return (+p).toFixed(d);
}
function pct(v) { return (v >= 0 ? '+' : '') + v.toFixed(2) + '%'; }
function money(v) { return v >= 1e9 ? '$' + (v / 1e9).toFixed(2) + 'B' : v >= 1e6 ? '$' + (v / 1e6).toFixed(1) + 'M' : '$' + Math.round(v / 1e3) + 'K'; }
function hm(ms) { return new Date(ms).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }
function hms(ms) { return new Date(ms).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }); }
function fmtT(ms) { var d = new Date(ms), n = new Date(); return d.toDateString() === n.toDateString() ? hm(ms) : d.toLocaleDateString([], { weekday: 'short' }) + ' ' + hm(ms); }
function ago(ms) { var s = Math.max(0, Math.round((nowMs() - ms) / 1000)); return s < 60 ? s + 's ago' : s < 3600 ? Math.round(s / 60) + 'm ago' : s < 86400 ? Math.round(s / 3600) + 'h ago' : Math.round(s / 86400) + 'd ago'; }
function nm(s) { return s.replace(/USDT$/, '') + '/USDT'; }
function cc(v) { return v >= 0 ? 'up' : 'dn'; }
function pill(side) { var c = side === 'LONG' ? 'long' : side === 'SHORT' ? 'short' : 'wait'; return '<span class="pill ' + c + '">' + side + '</span>'; }
function addLog(type, text) { S.log.unshift({ t: nowMs(), type: type, text: text }); if (S.log.length > 150) { S.log.length = 150; } lss('mintoosuite_log', JSON.stringify(S.log)); }

// ---------- profit calculator ($100 and $50, net of estimated fees) ----------
var FEE = 0.001;
function feeOf(sym) { return sym === GOLD ? 0 : FEE; }
function usd(n) { return (n >= 0 ? '+$' : '−$') + Math.abs(n).toFixed(2); }
function plLine(side, price, sl, tp, sym) {
    if ((side !== 'LONG' && side !== 'SHORT') || !price) { return ''; }
    var f = feeOf(sym), tpp = tp / price, slp = sl / price;
    return '$100: <span class="up">' + usd(100 * (tpp - f)) + '</span> at TP / <span class="dn">' + usd(-100 * (slp + f)) + '</span> at SL • $50: <span class="up">' + usd(50 * (tpp - f)) + '</span> / <span class="dn">' + usd(-50 * (slp + f)) + '</span>';
}
function netUsd(pnlPct, sym, amt) { return usd(Math.max(-amt, amt * S.lev * (pnlPct / 100 - feeOf(sym)))); }
function dayOpenFor(now) { return Math.floor((now - 900000) / 86400000) * 86400000; }
function pk(ms) { try { return new Date(ms).toLocaleTimeString('en-GB', { timeZone: 'Asia/Karachi', hour: '2-digit', minute: '2-digit' }); } catch (e) { return hm(ms); } }
function pkd(ms) { try { return new Date(ms).toLocaleDateString('en-GB', { timeZone: 'Asia/Karachi', weekday: 'short', day: 'numeric', month: 'short' }) + ' ' + pk(ms); } catch (e) { return fmtT(ms); } }

// ---------- notifications (service worker) ----------
function sendPush(title, body) {
    try {
        if (window.MintooNative && window.MintooNative.notify) { window.MintooNative.notify(String(title), String(body)); return; }
        if ('serviceWorker' in navigator && navigator.serviceWorker.controller) { navigator.serviceWorker.controller.postMessage({ type: 'TRIGGER_PUSH', title: title, body: body }); }
        else if ('Notification' in window && Notification.permission === 'granted' && navigator.serviceWorker) { navigator.serviceWorker.ready.then(function (r) { r.showNotification(title, { body: body, vibrate: [300, 100, 300], requireInteraction: true }); }); }
    } catch (e) {}
}
function alertPush(sym, title, body) {
    if (!S.sysPush) { return; }
    if (sym === GOLD ? !S.goldPush : !S.cryptoPush) { return; }
    sendPush(title, body);
}

// ---------- live prices: WebSocket (1s) with REST fallback ----------
function ingest(a) {
    for (var i = 0; i < a.length; i++) {
        var x = a[i]; if (!SYM_OK.test(x.s)) { continue; }
        var p = +x.c, o = +x.o; if (!p) { continue; }
        var pc = x.P != null && x.P !== '' && isFinite(+x.P) ? +x.P : (o ? (p - o) / o * 100 : 0);
        S.tick[x.s] = { p: p, o: o, h: +x.h, l: +x.l, q: +x.q, chg: pc, at: nowMs() };
    }
}
var WS_URLS = ['wss://fstream.binance.com/ws/!ticker@arr', 'wss://fstream.binance.com/stream?streams=!ticker@arr', 'wss://fstream.binance.com/ws/!miniTicker@arr'];
var wsBack = 1000, wsVar = 0, wsObj = null, wsTry = 0, wsTimer = null;
function closeWS() { if (wsObj) { try { wsObj.onmessage = wsObj.onclose = wsObj.onerror = null; wsObj.close(); } catch (e) {} wsObj = null; } }
function scheduleWS() { if (wsTimer) { return; } wsTimer = setTimeout(function () { wsTimer = null; connectWS(); }, wsBack); wsBack = Math.min(wsBack * 2, 15000); }
function connectWS() {
    closeWS(); wsTry = nowMs();
    var ws; S.feed.variant = wsVar % WS_URLS.length;
    try { ws = new WebSocket(WS_URLS[S.feed.variant]); } catch (e) { S.feed.err = String(e && e.message || e); wsVar++; scheduleWS(); return; }
    wsObj = ws;
    ws.onmessage = function (ev) {
        var a; try { a = JSON.parse(ev.data); } catch (e) { return; }
        if (a && a.data) { a = a.data; } if (!Array.isArray(a)) { return; }
        ingest(a); S.wsAt = nowMs(); wsBack = 1000; S.feed.mode = 'ws'; S.feed.err = '';
    };
    ws.onerror = function () { S.feed.err = 'live feed connection error'; };
    ws.onclose = function () { if (wsObj === ws) { wsObj = null; wsVar++; scheduleWS(); } };
}
function wsWatchdog() {
    var now = nowMs();
    if (wsObj && now - Math.max(S.wsAt, wsTry) > 9000) { closeWS(); wsVar++; connectWS(); }
    else if (!wsObj && !wsTimer) { scheduleWS(); }
    var cut = now - 180000, k; for (k in S.tick) { if (S.tick[k].at < cut) { delete S.tick[k]; } }
}
function dataAge() { var t = Math.max(S.wsAt, S.restAt); return t ? nowMs() - t : Infinity; }
function fetchJSON(path, ms) {
    var ac = typeof AbortController !== 'undefined' ? new AbortController() : null, to = ac ? setTimeout(function () { ac.abort(); }, ms || 10000) : null;
    return fetch('https://fapi.binance.com' + path, { cache: 'no-store', signal: ac ? ac.signal : undefined }).then(function (r) {
        if (to) { clearTimeout(to); } if (!r.ok) { throw new Error('HTTP ' + r.status); } return r.json();
    });
}
var restBusy = false;
function pollREST(force) {
    if (!force && S.wsAt && nowMs() - S.wsAt < 6000) { return; }
    if (restBusy) { return; }
    restBusy = true;
    fetchJSON('/fapi/v1/ticker/24hr').then(function (a) {
        ingest(a.map(function (x) { return { s: x.symbol, c: x.lastPrice, o: x.openPrice, h: x.highPrice, l: x.lowPrice, q: x.quoteVolume, P: x.priceChangePercent }; }));
        S.restAt = nowMs(); if (!(S.wsAt && nowMs() - S.wsAt < 6000)) { S.feed.mode = 'rest'; }
    }).catch(function (e) { S.feed.err = 'REST: ' + (e && e.message || 'failed'); }).then(function () { restBusy = false; });
}
function loadTime() {
    var t0 = Date.now();
    return fetchJSON('/fapi/v1/time', 6000).then(function (j) { var skew = j.serverTime - (t0 + Date.now()) / 2; if (Math.abs(skew - S.skew) > 1500) { S.skew = skew; } S.timeAt = Date.now(); }).catch(function () {});
}
function loadFx() {
    return fetch('https://api.binance.com/api/v3/ticker/24hr?symbols=' + encodeURIComponent('["EURUSDT","GBPUSDT"]'), { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (a) {
        a.forEach(function (x) { if (x.symbol === 'EURUSDT') { S.fx.eur = +x.priceChangePercent; S.fx.eurP = +x.lastPrice; } if (x.symbol === 'GBPUSDT') { S.fx.gbp = +x.priceChangePercent; S.fx.gbpP = +x.lastPrice; } });
        S.fx.at = nowMs();
    }).catch(function () {});
}
// ---------- 25 parallel scans: 5 workers x 5 requests ----------
var workers = [], pending = {}, runId = 0;
function inlineWorker() {
    var me = { onmessage: null }, scope = { onmessage: null, postMessage: function (m) { setTimeout(function () { if (me.onmessage) { me.onmessage({ data: m }); } }, 0); } };
    engineBoot(scope);
    me.postMessage = function (m) { scope.onmessage({ data: m }); };
    return me;
}
function onWorkerMsg(e) { var d = e.data, f = pending[d.id]; if (f) { delete pending[d.id]; f(d); } }
function makeWorkers(forceMain) {
    workers.forEach(function (w) { try { if (w.terminate) { w.terminate(); } } catch (e) {} });
    workers = []; var i;
    if (!forceMain) {
        try {
            var url = URL.createObjectURL(new Blob(['(' + engineBoot.toString() + ')(self);'], { type: 'application/javascript' }));
            for (i = 0; i < NW; i++) { workers.push(new Worker(url)); }
            S.threads = 'workers';
        } catch (e) { workers = []; }
    }
    if (!workers.length) { for (i = 0; i < NW; i++) { workers.push(inlineWorker()); } S.threads = 'main'; }
    workers.forEach(function (w) { w.onmessage = onWorkerMsg; });
}
function planPicks() {
    var t = S.tick, all = Object.keys(t), liq = all.filter(function (s) { return t[s].q > 50e6; }), list = [];
    function add(s, k) { if (!t[s] || list.some(function (x) { return x.sym === s; })) { return; } list.push({ sym: s, chg: t[s].chg, kind: k || 'crypto' }); }
    add(GOLD, 'gold'); add('BTCUSDT'); add('ETHUSDT');
    liq.slice().sort(function (a, b) { return chgOf(b).v - chgOf(a).v; }).slice(0, 3).forEach(function (s) { add(s); });
    liq.slice().sort(function (a, b) { return chgOf(a).v - chgOf(b).v; }).slice(0, 3).forEach(function (s) { add(s); });
    all.slice().sort(function (a, b) { return t[b].q - t[a].q; }).slice(0, 2).forEach(function (s) { add(s); });
    return list.slice(0, 10);
}
function runScan() {
    var now = nowMs();
    if (S.scan.running && now - S.scan.startedAt > 45000) { S.scan.running = false; }
    if (S.scan.running || now < S.scan.pause) { return Promise.resolve(); }
    S.scan.running = true; S.scan.startedAt = now;
    var p; try { p = runScanCore(now); } catch (e) { S.scan.err = 1; p = Promise.resolve(); }
    return Promise.resolve(p).then(function () { S.scan.running = false; }, function () { S.scan.running = false; });
}
function runScanCore(now) {
    var t = S.tick, syms = Object.keys(t);
    if (syms.length < 20) { return Promise.resolve(); }
    var liquid = syms.filter(function (s) { return t[s].q > 5e6; }).sort(function (a, b) { return t[b].q - t[a].q; }).slice(0, 100);
    if (t[GOLD] && liquid.indexOf(GOLD) < 0) { liquid.push(GOLD); }
    var jobs = liquid.map(function (s) { return { type: 'scan', sym: s }; });
    if (now - S.plan.at > 60000) { planPicks().reverse().forEach(function (p) { jobs.unshift({ type: 'plan', sym: p.sym, chg: p.chg, kind: p.kind }); }); }
    var D0 = dayOpenFor(now);
    if ((now - S.morning.at > 300000 || S.morning.D !== D0) && now - (S.morning.tried || 0) > 7000) { S.morning.tried = now; morningUniverse().forEach(function (u) { jobs.push({ type: 'morning', sym: u.sym, kind: u.kind, D: D0, now: now }); }); }
    if (S.newc.list.length && now - S.newc.at > 120000) { S.newc.list.forEach(function (n) { jobs.push({ type: 'newc', sym: n.sym, onboard: n.onboard }); }); }
    if (S.anchor !== 'roll' && now - S.dayOpenTried > 7000) {
        var dstart = anchorStart(now), need = syms.filter(function (s) { return t[s].q > 1e6 && (!S.dayOpen[s] || S.dayOpen[s].t !== dstart); }).sort(function (a, b) { return t[b].q - t[a].q; }).slice(0, 250);
        if (need.length) { S.dayOpenTried = now; need.forEach(function (s) { jobs.push({ type: 'dayopen', sym: s, start: dstart }); }); }
    }
    var buckets = []; for (var i = 0; i < NW; i++) { buckets.push([]); }
    jobs.forEach(function (j, n) { buckets[n % NW].push(j); });
    runId++; var rid = runId;
    var proms = buckets.map(function (b, i) {
        if (!b.length) { return Promise.resolve({ out: [], maxw: 0, rate: 0, errs: 0 }); }
        var id = rid * 100 + i;
        return new Promise(function (res) {
            var to = setTimeout(function () { delete pending[id]; res({ out: [], maxw: 0, rate: 0, errs: 0, timeout: true }); }, 25000);
            pending[id] = function (d) { clearTimeout(to); res(d); };
            try { workers[i].postMessage({ id: id, jobs: b, conc: CONC }); } catch (e) { clearTimeout(to); delete pending[id]; res({ out: [], maxw: 0, rate: 0, errs: 1 }); }
        });
    });
    return Promise.all(proms).then(function (rs) {
        var scanned = 0, rate = 0, maxw = 0, errs = 0, plans = [], mor = [], newcGot = 0;
        rs.forEach(function (r) {
            rate = Math.max(rate, r.rate || 0); maxw = Math.max(maxw, r.maxw || 0); errs += r.errs || 0;
            r.out.forEach(function (o) { if (o.type === 'scan') { S.scan.res[o.sym] = { tf: o.tf, spark: o.spark, at: nowMs(), p0: S.tick[o.sym] ? S.tick[o.sym].p : (o.tf['15m'] ? o.tf['15m'].close : 0) }; scanned++; } else if (o.type === 'morning') { mor.push(o); } else if (o.type === 'newc') { S.newc.res[o.sym] = o; newcGot++; } else if (o.type === 'dayopen') { S.dayOpen[o.sym] = { t: o.t, o: o.o }; } else { plans.push(o); } });
        });
        if (plans.length) {
            var order = planPicks().map(function (p) { return p.sym; });
            plans.sort(function (a, b) { return order.indexOf(a.sym) - order.indexOf(b.sym); });
            S.plan.items = plans; S.plan.at = nowMs();
        }
        if (mor.length) { S.morning.items = mor; S.morning.D = D0; S.morning.at = nowMs(); S.morning.goldClosed = mor.some(function (o) { return o.kind === 'gold' && !o.today; }); maybeMorningAlert(); }
        if (newcGot) { S.newc.at = nowMs(); }
        Object.keys(S.scan.res).forEach(function (s) { if (nowMs() - S.scan.res[s].at > 180000) { delete S.scan.res[s]; } });
        S.scan.n = scanned; S.scan.total = liquid.length; S.scan.ms = nowMs() - now; S.scan.maxw = maxw; S.scan.err = errs;
        if (rate) { S.scan.pause = nowMs() + rate * 1000; }
        if (scanned) { S.scan.at = nowMs(); S.zero = 0; processSignals(); S.scan.first = false; }
        else if (!rate) { S.zero++; if (S.zero >= 2 && S.threads === 'workers') { makeWorkers(true); S.zero = 0; } }
        var dsN = anchorStart(nowMs()), missing = S.anchor === 'roll' ? 0 : Object.keys(S.tick).filter(function (s) { return S.tick[s].q > 1e6 && (!S.dayOpen[s] || S.dayOpen[s].t !== dsN); }).length, pend = S.morning.D !== D0 || missing > 0;
        S.fup = pend ? (S.fup || 0) + 1 : 0;
        S.scan.next = nowMs() + (!scanned ? 6000 : (pend && S.fup <= 4) ? 8000 : maxw > 1800 ? 60000 : 30000);
    }).then(function () { S.scan.running = false; }, function () { S.scan.running = false; });
}
function scanLoop() {
    var p; try { p = runScan(); } catch (e) { p = Promise.resolve(); }
    Promise.resolve(p).then(function () {}, function () {}).then(function () { var d = Math.max(1500, (S.scan.next || nowMs() + 30000) - nowMs()); setTimeout(scanLoop, S.scan.next ? d : 2000); });
}

function morningUniverse() {
    var t = S.tick, list = [];
    if (t[GOLD]) { list.push({ sym: GOLD, kind: 'gold' }); }
    Object.keys(t).filter(function (s) { return s !== GOLD; }).sort(function (a, b) { return t[b].q - t[a].q; }).slice(0, 10).forEach(function (s) { list.push({ sym: s, kind: 'crypto' }); });
    return list;
}
function usOpen() { var z = zoned('America/New_York'); return !!z && z.wd !== 'Sat' && z.wd !== 'Sun' && z.m >= 570 && z.m < 960; }
function offHours(sym) { return !!S.tradfi[sym] && !usOpen(); }
function isSolid(o) { return !!(o.today && o.today.solid) && !offHours(o.sym); }
function morningSolid() {
    return S.morning.items.filter(isSolid).sort(function (a, b) { return Math.abs(b.today.dayScore) - Math.abs(a.today.dayScore); });
}
function maybeMorningAlert() {
    var D = S.morning.D, T = D + 900000, now = nowMs();
    if (ls('mintoosuite_morning_alert', '') === String(D)) { return; }
    lss('mintoosuite_morning_alert', String(D));
    var solid = morningSolid();
    if (now - T > 45 * 60000 || !solid.length) { return; }
    var top = solid.slice(0, 3).map(function (o) { return nm(o.sym) + ' ' + o.today.day; }).join(', ');
    addLog('NEW DAY', 'New-day plan ready (' + pk(T) + ' PKT): ' + top);
    if (S.aMaster && S.sysPush) { sendPush('🌅 New day plan ready', top + '. Open the New Day window for entries, targets and times.'); }
}
function loadListings() {
    return fetchJSON('/fapi/v1/exchangeInfo', 25000).then(function (j) {
        var now = nowMs(), all = [], fresh = [], tf = {};
        (j.symbols || []).forEach(function (s) {
            if (!SYM_OK.test(s.symbol) || (s.contractType !== 'PERPETUAL' && s.contractType !== 'TRADIFI_PERPETUAL')) { return; }
            all.push(s.symbol); if (s.pricePrecision != null) { S.prec[s.symbol] = +s.pricePrecision; }
            var ff = {}; (s.filters || []).forEach(function (x) { if (x.filterType === 'PRICE_FILTER') { ff.tick = +x.tickSize; } else if (x.filterType === 'LOT_SIZE') { ff.step = +x.stepSize; ff.min = +x.minQty; } else if (x.filterType === 'MARKET_LOT_SIZE') { ff.mstep = +x.stepSize; ff.mmin = +x.minQty; ff.mmax = +x.maxQty; } else if (x.filterType === 'MIN_NOTIONAL') { ff.notional = +x.notional; } }); S.filt[s.symbol] = ff;
            var ut = String(s.underlyingType || '').toUpperCase(), sub = JSON.stringify(s.underlyingSubType || []).toLowerCase();
            if ((s.contractType === 'TRADIFI_PERPETUAL' || ut === 'EQUITY' || /tradfi|equity|stock|etf/.test(sub)) && s.symbol !== 'XAUUSDT' && s.symbol !== 'PAXGUSDT' && !/metal|commodity/.test(sub)) { tf[s.symbol] = 1; }
            if (s.status === 'TRADING' && s.onboardDate && now - s.onboardDate < 30 * 86400000) { fresh.push({ sym: s.symbol, onboard: +s.onboardDate }); }
        });
        fresh.sort(function (a, b) { return b.onboard - a.onboard; });
        try { localStorage.setItem('mintoosuite_prec', JSON.stringify(S.prec)); localStorage.setItem('mintoosuite_filt', JSON.stringify(S.filt)); } catch (e) {}
        S.newc.list = fresh.slice(0, 14); S.newc.listAt = now; S.tradfi = tf;
        var known = []; try { known = JSON.parse(ls('mintoosuite_known_syms', '[]')) || []; } catch (e) { known = []; }
        if (known.length && all.length) {
            var ks = {}; known.forEach(function (s) { ks[s] = 1; });
            all.filter(function (s) { return !ks[s]; }).slice(0, 3).forEach(function (s) {
                addLog('NEW COIN', 'New Binance Futures listing: ' + nm(s));
                if (S.sysPush) { sendPush('🆕 New listing: ' + nm(s), 'Just listed on Binance Futures. Open the New Coins window for its data.'); }
            });
        }
        if (all.length > 50) { lss('mintoosuite_known_syms', JSON.stringify(all)); }
        if (S.win === 'newc') { renderView(); }
    }).catch(function () { S.newc.err = 'Could not load the listing list'; });
}

function newcRec(r) {
    var tk = S.tick[r.sym], price = tk ? tk.p : r.last, a = r.t15, b = r.t1h;
    if (!a) { return { side: 'NONE', why: 'Only ' + Math.floor(r.hrs) + ' hours of history so far. Too new for a reliable signal.' }; }
    var side, why = '', pct = 0;
    if (b) { if (a.side !== 'WAIT' && a.side === b.side) { side = a.side; pct = agreePct(a.votes.concat(b.votes), side); } else { side = 'WAIT'; why = a.note || b.note || 'The 15m and 1h timeframes disagree.'; } }
    else { side = a.side; pct = side === 'WAIT' ? 0 : agreePct(a.votes, side); why = side === 'WAIT' ? (a.note || '') : 'Early signal from 15m candles only (under 40 hours of history).'; }
    var sl = Math.min(1.5 * a.atr, 0.10 * price);
    return { side: side, pct: pct, conf: confOf(pct), why: why, price: price, sl: sl, tp: 2 * sl };
}

// ---------- recommendations from scan results ----------
function computePicks() {
    var out = [];
    Object.keys(S.scan.res).forEach(function (s) {
        var rs = S.scan.res[s], r = rs.tf, a = r['15m'], b = r['10m']; if (!a || !b || nowMs() - rs.at > 180000) { return; }
        var tk = S.tick[s], live = tk ? tk.p : a.close, p0 = rs.p0 || live, aligned = a.side !== 'WAIT' && a.side === b.side, avg = (Math.abs(a.score) + Math.abs(b.score)) / 2, pct = aligned ? agreePct(a.votes.concat(b.votes), a.side) : 0;
        var sl = Math.min(1.5 * a.atr, 0.05 * p0), tp = 2 * sl, sg = a.side === 'LONG' ? 1 : -1, moved = aligned ? sg * (live - p0) / p0 * 100 : 0, expired = false;
        if (aligned && (sg > 0 ? (live <= p0 - sl || live >= p0 + tp) : (live >= p0 + sl || live <= p0 - tp))) { expired = true; aligned = false; }
        out.push({ sym: s, side: aligned ? a.side : 'MIXED', aligned: aligned, expired: expired, score: aligned ? avg + pct / 100 : 0, pct: pct, conf: aligned ? confOf(pct) : 'LOW', st: a.st,
                   price: p0, live: live, moved: moved, sl: sl, tp: tp, rsi: a.rsi, vr: a.vr, note: a.note || b.note, spark: rs.spark, at: rs.at });
    });
    out.sort(function (x, y) { return y.score - x.score; });
    return out;
}
function levelText(side, price, sl, tp, sym) {
    if (side === 'LONG') { return 'Entry ' + fmtP(price, sym) + ' • SL ' + fmtP(price - sl, sym) + ' • TP ' + fmtP(price + tp, sym); }
    if (side === 'SHORT') { return 'Entry ' + fmtP(price, sym) + ' • SL ' + fmtP(price + sl, sym) + ' • TP ' + fmtP(price - tp, sym); }
    return 'No trade: wait for a clearer setup';
}
function processSignals() {
    var now = nowMs(), first = S.scan.first, sent = 0, i;
    computePicks().filter(function (p) { return p.aligned && p.pct >= 75; }).forEach(function (p) {
        var k = 'M' + p.sym; if (S.notified[k] && now - S.notified[k] < 30 * 60000) { return; }
        S.notified[k] = now;
        if (first) { return; }
        var txt = nm(p.sym) + ' ' + p.side + ' (10m+15m agree) ' + levelText(p.side, p.price, p.sl, p.tp, p.sym);
        addLog('MASTER', txt + ' • valid ' + hm(now) + '→' + hm(now + 45 * 60000));
        if (S.aMaster && sent < 3) { sent++; alertPush(p.sym, 'Master pick: ' + nm(p.sym) + ' ' + p.side, txt); }
    });
    var csent = 0;
    Object.keys(S.scan.res).forEach(function (s) {
        var c = S.scan.res[s].tf['3m']; if (!c || c.bodyAtr < 1.2 || c.vr < 2) { return; }
        var key = s + c.t; if (S.seen[key]) { return; } S.seen[key] = 1;
        S.candles.unshift({ sym: s, bull: c.bull, t: c.t, price: c.close, vr: c.vr, ba: c.bodyAtr, at: now });
        if (first) { return; }
        var kk = 'C' + s; if (S.notified[kk] && now - S.notified[kk] < 15 * 60000) { return; }
        S.notified[kk] = now;
        var txt = nm(s) + ' 3m ' + (c.bull ? 'BULLISH' : 'BEARISH') + ' candle at ' + fmtP(c.close, s) + ' (volume x' + c.vr.toFixed(1) + ')';
        addLog('3M', txt);
        if (S.a3m && csent < 5) { csent++; alertPush(s, '3m ' + (c.bull ? 'bullish' : 'bearish') + ': ' + nm(s), txt); }
    });
    if (S.candles.length > 80) { S.candles.length = 80; }
    if (Object.keys(S.seen).length > 3000) { S.seen = {}; }
}

// ---------- news (real RSS via rss2json) ----------
function gq(q) { return 'https://news.google.com/rss/search?q=' + encodeURIComponent(q + ' when:1d') + '&hl=en-US&gl=US&ceid=US:en'; }
var FEEDS = [
    { n: 'Crypto headlines', u: gq('bitcoin OR ethereum OR crypto OR binance'), g: 'mkt' },
    { n: 'CoinDesk', u: 'https://www.coindesk.com/arc/outboundfeeds/rss/', g: 'mkt' },
    { n: 'Cointelegraph', u: 'https://cointelegraph.com/rss', g: 'mkt' },
    { n: 'Gold & macro', u: gq('gold price OR Federal Reserve OR inflation OR US dollar'), g: 'macro' },
    { n: 'BBC Business', u: 'https://feeds.bbci.co.uk/news/business/rss.xml', g: 'macro' },
    { n: 'World & geopolitics', u: gq('war OR sanctions OR OPEC OR geopolitics'), g: 'geo' },
    { n: 'BBC World', u: 'https://feeds.bbci.co.uk/news/world/rss.xml', g: 'geo' }
];
var PROXIES = [
    function (u) { return 'https://api.allorigins.win/raw?disableCache=true&url=' + encodeURIComponent(u); },
    function (u) { return 'https://corsproxy.io/?url=' + encodeURIComponent(u); },
    function (u) { return 'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(u); }
];
function fetchText(url, ms) {
    var ac = typeof AbortController !== 'undefined' ? new AbortController() : null, to = ac ? setTimeout(function () { ac.abort(); }, ms || 9000) : null;
    return fetch(url, { cache: 'no-store', signal: ac ? ac.signal : undefined }).then(function (r) { if (to) { clearTimeout(to); } if (!r.ok) { throw new Error('HTTP ' + r.status); } return r.text(); });
}
function firstOk(ps) { return new Promise(function (res, rej) { var n = ps.length, f = 0; ps.forEach(function (p) { p.then(res, function () { if (++f === n) { rej(new Error('all failed')); } }); }); }); }
function parseFeed(text, f) {
    var doc = new DOMParser().parseFromString(text, 'text/xml'), out = [], nodes = doc.querySelectorAll('item');
    function tx(el, sel) { var x = el.querySelector(sel); return x ? (x.textContent || '').trim() : ''; }
    if (!nodes.length) { nodes = doc.querySelectorAll('entry'); }
    for (var i = 0; i < nodes.length && i < 25; i++) {
        var it = nodes[i], link = tx(it, 'link'), l2 = it.querySelector('link'), when = tx(it, 'pubDate') || tx(it, 'updated') || tx(it, 'published');
        if (!link && l2) { link = l2.getAttribute('href') || ''; }
        var t = Date.parse(when), src = tx(it, 'source'), title = tx(it, 'title');
        if (!title) { continue; }
        out.push({ src: src || f.n, g: f.g, title: title, link: link, t: isNaN(t) ? 0 : t });
    }
    return out;
}
function rssJson(f) {
    return fetchText('https://api.rss2json.com/v1/api.json?rss_url=' + encodeURIComponent(f.u), 9000).then(function (t) {
        var j = JSON.parse(t); if (!j || j.status !== 'ok' || !j.items || !j.items.length) { throw new Error('empty'); }
        return { via: 'rss2json', items: j.items.map(function (it) { var t2 = Date.parse(String(it.pubDate || '').replace(' ', 'T') + 'Z'); return { src: f.n, g: f.g, title: String(it.title || ''), link: String(it.link || ''), t: isNaN(t2) ? 0 : t2 }; }) };
    });
}
function fetchFeed(f) {
    var tries = PROXIES.map(function (px, i) { return fetchText(px(f.u), 9000).then(function (t) { var it = parseFeed(t, f); if (!it.length) { throw new Error('empty'); } return { via: 'proxy ' + (i + 1), items: it }; }); });
    tries.push(rssJson(f));
    return firstOk(tries);
}
function loadNews() {
    S.newsTried = true;
    return Promise.all(FEEDS.map(function (f) { return fetchFeed(f).then(function (r) { return { f: f, r: r }; }, function () { return { f: f, r: null }; }); })).then(function (arr) {
        var seen = {}, all = [], now = nowMs();
        S.newsSrc = arr.map(function (x) { return { n: x.f.n, ok: !!x.r, via: x.r ? x.r.via : '', count: x.r ? x.r.items.length : 0 }; });
        arr.forEach(function (x) { if (x.r) { x.r.items.forEach(function (it) { var k = it.title.toLowerCase().slice(0, 70); if (seen[k] || (it.t && now - it.t > 36 * 3600000)) { return; } seen[k] = 1; all.push(it); }); } });
        all.sort(function (a, b) { return (b.t || 0) - (a.t || 0); });
        if (all.length) { S.news = all.slice(0, 90); S.newsAt = now; }
        if (S.win === 'news') { renderView(); }
    });
}

// ---------- update check: always know if this phone runs an old copy ----------
function checkUpdate() {
    return fetchText('index.html?cb=' + Date.now(), 12000).then(function (t) {
        var m = /var BUILD = '([^']+)'/.exec(t); if (m && m[1] !== BUILD) { S.update = m[1]; }
    }).catch(function () {});
}

// ---------- market hours (real schedule, holidays not included) ----------
function zoned(tz) {
    try {
        var o = {}; new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).forEach(function (x) { o[x.type] = x.value; });
        return { wd: o.weekday, m: (+o.hour) * 60 + (+o.minute), label: o.hour + ':' + o.minute };
    } catch (e) { return null; }
}
var EXCH = [['🇺🇸 NYSE / NASDAQ', 'America/New_York', [[570, 960]]], ['🇬🇧 London (LSE)', 'Europe/London', [[480, 990]]], ['🇩🇪 Frankfurt (Xetra)', 'Europe/Berlin', [[540, 1050]]],
            ['🇯🇵 Tokyo (TSE)', 'Asia/Tokyo', [[540, 690], [750, 930]]], ['🇭🇰 Hong Kong (HKEX)', 'Asia/Hong_Kong', [[570, 720], [780, 960]]]];
function goldClosed(d) { var wd = d.getUTCDay(), m = d.getUTCHours() * 60 + d.getUTCMinutes(); return wd === 6 || (wd === 5 && m >= 22 * 60) || (wd === 0 && m < 22 * 60); }
function nextGoldOpen(ms) { var t = ms; for (var i = 0; i < 9 * 96; i++) { if (!goldClosed(new Date(t))) { return t; } t += 900000; } return ms; }
function windows(kind, now) {
    var start, dayStart, dayEnd, fhStop;
    if (kind === 'gold') {
        start = nextGoldOpen(now); var s = new Date(start);
        dayEnd = Date.UTC(s.getUTCFullYear(), s.getUTCMonth(), s.getUTCDate(), 21, 0, 0);
        if (dayEnd - start < 2 * HOUR) { dayEnd += 24 * HOUR; }
        dayStart = start; fhStop = Math.min(start + 4 * HOUR, dayEnd);
    } else {
        start = now; var u = new Date(now);
        dayEnd = Date.UTC(u.getUTCFullYear(), u.getUTCMonth(), u.getUTCDate() + 1, 0, 0, 0); dayStart = now;
        if (dayEnd - now < 3 * HOUR) { dayStart = dayEnd; dayEnd += 24 * HOUR; }
        fhStop = now + 4 * HOUR;
    }
    return { fhStart: start, fhStop: fhStop, dayStart: dayStart, dayEnd: dayEnd };
}

// ---------- fast price lane (when the live stream is blocked on this network) ----------
var priceBusy = false;
function pollPrices() {
    if (S.wsAt && nowMs() - S.wsAt < 4000) { return; }
    if (priceBusy) { return; }
    priceBusy = true;
    fetchJSON('/fapi/v1/ticker/price', 6000).then(function (a) {
        var now = nowMs();
        a.forEach(function (x) { var t = S.tick[x.symbol], p = +x.price; if (t && p) { t.p = p; t.chg = t.o ? (p - t.o) / t.o * 100 : t.chg; t.at = now; } });
        S.restAt = now; S.feed.mode = 'rest'; S.feed.fast = true;
    }).catch(function (e) { S.feed.err = 'prices: ' + (e && e.message || 'failed'); }).then(function () { priceBusy = false; });
}

// ---------- priority board: every signal ranked, with plain reasons and an order ticket ----------
var ACT_CACHE = { at: 0, list: [] };
function buildActions() {
    var now = nowMs(), out = [], D0 = dayOpenFor(now), plan = {};
    if (S.morning.D === D0) { S.morning.items.forEach(function (o) { if (o.today && o.today.day !== 'WAIT') { plan[o.sym] = o.today.day; } }); }
    computePicks().forEach(function (p) {
        if (!p.aligned || p.expired) { return; }
        var tk = S.tick[p.sym]; if (!tk) { return; }
        var reasons = [], warns = [], score = p.pct * 0.7, slPct = p.sl / p.price * 100, tpPct = p.tp / p.price * 100;
        reasons.push('The 10m and 15m charts both point ' + (p.side === 'LONG' ? 'up' : 'down'));
        reasons.push(p.pct + '% of the indicator checks agree');
        if (p.st) { reasons.push('The 15m Supertrend is ' + (p.st.dir > 0 ? 'UP' : 'DOWN') + ', the same direction as this ' + p.side); }
        if (p.vr >= 1.5) { reasons.push('Volume is ×' + p.vr.toFixed(1) + ' the recent average'); score += Math.min(p.vr, 3) * 3; }
        var pl = plan[p.sym];
        if (pl === p.side) { reasons.push("It matches today's New Day plan"); score += 10; }
        else if (pl) { warns.push("It goes against today's New Day plan (" + pl + '): use a small size'); score -= 15; }
        score += Math.max(0, Math.min(5, (Math.log10(Math.max(tk.q, 1)) - 6.5) * 2.5));
        var age = (now - p.at) / 1000;
        if (age > 90) { score -= Math.min(20, (age - 90) / 10); warns.push('This signal is ' + Math.round(age) + ' seconds old'); }
        if (offHours(p.sym)) { score -= 30; warns.push('Stock-linked contract while the US market is closed: thin and jumpy'); }
        if (p.note) { warns.push(p.note); }
        var late = p.moved > 0.4 * tpPct, against = -p.moved > 0.5 * slPct;
        if (late) { warns.push('Price already moved ' + p.moved.toFixed(2) + '% your way. It is late: wait for a pullback'); score -= 20; }
        if (against) { warns.push('Price moved ' + (-p.moved).toFixed(2) + '% against the signal: wait'); score -= 25; }
        score = Math.max(0, Math.min(100, Math.round(score)));
        var tier = score >= 78 && !late && !against && age <= 150 ? 'NOW' : score >= 62 ? 'PREPARE' : 'WATCH';
        out.push({ sym: p.sym, side: p.side, pct: p.pct, score: score, tier: tier, entry: p.price, live: tk.p, moved: p.moved, sl: p.sl, tp: p.tp,
                   stopLvl: p.side === 'LONG' ? p.price - p.sl : p.price + p.sl, tgtLvl: p.side === 'LONG' ? p.price + p.tp : p.price - p.tp, rr: p.tp / p.sl,
                   reasons: reasons, warns: warns, at: p.at, until: p.at + 45 * 60000, spark: p.spark });
    });
    out.sort(function (a, b) { return b.score - a.score; });
    return out;
}
function getActions() { var now = nowMs(); if (now - ACT_CACHE.at > 1500) { ACT_CACHE.list = buildActions(); ACT_CACHE.at = now; } return ACT_CACHE.list; }

// ---------- autonomous paper-trading bot (virtual money, real prices) ----------
var BOT_FEE = 0.0005, BOT_SLIP = 0.0003;
function botLoad() {
    try { var b = JSON.parse(ls('mintoosuite_bot', '')); if (b && b.v === 1) { return b; } } catch (e) {}
    return { v: 1, on: true, start: 1000, bal: 1000, open: [], closed: [], peak: 1000, maxDd: 0, created: nowMs(), risk: 0.01, maxOpen: 3, lev: 5, lastTrade: {} };
}
S.bot = botLoad();
function botSave() { lss('mintoosuite_bot', JSON.stringify(S.bot)); }
function botEquity() { var b = S.bot, u = 0; b.open.forEach(function (p) { var t = S.tick[p.sym]; if (t) { u += p.notional * (p.sg * (t.p - p.entry) / p.entry); } }); return b.bal + u; }
function botClose(i, exit, why) {
    var b = S.bot, p = b.open.splice(i, 1)[0], pnl = p.notional * (p.sg * (exit - p.entry) / p.entry) - p.notional * BOT_FEE * 2;
    b.bal += pnl; if (b.bal > b.peak) { b.peak = b.bal; }
    var dd = b.peak ? (b.peak - b.bal) / b.peak * 100 : 0; if (dd > b.maxDd) { b.maxDd = dd; }
    b.closed.unshift({ sym: p.sym, side: p.side, entry: p.entry, exit: exit, pnl: pnl, at: p.at, ct: nowMs(), why: why, pct: p.pct, r: p.risk ? pnl / p.risk : 0 });
    if (b.closed.length > 300) { b.closed.length = 300; }
    addLog('BOT', (pnl >= 0 ? 'Paper win ' : 'Paper loss ') + nm(p.sym) + ' ' + p.side + ' ' + usd(pnl) + ' (' + why + ')');
    botSave();
}
function botStep() {
    var b = S.bot, now = nowMs(), i; if (!b) { return; }
    for (i = b.open.length - 1; i >= 0; i--) {
        var p = b.open[i], t = S.tick[p.sym]; if (!t || now - t.at > 20000) { continue; }
        var px = t.p, hitSL = p.sg > 0 ? px <= p.sl : px >= p.sl, hitTP = p.sg > 0 ? px >= p.tp : px <= p.tp;
        if (hitSL) { botClose(i, p.sl * (1 - p.sg * BOT_SLIP), 'stop'); }
        else if (hitTP) { botClose(i, p.tp, 'target'); }
        else if (now - p.at > 3 * 3600000) { botClose(i, px, 'time limit'); }
    }
    if (!b.on || dataAge() > 10000 || !S.scan.at || now - S.scan.at > 120000 || b.open.length >= b.maxOpen) { return; }
    var eq = botEquity();
    if (eq <= b.start * 0.5) { b.on = false; botSave(); addLog('BOT', 'Paper bot paused: equity fell below half of the starting amount'); return; }
    getActions().filter(function (a) { return a.tier === 'NOW'; }).forEach(function (a) {
        if (b.open.length >= b.maxOpen || b.open.some(function (p) { return p.sym === a.sym; })) { return; }
        if (b.lastTrade[a.sym] && now - b.lastTrade[a.sym] < 30 * 60000) { return; }
        var t = S.tick[a.sym]; if (!t) { return; }
        var sg = a.side === 'LONG' ? 1 : -1, entry = t.p * (1 + sg * BOT_SLIP), slPct = Math.abs(entry - a.stopLvl) / entry;
        if (!(slPct > 0) || (sg > 0 ? (t.p <= a.stopLvl || t.p >= a.tgtLvl) : (t.p >= a.stopLvl || t.p <= a.tgtLvl))) { return; }
        var cost = slPct + 2 * BOT_FEE + BOT_SLIP, notional = eq * b.risk / cost;
        var lev = Math.max(1, Math.min(b.lev, Math.floor(100 / (slPct * 100 * 1.6 + 0.5)))), margin = notional / lev;
        var used = b.open.reduce(function (s, p) { return s + p.margin; }, 0), avail = b.bal - used;
        if (margin > avail) { margin = avail * 0.95; notional = margin * lev; }
        if (notional < 10) { return; }
        b.open.push({ sym: a.sym, side: a.side, sg: sg, entry: entry, sl: a.stopLvl, tp: a.tgtLvl, notional: notional, margin: margin, lev: lev, at: now, pct: a.pct, score: a.score, risk: notional * cost });
        b.lastTrade[a.sym] = now; botSave();
        addLog('BOT', 'Paper trade opened: ' + nm(a.sym) + ' ' + a.side + ' at ' + fmtP(entry, a.sym) + ' (confidence ' + a.pct + '%, priority ' + a.score + ')');
    });
}
function botStats() {
    var b = S.bot, w = 0, l = 0, gw = 0, gl = 0, rs = 0;
    b.closed.forEach(function (c) { if (c.pnl >= 0) { w++; gw += c.pnl; } else { l++; gl += -c.pnl; } rs += c.r; });
    var n = b.closed.length, eq = botEquity();
    return { n: n, w: w, l: l, wr: n ? Math.round(w / n * 100) : 0, pf: gl ? gw / gl : (gw ? 99 : 0), avgR: n ? rs / n : 0, eq: eq, ret: (eq - b.start) / b.start * 100, dd: b.maxDd };
}
function botReset() { S.bot = { v: 1, on: true, start: 1000, bal: 1000, open: [], closed: [], peak: 1000, maxDd: 0, created: nowMs(), risk: 0.01, maxOpen: 3, lev: 5, lastTrade: {} }; botSave(); }

// ---------- self-healing ----------
S.errs = []; S.heal = []; S.healAt = {};
function noteErr(m) { S.errs.unshift({ t: nowMs(), m: String(m).slice(0, 160) }); if (S.errs.length > 30) { S.errs.length = 30; } }
window.addEventListener('error', function (e) { noteErr(e && e.message || 'error'); });
window.addEventListener('unhandledrejection', function (e) { noteErr(e && e.reason && e.reason.message || 'promise error'); });
function healLog(m) { S.heal.unshift({ t: nowMs(), m: m }); if (S.heal.length > 30) { S.heal.length = 30; } addLog('HEAL', m); }
function healTick() {
    var now = nowMs(), age = dataAge();
    if (navigator.onLine !== false) {
        if (age > 45000 && now - (S.healAt.feed || 0) > 30000) { S.healAt.feed = now; reconnect(); healLog('Live prices were quiet for ' + Math.round(age / 1000) + 's, so the app reconnected'); }
        if (age > 300000 && now - (+ls('mintoosuite_heal_reload', '0')) > 900000) { lss('mintoosuite_heal_reload', String(now)); healLog('No data for 5 minutes, so the app reloaded itself'); setTimeout(reloadFresh, 600); }
    }
    if (S.scan.at && now - S.scan.at > 180000 && now - (S.healAt.scan || 0) > 60000) { S.healAt.scan = now; S.scan.running = false; S.scan.pause = 0; makeWorkers(false); healLog('The scanner was stuck for ' + Math.round((now - S.scan.at) / 1000) + 's, so it restarted its workers'); runScan(); }
    if (S.newsAt && now - S.newsAt > 1800000 && now - (S.healAt.news || 0) > 300000) { S.healAt.news = now; loadNews(); healLog('News were over 30 minutes old, so they were refreshed'); }
    var recent = S.errs.filter(function (e) { return now - e.t < 60000; }).length;
    if (recent >= 8 && now - (+ls('mintoosuite_heal_reload', '0')) > 900000) { lss('mintoosuite_heal_reload', String(now)); healLog('Too many errors in one minute, so the app reloaded itself'); setTimeout(reloadFresh, 600); }
}
function repairNow() {
    healLog('Manual repair: reconnect, restart scanner, refresh news and check for updates');
    reconnect(); S.scan.running = false; S.scan.pause = 0; makeWorkers(false); S.scan.next = 0; runScan(); loadNews(); loadFx(); loadListings(); checkUpdate();
}

// ---------- UI components ----------
function hashStr(s) { var h = 0; for (var i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) >>> 0; } return h; }
function base(sym) { return sym.replace(/USDT$/, ''); }
function avatar(sym) {
    if (sym === 'XAUUSDT' || sym === 'PAXGUSDT') { return '<span class="av gold">Au</span>'; }
    var b = base(sym), h = hashStr(b) % 360;
    return '<span class="av" style="background:linear-gradient(135deg,hsl(' + h + ',68%,56%),hsl(' + ((h + 45) % 360) + ',70%,42%))">' + esc(b.replace(/^1000+/, '').slice(0, 2)) + '</span>';
}
function spark(a, up, color, w, h) {
    if (!a || a.length < 4) { return ''; }
    w = w || 90; h = h || 32;
    var mn = Math.min.apply(null, a), mx = Math.max.apply(null, a), r = (mx - mn) || 1;
    var pts = a.map(function (v, i) { return (i / (a.length - 1) * w).toFixed(1) + ',' + (h - 3 - (v - mn) / r * (h - 6)).toFixed(1); }).join(' ');
    return '<svg class="spark" viewBox="0 0 ' + w + ' ' + h + '" width="' + w + '" height="' + h + '"><polyline points="' + pts + '" fill="none" stroke="' + (color || (up ? 'var(--grn)' : 'var(--red)')) + '" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>';
}
function sparkOf(sym, color) { var r = S.scan.res[sym]; if (!r || !r.spark || r.spark.length < 4) { return ''; } var a = r.spark; return spark(a, a[a.length - 1] >= a[0], color); }
function meter(p) { var n = p >= 75 ? 3 : p >= 55 ? 2 : 1; return '<span class="dots">' + [1, 2, 3].map(function (i) { return '<i' + (i <= n ? ' class="on"' : '') + '></i>'; }).join('') + ' <b style="color:var(--tx);font-size:12px">' + p + '%</b> confidence</span>'; }
function stChip(sym, side) {
    var r = S.scan.res[sym], a = r && r.tf['15m'] && r.tf['15m'].st;
    if (!a || (side !== 'LONG' && side !== 'SHORT')) { return ''; }
    var want = side === 'LONG' ? 1 : -1, now = a.dir > 0 ? 'UP' : 'DOWN';
    if (a.dir === want) { return '<div class="res win">✅ Entry timing OK: the 15m Supertrend is ' + now + ', matching this ' + side + '</div>'; }
    return '<div class="warn">⏳ Wait: the 15m Supertrend is now ' + now + ', against this ' + side + '. Enter only when it flips ' + (want > 0 ? 'UP' : 'DOWN') + '.</div>';
}
function tfWarn(sym) { return offHours(sym) ? '<div class="warn">⚠️ Stock-linked contract. The US market is closed, so trading is thin and prices can jump. Shown for reference only, not as a solid setup.</div>' : ''; }
function badge(side) {
    if (side === 'LONG') { return '<span class="badge long">▲ LONG</span>'; }
    if (side === 'SHORT') { return '<span class="badge short">▼ SHORT</span>'; }
    return '<span class="badge wait">WAIT</span>';
}
function lv(side, price, sl, tp, sym) {
    if (side !== 'LONG' && side !== 'SHORT') { return '<div class="nt">No trade: wait for a clearer setup</div>'; }
    var s = side === 'LONG' ? price - sl : price + sl, t = side === 'LONG' ? price + tp : price - tp;
    return '<div class="lv"><div><span>ENTRY</span><b>' + fmtP(price, sym) + '</b></div><div><span>STOP</span><b class="dn">' + fmtP(s, sym) + '</b></div><div><span>TARGET</span><b class="up">' + fmtP(t, sym) + '</b></div></div>';
}
function lrow(a, lev, slp, tpp, f) {
    var liq = 100 / lev - 0.5, hit = lev > 1 && slp * 100 >= liq;
    return { gain: a * lev * (tpp - f), loss: hit ? a : Math.min(a, a * lev * (slp + f)), liq: liq, hit: hit };
}
function plBox(side, price, sl, tp, sym) {
    if ((side !== 'LONG' && side !== 'SHORT') || !price) { return ''; }
    var f = feeOf(sym), tpp = tp / price, slp = sl / price, L = S.lev, net = tpp - f;
    function r(a) { var x = lrow(a, L, slp, tpp, f); return '<div class="plr"><span>$' + a + (L > 1 ? ' × ' + L : '') + '</span><span class="up">' + usd(x.gain) + '</span><span class="dn">' + usd(-x.loss) + (x.hit ? ' ⚠️' : '') + '</span></div>'; }
    var h = '<div class="pl"><div class="plr hd"><span>INVEST' + (L > 1 ? ' @ ' + L + '×' : '') + '</span><span>AT TARGET</span><span>AT STOP</span></div>' + r(50) + r(100) + '</div>';
    if (L > 1 && lrow(100, L, slp, tpp, f).hit) { h += '<div class="warn">⚠️ At ' + L + '× you are liquidated after about ' + (100 / L - 0.5).toFixed(1) + '% against you, but this stop is ' + (slp * 100).toFixed(1) + '% away. You would lose the whole amount before the stop works.</div>'; }
    function g(inv, goal) {
        if (net <= 0) { return '<div class="plr"><span>$' + goal + ' on $' + inv + '</span><span>not reachable</span><span>—</span></div>'; }
        var need = goal / (inv * net); need = need < 10 ? Math.ceil(need * 10) / 10 : Math.ceil(need); var x = lrow(inv, need, slp, tpp, f);
        if (need > 125) { return '<div class="plr"><span>$' + goal + ' on $' + inv + '</span><span class="org">over 125×</span><span>not possible</span></div>'; }
        return '<div class="plr"><span>$' + goal + ' on $' + inv + '</span><span class="' + (x.hit ? 'dn' : need > 20 ? 'org' : '') + '">' + (need < 10 ? need.toFixed(1) : Math.ceil(need)) + '×</span><span class="dn">' + usd(-x.loss) + (x.hit ? ' ⚠️' : '') + '</span></div>';
    }
    h += '<div class="pl"><div class="plr hd"><span>PROFIT GOAL</span><span>LEVERAGE NEEDED</span><span>LOSS AT STOP</span></div>' + g(50, 20) + g(100, 50) + '</div>';
    var x2 = net > 0 ? lrow(50, Math.ceil(20 / (50 * net)), slp, tpp, f) : null;
    if (x2 && x2.hit) { h += '<div class="warn">⚠️ To reach these goals at this target you need so much leverage that you would be liquidated before the stop. Leverage multiplies profit and loss equally. A smaller target or a smaller goal is safer.</div>'; }
    return h;
}
function levBar() {
    return '<div class="sh" style="margin-top:4px"><span>Profit boxes: leverage</span><span>' + (S.lev > 1 ? S.lev + '× (profit and loss both multiply)' : 'none (1×)') + '</span></div><div class="segc">' +
        [1, 3, 5, 10, 20, 50].map(function (l) { return '<span class="' + (S.lev === l ? 'on' : '') + '" data-act="lev:' + l + '">' + l + '×</span>'; }).join('') + '</div>';
}
function px(sym, fallback) { var t = S.tick[sym]; return '<span data-px="' + sym + '">' + fmtP(t ? t.p : (fallback || 0), sym) + '</span>'; }
function chgLbl(k) { return k === 'today' ? ' today' : ' 24h'; }
function chgTxt(sym, label) { var t = S.tick[sym]; if (!t) { return ''; } var c = chgOf(sym); return '<span class="chg ' + cc(c.v) + '" data-chg="' + sym + '" data-lbl="' + (label ? 1 : 0) + '">' + pct(c.v) + (label ? chgLbl(c.kind) : '') + '</span>'; }
function chgChip(sym) { var t = S.tick[sym]; if (!t) { return ''; } var c = chgOf(sym); return '<span class="badge ' + (c.v >= 0 ? 'long' : 'short') + '" data-chip="' + sym + '">' + pct(c.v) + '</span>'; }
function bothChg(sym) { var c = chgOf(sym); return c.kind === 'today' ? 'Today ' + pct(c.v) + ' (since ' + anchorLbl() + ') • 24h ' + pct(c.roll) : '24h ' + pct(c.roll); }
function sh(title, right) { return '<div class="sh"><span>' + title + '</span><span>' + (right || '') + '</span></div>'; }
function skel(n, h) { var o = ''; for (var i = 0; i < n; i++) { o += '<div class="sk skb"' + (h ? ' style="height:' + h + 'px"' : '') + '></div>'; } return o; }
function who(sym, sub) { return '<div class="who">' + avatar(sym) + '<div><b>' + (sym === 'XAUUSDT' || sym === 'PAXGUSDT' ? 'Gold' : base(sym)) + '</b><small>' + (sub || (sym === 'XAUUSDT' || sym === 'PAXGUSDT' ? sym : 'USDT Perpetual')) + '</small></div></div>'; }

function pickCard(p) {
    return '<div class="group pad tap" data-act="chart:' + p.sym + '"><div class="ph">' + who(p.sym) + '<div class="side">' + badge(p.side) + meter(p.pct) + '</div></div>' + tfWarn(p.sym) +
        '<div class="pm"><div><div class="px">' + px(p.sym, p.price) + '</div>' + chgTxt(p.sym, true) + '</div>' + sparkOf(p.sym) + '</div>' +
        lv(p.side, p.price, p.sl, p.tp, p.sym) + plBox(p.side, p.price, p.sl, p.tp, p.sym) +
        '<div class="foot">' + bothChg(p.sym) + '<br>Valid ' + hm(p.at) + ' → ' + hm(p.at + 45 * 60000) + ' • RSI ' + p.rsi.toFixed(0) + ' • volume ×' + p.vr.toFixed(1) + (p.note ? ' • ' + esc(p.note) : '') + (p.st ? ' • 15m Supertrend ' + (p.st.dir > 0 ? 'UP' : 'DOWN') : '') + '</div></div>';
}
function heroPick(p) {
    return '<div class="hero tap" data-act="chart:' + p.sym + '"><div class="hl"><span>Top master pick</span><span>10m + 15m agree</span></div>' +
        '<div class="ph" style="margin-top:12px">' + who(p.sym) + '<div class="side"><span class="badge">' + (p.side === 'LONG' ? '▲ LONG' : '▼ SHORT') + '</span><span class="dots" style="color:rgba(255,255,255,.9)"><b style="color:#fff;font-size:15px">' + p.pct + '%</b> confidence</span></div></div>' +
        '<div class="pm"><div><div class="px">' + px(p.sym, p.price) + '</div>' + chgTxt(p.sym, true) + '</div>' + sparkOf(p.sym, '#fff') + '</div>' +
        lv(p.side, p.price, p.sl, p.tp, p.sym) + plBox(p.side, p.price, p.sl, p.tp, p.sym) +
        '<div class="foot" style="color:rgba(255,255,255,.82)">Valid ' + hm(p.at) + ' → ' + hm(p.at + 45 * 60000) + ' • tap for chart</div></div>';
}
function stile(label, sym) {
    var t = S.tick[sym];
    if (!t) { return '<div class="group stile"><div class="lb">' + avatar(sym) + label + '</div><div class="sk" style="height:34px;margin-top:10px"></div></div>'; }
    return '<div class="group stile tap" data-act="chart:' + sym + '"><div class="lb" style="gap:9px">' + avatar(sym).replace('width:38px', '') + '<span>' + label + '</span></div><div class="big">' + px(sym) + '</div><div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px">' + chgTxt(sym, true) + sparkOf(sym) + '</div></div>';
}
function scanSummary() {
    var s = S.scan;
    if (!s.at) { return '<div class="group pad"><div class="sk" style="height:60px"></div><div class="note" style="margin:8px 0 0">Starting the first scan… results appear in a few seconds.</div></div>'; }
    var age = Math.round((nowMs() - s.at) / 1000), stale = age > 120;
    return '<div class="group"><div class="row"><span>Last scan</span><b class="' + (stale ? 'org' : '') + '">' + age + 's ago' + (stale ? ' (delayed)' : '') + '</b></div>' +
        '<div class="row"><span>Coins scanned</span><b>' + s.n + ' of ' + s.total + ' in ' + (s.ms / 1000).toFixed(1) + 's</b></div>' +
        '<div class="row"><span>Parallel scans</span><b>' + (NW * CONC) + ' (' + NW + ' ' + (S.threads === 'workers' ? 'workers' : 'lanes') + ' × ' + CONC + ')</b></div>' +
        '<div class="row"><span>Next scan</span><b>' + (s.pause > nowMs() ? 'paused by Binance rate limit' : 'in ' + Math.max(0, Math.round((s.next - nowMs()) / 1000)) + 's') + '</b></div></div>';
}

// ---------- Binance trading (your own API keys, kept only on this phone) ----------
var TR = { busy: false, args: null, m: 0, L: 0 };
function decOf(x) { var s = (+x).toFixed(10).replace(/0+$/, ''); return s.indexOf('.') < 0 ? 0 : s.length - s.indexOf('.') - 1; }
function trCfg() { return { key: ls('mintoosuite_tk', ''), sec: ls('mintoosuite_ts', ''), net: ls('mintoosuite_tnet', 'test') === 'live' ? 'live' : 'test', margin: +ls('mintoosuite_tmargin', '20') || 20 }; }
function trSign(qs, sec) {
    var enc = new TextEncoder();
    return crypto.subtle.importKey('raw', enc.encode(sec), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']).then(function (k) { return crypto.subtle.sign('HMAC', k, enc.encode(qs)); }).then(function (b) {
        return Array.prototype.map.call(new Uint8Array(b), function (x) { return ('0' + x.toString(16)).slice(-2); }).join('');
    });
}
function trCall(method, path, params) {
    var c = trCfg();
    if (!c.key || !c.sec) { return Promise.reject(new Error('Add your Binance API key and secret in the Trade window first.')); }
    if (!window.crypto || !window.crypto.subtle) { return Promise.reject(new Error('Secure signing is not available in this browser.')); }
    var base = c.net === 'live' ? 'https://fapi.binance.com' : 'https://testnet.binancefuture.com', p = params || {};
    p.timestamp = Math.round(nowMs()); p.recvWindow = 10000;
    var qs = Object.keys(p).map(function (k) { return k + '=' + encodeURIComponent(p[k]); }).join('&');
    return trSign(qs, c.sec).then(function (sig) {
        return fetch(base + path + '?' + qs + '&signature=' + sig, { method: method, headers: { 'X-MBX-APIKEY': c.key } });
    }).then(function (r) {
        return r.text().then(function (t) {
            var j; try { j = JSON.parse(t); } catch (e) { j = { msg: String(t).slice(0, 160) }; }
            if (!r.ok || (j && !Array.isArray(j) && j.code && j.code < 0)) { throw new Error('Binance: ' + (j && j.msg || r.status) + (j && j.code ? ' (' + j.code + ')' : '')); }
            return j;
        });
    }, function () { throw new Error('Could not reach Binance. Check your internet, VPN or region block.'); });
}
function trFirst(method, paths, params) { return trCall(method, paths[0], JSON.parse(JSON.stringify(params || {}))).catch(function (e) { if (paths.length > 1 && !/-2015|-1022|-2014/.test(e.message)) { return trFirst(method, paths.slice(1), params); } throw e; }); }
function trPlan(sym, side, slLvl, tpLvl, margin, lev) {
    var t = S.tick[sym], f = S.filt[sym];
    if (!t) { return { err: 'No live price for ' + sym + ' yet.' }; }
    if (!f || !f.tick || !(f.mstep || f.step)) { return { err: 'Binance trading rules for ' + sym + ' are not loaded yet. Wait a few seconds for the live feed, then try again.' }; }
    if (!(margin > 0) || !(lev >= 1 && lev <= 125)) { return { err: 'Margin must be above 0 and leverage between 1 and 125.' }; }
    var price = t.p, long = side === 'LONG', step = f.mstep || f.step, minQ = f.mmin || f.min || 0, maxQ = f.mmax || Infinity, dq = decOf(step), dt = decOf(f.tick);
    var qty = Math.floor(margin * lev / price / step + 1e-9) * step; if (qty > maxQ) { qty = Math.floor(maxQ / step) * step; } qty = +qty.toFixed(dq);
    var sl = +(Math.round(slLvl / f.tick) * f.tick).toFixed(dt), tp = +(Math.round(tpLvl / f.tick) * f.tick).toFixed(dt);
    if (qty <= 0 || qty < minQ) { return { err: 'The amount is too small for this coin (minimum ' + minQ + '). Raise margin or leverage.' }; }
    if (qty * price < (f.notional || 5)) { return { err: 'The position value is below Binance\'s minimum of $' + (f.notional || 5) + '. Raise margin or leverage.' }; }
    if (long ? !(sl < price && price < tp) : !(tp < price && price < sl)) { return { err: 'The price has already moved past the stop or the target, so this setup is no longer valid. Do not enter.' }; }
    var notional = qty * price;
    return { sym: sym, side: side, qty: qty, qtyS: qty.toFixed(dq), dq: dq, price: price, sl: sl, tp: tp, slS: sl.toFixed(dt), tpS: tp.toFixed(dt), margin: margin, lev: lev, notional: notional, risk: qty * Math.abs(price - sl), reward: qty * Math.abs(tp - price), fees: notional * 0.0005 * 2 };
}
function trLogAdd(o) { var a; try { a = JSON.parse(ls('mintoosuite_trades', '[]')) || []; } catch (e) { a = []; } a.unshift(o); lss('mintoosuite_trades', JSON.stringify(a.slice(0, 30))); }
function trModal() {
    var c = trCfg(), a = TR.args, m = TR.m || c.margin, L = TR.L || S.lev || 5, p = trPlan(a.sym, a.side, a.sl, a.tp, m, L), live = c.net === 'live';
    var h = '<div class="tmod-in"><div class="warn" style="margin-top:0;' + (live ? 'background:rgba(229,56,59,.14);color:var(--red)' : '') + '">' + (live ? '🔴 LIVE — this uses real money on your Binance account.' : '🔵 TEST MODE — Binance testnet, no real money.') + '</div>' +
        '<div style="font-size:19px;font-weight:800">' + esc(base(a.sym)) + ' ' + (a.side === 'LONG' ? '▲ LONG (buy)' : '▼ SHORT (sell)') + '</div>';
    h += '<div style="display:flex;gap:10px;margin:12px 0"><div style="flex:1"><div class="note" style="margin:0 0 4px">Margin (USDT)</div><input class="tin" id="trM" type="number" inputmode="decimal" min="1" step="any" value="' + m + '"></div><div style="flex:1"><div class="note" style="margin:0 0 4px">Leverage (×)</div><input class="tin" id="trL" type="number" inputmode="numeric" min="1" max="125" step="1" value="' + L + '"></div></div><button class="btn sec" data-tr="recalc">Update numbers</button>';
    if (p.err) { h += '<div class="warn">⚠️ ' + esc(p.err) + '</div>'; }
    else {
        h += '<div class="group" style="margin:12px 0"><div class="row"><span>Quantity</span><b>' + p.qtyS + ' ' + esc(base(a.sym)) + '</b></div><div class="row"><span>Entry (market now)</span><b>' + fmtP(p.price, a.sym) + '</b></div><div class="row"><span>Stop-loss</span><b class="dn">' + p.slS + '</b></div><div class="row"><span>Take-profit</span><b class="up">' + p.tpS + '</b></div>' +
            '<div class="row"><span>Position value</span><b>$' + p.notional.toFixed(2) + '</b></div><div class="row"><span>If the stop is hit</span><b class="dn">−$' + (p.risk + p.fees).toFixed(2) + '</b></div><div class="row"><span>If the target is hit</span><b class="up">+$' + Math.max(0, p.reward - p.fees).toFixed(2) + '</b></div></div>' +
            '<div class="note" style="margin:0 0 10px">Amounts include an estimated 0.05% fee each way. A fast market can fill the stop at a worse price (slippage). The stop and target are placed right after the entry fills; if the stop cannot be placed, the app closes the position again.' + (a.until ? ' Signal valid until ' + hm(a.until) + '.' : '') + '</div>';
    }
    if (live) { h += '<input class="tin" id="trType" placeholder="Type TRADE to confirm" autocapitalize="characters" autocomplete="off" style="margin-bottom:10px">'; }
    h += '<div id="trRes" class="note" style="margin:6px 0 10px"></div><div style="display:flex;gap:10px"><button class="btn sec" style="flex:1" data-tr="close">Cancel</button><button class="btn" id="trGoBtn" style="flex:1' + (live ? ';background:var(--red)' : '') + '" data-tr="go"' + (p.err ? ' disabled' : '') + '>Place order</button></div></div>';
    return h;
}
function trShow() { var m = $('trMod'); if (!m) { m = document.createElement('div'); m.id = 'trMod'; m.className = 'tmod'; document.body.appendChild(m); } m.innerHTML = trModal(); }
function trOpen(el) {
    var c = trCfg(), sym = el.getAttribute('data-sym'), until = +el.getAttribute('data-until') || 0;
    if (!SYM_OK.test(sym)) { return; }
    if (!c.key || !c.sec) { window.alert('Add your Binance API key and secret first (Trade window).'); gotoWin('trade'); return; }
    if (until && nowMs() > until) { window.alert('This recommendation has expired. Wait for a fresh one.'); return; }
    TR.args = { sym: sym, side: el.getAttribute('data-side'), sl: +el.getAttribute('data-sl'), tp: +el.getAttribute('data-tp'), until: until }; TR.m = 0; TR.L = 0; TR.busy = false; trShow();
}
function trGo() {
    if (TR.busy || !TR.args) { return; }
    var c = trCfg(), a = TR.args, m = +$('trM').value, L = Math.round(+$('trL').value), p = trPlan(a.sym, a.side, a.sl, a.tp, m, L), res = $('trRes'), log = [];
    function say(t) { log.push(t); res.innerHTML = log.map(esc).join('<br>'); }
    if (p.err) { res.textContent = p.err; return; }
    if (a.until && nowMs() > a.until) { res.textContent = 'This recommendation has expired. Do not enter.'; return; }
    if (c.net === 'live' && String($('trType').value).trim().toUpperCase() !== 'TRADE') { res.textContent = 'Type TRADE in the box to confirm a live order.'; return; }
    TR.busy = true; $('trGoBtn').disabled = true;
    var sym = p.sym, long = p.side === 'LONG', open = long ? 'BUY' : 'SELL', close = long ? 'SELL' : 'BUY', fq = p.qtyS;
    say('Checking position mode…');
    trCall('GET', '/fapi/v1/positionSide/dual', {}).then(function (r) {
        if (r.dualSidePosition) { throw new Error('Your Binance account is in Hedge mode. Switch to One-way mode (Futures → Preferences → Position Mode), then try again.'); }
        say('Setting isolated margin…');
        return trCall('POST', '/fapi/v1/marginType', { symbol: sym, marginType: 'ISOLATED' }).catch(function (e) { if (/-4046/.test(e.message)) { return; } throw e; });
    }).then(function () {
        say('Setting leverage ' + p.lev + '×…'); return trCall('POST', '/fapi/v1/leverage', { symbol: sym, leverage: p.lev });
    }).then(function () {
        say('Sending market order…');
        return trCall('POST', '/fapi/v1/order', { symbol: sym, side: open, type: 'MARKET', quantity: p.qtyS, newOrderRespType: 'RESULT', newClientOrderId: 'mt' + Date.now() });
    }).then(function (o) {
        var ex = +o.executedQty;
        if (!(ex > 0)) { throw new Error('The order was sent but a fill is not confirmed. Open Binance now and check your positions and open orders.'); }
        fq = ex.toFixed(p.dq); say('Filled ' + fq + ' at about ' + (+o.avgPrice ? fmtP(+o.avgPrice, sym) : fmtP(p.price, sym)) + '.'); say('Placing stop-loss…');
        return trCall('POST', '/fapi/v1/algoOrder', { algoType: 'CONDITIONAL', symbol: sym, side: close, type: 'STOP_MARKET', quantity: fq, triggerPrice: p.slS, reduceOnly: 'true', workingType: 'MARK_PRICE' }).catch(function (e) {
            say('Stop-loss failed (' + e.message + '). Closing the position now for safety…');
            return trCall('POST', '/fapi/v1/order', { symbol: sym, side: close, type: 'MARKET', quantity: fq, reduceOnly: 'true' }).then(function () {
                throw new Error('The position was closed again because the stop-loss could not be placed. Nothing is left open.');
            }, function (e2) { throw new Error('DANGER: the entry filled, the stop-loss failed and the emergency close also failed (' + e2.message + '). Open Binance NOW and close or protect the position.'); });
        });
    }).then(function () {
        say('Stop-loss set at ' + p.slS + '.'); say('Placing take-profit…');
        return trCall('POST', '/fapi/v1/algoOrder', { algoType: 'CONDITIONAL', symbol: sym, side: close, type: 'TAKE_PROFIT_MARKET', quantity: fq, triggerPrice: p.tpS, reduceOnly: 'true', workingType: 'MARK_PRICE' }).then(function () { say('Take-profit set at ' + p.tpS + '.'); }, function (e) { say('⚠️ Take-profit failed (' + e.message + '). The stop-loss is active; set the target yourself in Binance.'); });
    }).then(function () {
        trLogAdd({ at: Date.now(), sym: sym, side: p.side, qty: fq, price: p.price, sl: p.slS, tp: p.tpS, net: c.net }); say('✅ Done. Check it in the Binance app.');
    }).catch(function (e) { say('❌ ' + e.message); }).then(function () { TR.busy = false; });
}
function trSave() {
    var k = $('trK').value.trim(), s = $('trS').value.trim(), m = +$('trMg').value, n = $('trNet').value, out = $('trOut');
    if (k && !/^[A-Za-z0-9]{32,100}$/.test(k)) { out.innerHTML = '<div class="warn">That API key does not look right. Copy it again from Binance.</div>'; return; }
    if (s && !/^[A-Za-z0-9]{32,100}$/.test(s)) { out.innerHTML = '<div class="warn">That secret does not look right. Copy it again from Binance.</div>'; return; }
    if (k) { lss('mintoosuite_tk', k); } if (s) { lss('mintoosuite_ts', s); } if (m > 0) { lss('mintoosuite_tmargin', String(m)); } lss('mintoosuite_tnet', n === 'live' ? 'live' : 'test');
    $('trK').value = ''; $('trS').value = ''; out.innerHTML = '<div class="note">Saved on this phone only.</div>'; renderView(true);
}
function trCheck() {
    var out = $('trOut'); out.innerHTML = '<div class="note">Checking…</div>';
    trFirst('GET', ['/fapi/v3/balance', '/fapi/v2/balance'], {}).then(function (b) {
        var u = (b || []).filter(function (x) { return x.asset === 'USDT'; })[0], h = '<div class="group"><div class="row"><span>Connection</span><b class="up">OK (' + (trCfg().net === 'live' ? 'LIVE' : 'TEST') + ')</b></div><div class="row"><span>USDT balance</span><b>' + (u ? (+u.balance).toFixed(2) : '0.00') + '</b></div><div class="row"><span>Available</span><b>' + (u ? (+u.availableBalance).toFixed(2) : '0.00') + '</b></div></div>';
        return trFirst('GET', ['/fapi/v3/positionRisk', '/fapi/v2/positionRisk'], {}).then(function (ps) {
            ps = (ps || []).filter(function (x) { return +x.positionAmt !== 0; });
            h += sh('Open positions') + '<div class="group">' + (ps.length ? ps.map(function (x) { var amt = +x.positionAmt; return '<div class="row" style="display:block"><div style="display:flex;justify-content:space-between"><b>' + esc(x.symbol) + ' ' + (amt > 0 ? '▲ LONG' : '▼ SHORT') + '</b><b class="' + (+x.unRealizedProfit >= 0 ? 'up' : 'dn') + '">' + usd(+x.unRealizedProfit) + '</b></div><div class="note" style="margin:4px 0 8px">Size ' + Math.abs(amt) + ' • entry ' + esc(x.entryPrice) + ' • liquidation ' + esc(x.liquidationPrice) + '</div><button class="btn sec" data-tr="closepos" data-sym="' + esc(x.symbol) + '" data-amt="' + Math.abs(amt) + '" data-side="' + (amt > 0 ? 'SELL' : 'BUY') + '">Close this position now</button></div>'; }).join('') : '<div class="row mut">No open positions.</div>') + '</div>';
            out.innerHTML = h;
        });
    }).catch(function (e) { out.innerHTML = '<div class="warn">' + esc(e.message) + '</div>'; });
}
function trClosePos(el) {
    var sym = el.getAttribute('data-sym'), amt = el.getAttribute('data-amt'), side = el.getAttribute('data-side');
    if (!SYM_OK.test(sym) || !(+amt > 0) || (side !== 'BUY' && side !== 'SELL')) { return; }
    if (!window.confirm('Close the whole ' + sym + ' position at market now?')) { return; }
    trCall('POST', '/fapi/v1/order', { symbol: sym, side: side, type: 'MARKET', quantity: amt, reduceOnly: 'true' }).then(function () {
        return trCall('DELETE', '/fapi/v1/algoOpenOrders', { symbol: sym }).catch(function () {});
    }).then(function () { return trCall('DELETE', '/fapi/v1/allOpenOrders', { symbol: sym }).catch(function () {}); }).then(function () { window.alert('Position closed and its open stop/target orders cancelled.'); trCheck(); }).catch(function (e) { window.alert(e.message); });
}
function vTrade() {
    var c = trCfg(), live = c.net === 'live', h = '', hist = []; try { hist = JSON.parse(ls('mintoosuite_trades', '[]')) || []; } catch (e) {}
    h += '<div class="warn">Leveraged futures can lose your whole margin quickly. Signals are estimates, not guarantees. Start in <b>Test mode</b>, and use real money only with an amount you can afford to lose.</div>';
    h += sh('Your Binance API keys') + '<div class="group pad"><div class="note" style="margin:0 0 8px">Create the key in Binance → API Management. Enable <b>Futures</b> only. <b>Never enable withdrawals.</b> Keys are saved only on this phone, as plain text in this app\'s storage, and are sent only to Binance. For Test mode, create keys at testnet.binancefuture.com.</div>' +
        '<div class="note" style="margin:0 0 4px">API key' + (c.key ? ' (saved: …' + esc(c.key.slice(-4)) + ')' : '') + '</div><input class="tin" id="trK" type="password" autocomplete="off" placeholder="' + (c.key ? 'Leave empty to keep the saved key' : 'Paste API key') + '">' +
        '<div class="note" style="margin:10px 0 4px">Secret' + (c.sec ? ' (saved)' : '') + '</div><input class="tin" id="trS" type="password" autocomplete="off" placeholder="' + (c.sec ? 'Leave empty to keep the saved secret' : 'Paste secret') + '">' +
        '<div class="note" style="margin:10px 0 4px">Mode</div><select class="tin" id="trNet"><option value="test"' + (live ? '' : ' selected') + '>Test (Binance testnet, fake money)</option><option value="live"' + (live ? ' selected' : '') + '>LIVE (real money)</option></select>' +
        '<div class="note" style="margin:10px 0 4px">Default margin per trade (USDT)</div><input class="tin" id="trMg" type="number" inputmode="decimal" min="1" step="any" value="' + c.margin + '">' +
        '<div style="display:flex;gap:10px;margin-top:12px"><button class="btn" style="flex:1" data-tr="save">Save</button><button class="btn sec" style="flex:1" data-tr="check">Check connection</button></div>' +
        (c.key || c.sec ? '<button class="btn sec" style="margin-top:10px" data-tr="clear">Remove saved keys</button>' : '') + '</div><div id="trOut"></div>';
    h += sh('How an order works') + '<div class="group pad"><div class="note" style="margin:0">Tap <b>Trade this on Binance</b> on a recommendation. You see the exact quantity, stop, target and the money at risk, then confirm. The app sets isolated margin and your leverage, enters at market, then places a reduce-only stop-loss and take-profit. If the stop cannot be placed, the position is closed again. One position per coin at a time; the account must be in One-way mode.</div></div>';
    if (hist.length) { h += sh('Orders sent from this app') + '<div class="group">' + hist.slice(0, 10).map(function (o) { return '<div class="row" style="display:block"><b>' + esc(o.sym) + ' ' + esc(o.side) + '</b> <span class="mut">' + (o.net === 'live' ? 'LIVE' : 'TEST') + '</span><div class="note" style="margin:3px 0 0">' + pkd(o.at) + ' PKT • qty ' + esc(o.qty) + ' • entry ≈ ' + esc(o.price) + ' • SL ' + esc(o.sl) + ' • TP ' + esc(o.tp) + '</div></div>'; }).join('') + '</div>'; }
    return h + '<div class="note">Exness cannot be traded from this app: Exness offers retail traders no public order API, only MetaTrader 5 and its own app. Use the Exness window for the plan and lot sizes, then place the order in Exness.</div>';
}
function vExness() {
    var t = S.tick[GOLD], h = '', now = nowMs();
    if (!t) { return skel(1, 150); }
    h += '<div class="group pad"><div class="ph">' + who(GOLD, 'Exness XAU/USD (live, via Binance gold)') + chgChip(GOLD) + '</div><div class="pm"><div class="px">' + px(GOLD) + '</div>' + sparkOf(GOLD) + '</div></div>';
    if (goldClosed(new Date(now))) { h += '<div class="warn">Exness gold is closed (weekend). Plans start at ' + fmtT(nextGoldOpen(now)) + '.</div>'; }
    var D0 = dayOpenFor(now), g = S.morning.D === D0 ? S.morning.items.filter(function (o) { return o.sym === GOLD && o.today; })[0] : null, gp = S.plan.items.filter(function (r) { return r.kind === 'gold'; })[0], side, entry, sl, tp;
    h += sh('Gold plan') + (g ? morningCard(g) : gp ? planCard(gp, 'Gold', true) : skel(1, 160));
    if (g) { side = g.today.day; entry = g.today.entry; sl = g.today.dSL; tp = g.today.dTP; } else if (gp) { side = gp.day; entry = gp.price; sl = gp.daySL; tp = gp.dayTP; }
    if ((side === 'LONG' || side === 'SHORT') && sl > 0 && tp > 0) {
        h += sh('Lot sizes for the whole-day plan') + '<div class="group"><div class="row"><span><b>' + (side === 'LONG' ? 'BUY' : 'SELL') + '</b> at ' + fmtP(entry, GOLD) + '</span><span class="mut">SL ' + fmtP(side === 'LONG' ? entry - sl : entry + sl, GOLD) + ' • TP ' + fmtP(side === 'LONG' ? entry + tp : entry - tp, GOLD) + '</span></div>';
        [0.01, 0.05, 0.1, 0.5].forEach(function (lot) { h += '<div class="row"><span>' + lot.toFixed(2) + ' lot <small class="mut">(margin ≈ $' + (entry * 100 * lot / 200).toFixed(0) + ' at 1:200)</small></span><b><span class="up">' + usd(lot * 100 * tp) + '</span> / <span class="dn">' + usd(-lot * 100 * sl) + '</span></b></div>'; });
        h += '</div>' + sh('Lot size for a fixed risk') + '<div class="group">' + [20, 50, 100].map(function (r) { var lots = Math.floor(r / (100 * sl) * 100) / 100; return '<div class="row"><span>Risk $' + r + ' at the stop</span><b>' + (lots >= 0.01 ? lots.toFixed(2) + ' lot' : 'below 0.01 lot') + '</b></div>'; }).join('') + '</div>' +
            '<div class="note">Uses 1 lot = 100 oz of gold, so a $1 move changes 0.01 lot by about $1. Check the contract size in your Exness account. Spread, commission and swap are not included.</div>';
    } else if (g || gp) { h += '<div class="group pad mut">No gold trade is planned right now (WAIT). Waiting is also a decision.</div>'; }
    if (g) { var d = recStats([g], 'dayRes'), f = recStats([g], 'fhRes'); h += sh('Gold statistics, last 9 days replayed') + '<div class="group"><div class="row"><span>Whole day</span><b>' + coinStats(g, 'dayRes') + '</b></div><div class="row"><span>Few hours</span><b>' + coinStats(g, 'fhRes') + '</b></div><div class="row"><span>Win rate (decided trades)</span><b>' + d.wr + '% day • ' + f.wr + '% few hours</b></div></div><div class="note">Replay of the same rules on real past candles. Past results do not guarantee future results.</div>'; }
    return h + '<div class="note">Exness publishes no free price feed, so prices come from Binance gold futures and can differ slightly from your Exness chart. To trade, place the order in the Exness app or MetaTrader 5 with the levels above.</div>';
}
document.addEventListener('click', function (e) {
    var el = e.target.closest ? e.target.closest('[data-tr]') : null, a;
    if (!el) { if (e.target.classList && e.target.classList.contains('tmod') && !TR.busy) { e.target.parentNode.removeChild(e.target); } return; }
    a = el.getAttribute('data-tr');
    if (a === 'open') { trOpen(el); } else if (a === 'close') { if (!TR.busy) { var m = $('trMod'); if (m) { m.parentNode.removeChild(m); } } }
    else if (a === 'recalc') { if (!TR.busy) { TR.m = +$('trM').value; TR.L = Math.round(+$('trL').value); trShow(); } }
    else if (a === 'go') { trGo(); } else if (a === 'save') { trSave(); } else if (a === 'check') { trCheck(); } else if (a === 'closepos') { trClosePos(el); }
    else if (a === 'clear') { if (window.confirm('Remove the saved API key and secret from this phone?')) { try { localStorage.removeItem('mintoosuite_tk'); localStorage.removeItem('mintoosuite_ts'); } catch (err) {} renderView(true); } }
});


function vCalib() {
    var cur = S.anchor === 'roll' ? 'Binance 24-hour value' : 'change since ' + anchorLbl(), top = Object.keys(S.tick).filter(function (k) { return S.tick[k].q > 2e7 && k !== GOLD; }).sort(function (a, b) { return Math.abs(S.tick[b].chg) - Math.abs(S.tick[a].chg); })[0] || 'BRUSDT';
    return '<div class="group pad"><div class="note" style="margin:0 0 8px">Open Binance Futures, pick any coin, and type its name and the % that Binance shows <b>right now</b>. The app tests every possible starting point and keeps the one that matches Binance.</div><div class="note" style="margin:0 0 4px">Coin (for example BR)</div><input class="tin" id="cbSym" value="' + esc(base(top)) + '" autocapitalize="characters" autocomplete="off"><div class="note" style="margin:10px 0 4px">% shown by Binance (for example 16.84)</div><input class="tin" id="cbPct" type="number" inputmode="decimal" step="any"><button class="btn" style="margin-top:12px" data-cb="run">Match Binance</button></div><div id="cbOut"></div><div class="note">Now using: ' + cur + '.</div>' + (S.anchor === 'roll' ? '' : '<button class="btn sec" data-cb="reset">Go back to the Binance 24-hour value</button>');
}
function cbRun() {
    var sym = String($('cbSym').value || '').trim().toUpperCase().replace(/USDT$/, '') + 'USDT', typed = parseFloat($('cbPct').value), out = $('cbOut'), t = S.tick[sym];
    if (!SYM_OK.test(sym) || !t) { out.innerHTML = '<div class="warn">That coin is not in the live list. Type its short name, for example BR.</div>'; return; }
    if (!isFinite(typed)) { out.innerHTML = '<div class="warn">Type the % number shown on Binance.</div>'; return; }
    out.innerHTML = '<div class="note">Testing every starting point…</div>';
    fetch('https://fapi.binance.com/fapi/v1/klines?symbol=' + sym + '&interval=1h&limit=60').then(function (r) { return r.json(); }).then(function (ks) {
        var now = nowMs(), c = [{ h: 'roll', v: t.chg, n: 'Binance 24-hour value' }];
        for (var h = 0; h < 24; h++) { var st = anchorStart(now, h), k = null; for (var i = 0; i < ks.length; i++) { if (+ks[i][0] === st) { k = ks[i]; } } if (k && +k[1] > 0) { c.push({ h: h, v: (t.p - +k[1]) / +k[1] * 100, n: 'since ' + ((h + 5) % 24 < 10 ? '0' : '') + (h + 5) % 24 + ':00 PKT' }); } }
        c.forEach(function (x) { x.d = Math.abs(x.v - typed); }); c.sort(function (a, b) { return a.d - b.d; });
        var b = c[0], tbl = '<div class="group">' + c.slice(0, 4).map(function (x) { return '<div class="row"><span>' + esc(x.n) + '</span><b>' + pct(x.v) + '</b></div>'; }).join('') + '</div>';
        if (b.d <= 0.6 && (!c[1] || c[1].d - b.d >= 0.25)) {
            S.anchor = b.h; lss('mintoosuite_anchor', String(b.h)); S.dayOpen = {}; S.dayOpenTried = 0;
            out.innerHTML = '<div class="note" style="color:var(--green)">Matched: ' + esc(b.n) + ' (' + pct(b.v) + ' against your ' + pct(typed) + ').</div>' + tbl + '<div class="note">The app is loading the starting prices for all coins. Wait about a minute, then compare a few coins in Binance Live with Binance.</div>';
        } else {
            out.innerHTML = '<div class="warn">No clear match. Closest options are below. Type the % again while looking at Binance, or try a coin with a bigger move.</div>' + tbl;
        }
    }).catch(function () { out.innerHTML = '<div class="warn">Could not reach Binance. Check your connection and try again.</div>'; });
}
document.addEventListener('click', function (e) {
    var el = e.target.closest ? e.target.closest('[data-cb]') : null; if (!el) { return; }
    if (el.getAttribute('data-cb') === 'run') { cbRun(); } else { S.anchor = 'roll'; lss('mintoosuite_anchor', 'roll'); renderView(true); }
});
