    /* screens */
    function inp(k, type, ph) { return '<input data-wf="' + k + '" type="' + type + '" placeholder="' + ph + '" autocomplete="off" autocapitalize="none" spellcheck="false" value="' + esc(f[k] || '') + '" style="width:100%;box-sizing:border-box;padding:12px;margin:6px 0;border-radius:10px;border:1px solid #8e8e9355;font-size:16px;background:transparent;color:inherit">'; }
    function sel(k, opts) { var o = '<select data-wf="' + k + '" style="width:100%;padding:12px;margin:6px 0;border-radius:10px;border:1px solid #8e8e9355;font-size:16px;background:transparent;color:inherit">'; opts.forEach(function (x) { o += '<option value="' + x[0] + '"' + ((f[k] || opts[0][0]) === x[0] ? ' selected' : '') + '>' + esc(x[1]) + '</option>'; }); return o + '</select>'; }
    function chunk(a) { return a.slice(0, 8) + ' ' + a.slice(8).replace(/(.{4})/g, '$1 ').trim(); }
    function btn(a, t, sec) { return '<button class="btn' + (sec ? ' sec' : '') + '" data-w="' + a + '"' + (st.busy ? ' disabled' : '') + ' style="width:100%;margin:6px 0">' + t + '</button>'; }
    function addrRow(n, a) { return '<div class="row" style="display:block"><span>' + n + '</span><div style="word-break:break-all;font-family:monospace;font-size:13px;margin:4px 0 8px">' + esc(a) + '</div><button class="btn sec" data-w="copy:' + esc(a) + '" style="width:100%">Copy address</button></div>'; }
    function html() {
        var p = pubs(), h = '<div class="group pad">', m = st.mode, i;
        if (st.msg) { h += '<div class="note" style="margin:0 0 10px;font-weight:600">' + esc(st.msg) + '</div>'; }
        if (m === 'home' && !p) {
            h += '<b>Your own wallet</b><div class="note" style="margin:6px 0 10px">Your keys are made and kept only on this phone. Nobody, including MintooSuite, can see them or recover them. If you lose the 12 words and the phone, the money is gone for good.</div>' + btn('create', 'Create a new wallet') + btn('import', 'I already have 12 words (import)', 1);
        } else if (m === 'home') {
            h += '<b>My wallet</b><div class="note" style="margin:4px 0 8px">Receive on the networks shown. Your EVM address works on BNB Smart Chain (BEP-20), Ethereum, Polygon, Arbitrum and Base, for coins and tokens. Practice first, then try a very small amount.</div>' + addrRow('Ethereum, BNB Smart Chain and other EVM networks', p.evm) + addrRow('Bitcoin (native SegWit)', p.btc) + '<b>Balances</b>';
            if (st.bal) { Object.keys(st.bal).forEach(function (k) { h += '<div class="row"><span>' + esc(k) + '</span><b>' + (st.bal[k] === null ? 'unavailable' : esc(st.bal[k])) + '</b></div>'; }); } else { h += '<div class="note">Not loaded yet.</div>'; }
            h += btn('send', 'Send coins') + btn('bal', st.busy ? 'Working…' : 'Refresh balances', 1) + btn('reveal', 'Show my 12 words', 1) + btn('remove', 'Remove wallet from this phone', 1);
        } else if (m === 'create') {
