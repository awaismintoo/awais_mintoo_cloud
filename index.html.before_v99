var WINS = [
    { id: 'overview', ic: '🏠', c: '#0a84ff', n: 'Home', sub: 'Best opportunities first, with clear steps' },
    { id: 'bot', ic: '🤖', c: '#34c759', n: 'Auto Bot (paper)', t: 'Auto Bot', sub: 'An autonomous bot that trades virtual money with real prices' },
    { id: 'morning', ic: '🌅', c: '#ff9f0a', n: 'New Day Recommendations', t: 'New Day', sub: 'Solid plans locked at 05:15 PKT, with a 9-day replay' },
    { id: 'plan', ic: '🧭', c: '#5e5ce6', n: 'Master Plan', sub: 'Next-day trend, whole-day and few-hours plans' },
    { id: 'scanner', ic: '🔍', c: '#30b0c7', n: 'Scanner', sub: 'Top Binance Futures coins, scanned in parallel' },
    { id: 'newc', ic: '🆕', c: '#ff375f', n: 'New Coins', sub: 'Newly listed Binance Futures coins' },
    { id: 'candles', ic: '🕯', c: '#bf5af2', n: '3m Candles', sub: 'Strong bullish and bearish 3-minute candles' },
    { id: 'market', ic: '🟡', c: '#f0b90b', n: 'Binance Live', t: 'Market', sub: 'Gainers, losers and volume, live' },
    { id: 'chart', ic: '📈', c: '#34c759', n: 'Chart', sub: 'Real candlesticks for any Futures coin' },
    { id: 'gold', ic: '🥇', c: '#c9971c', n: 'Gold', sub: 'Gold live, plan and dollar strength' },
    { id: 'exness', ic: '🟢', c: '#00a9e0', n: 'Exness Gold', sub: 'Plan, lot sizes and statistics for XAU/USD' },
    { id: 'trade', ic: '💱', c: '#f0b90b', n: 'Trade (Binance)', t: 'Trade', sub: 'Orders with stop and target, using your own API keys' },
    { id: 'wallet', ic: '👛', c: '#0a84ff', n: 'My Wallet', t: 'Wallet', sub: 'Your own keys: receive, balances, 12-word backup' },
    { id: 'calib', ic: '🎯', c: '#34c759', n: 'Match Binance %', t: 'Match', sub: 'Make the % change equal to what Binance shows' },
    { id: 'news', ic: '📰', c: '#ff453a', n: 'News', sub: 'Live crypto, markets and world headlines' },
    { id: 'alerts', ic: '🔔', c: '#ffd60a', n: 'Alerts', sub: 'Push notification settings' },
    { id: 'log', ic: '📜', c: '#8e8e93', n: 'Log', sub: 'What this app recommended on this phone' },
    { id: 'exchanges', ic: '🏛', c: '#a2845e', n: 'Exchanges', sub: 'Which markets are open now' },
    { id: 'health', ic: '🩺', c: '#30d158', n: 'Health', sub: 'Self-checks and automatic repairs' },
    { id: 'help', ic: '📖', c: '#64d2ff', n: 'Help', sub: 'How it works, limits and contact' }
];
function winDef(id) { for (var i = 0; i < WINS.length; i++) { if (WINS[i].id === id) { return WINS[i]; } } return WINS[0]; }
function mktStats() {
    var t = S.tick, keys = Object.keys(t), tot = 0, up = 0;
    keys.forEach(function (s) { tot += t[s].q; if (chgOf(s).v > 0) { up++; } });
    var liq = keys.filter(function (s) { return t[s].q > 20e6; });
    return { n: keys.length, tot: tot, up: up, breadth: keys.length ? Math.round(up / keys.length * 100) : 0,
        gain: liq.slice().sort(function (a, b) { return chgOf(b).v - chgOf(a).v; }).slice(0, 4), los: liq.slice().sort(function (a, b) { return chgOf(a).v - chgOf(b).v; }).slice(0, 4) };
}
function chips(arr) { return '<div class="chips">' + arr.map(function (s) { return '<span class="cc tap" data-act="chart:' + s + '">' + esc(base(s)) + ' ' + chgTxt(s, false) + '</span>'; }).join('') + '</div>'; }

function tierBadge(t) { return t === 'NOW' ? '<span class="badge long">🟢 ENTER NOW</span>' : t === 'PREPARE' ? '<span class="badge warn">🟠 PREPARE</span>' : '<span class="badge wait">⚪ WATCH</span>'; }
function ticket(a) {
    var s = a.side === 'LONG' ? 'LONG (buy)' : 'SHORT (sell)', code = a.sym, L = S.lev;
    return '<div class="why"><b>How to place it</b><ol class="tk"><li>Open Binance → Futures → <b>' + code + '</b>.</li><li>Choose <b>Isolated</b> margin and set leverage to <b>' + L + '×</b> (change it with the bar at the top).</li>' +
        '<li>Place a <b>' + s + '</b> at about <b>' + fmtP(a.entry, a.sym) + '</b>. Market is fine if the price is within 0.1% of that.</li><li>Immediately set <b>Stop-Loss ' + fmtP(a.stopLvl, a.sym) + '</b> and <b>Take-Profit ' + fmtP(a.tgtLvl, a.sym) + '</b>.</li>' +
        '<li>If you are not in by <b>' + hm(a.until) + '</b>, or the price touches ' + fmtP(a.stopLvl, a.sym) + ' first, skip it: the setup is over.</li></ol></div>';
}
function boardCard(a, rank, big) {
    var mvTxt = (a.moved >= 0 ? '+' : '') + a.moved.toFixed(2) + '% since the signal', col = a.tier === 'NOW' ? 'var(--grn)' : a.tier === 'PREPARE' ? 'var(--org)' : 'var(--line)';
    var h = '<div class="group pad" style="border-top:4px solid ' + col + '"><div class="ph tap" data-act="chart:' + a.sym + '"><div class="who"><span class="rank">' + rank + '</span>' + avatar(a.sym) + '<div><b>' + base(a.sym) + '</b><small>USDT Perpetual</small></div></div><div class="side">' + badge(a.side) + tierBadge(a.tier) + '</div></div>';
    h += '<div class="pm"><div><div class="px">' + px(a.sym, a.live) + '</div><small>Signal price ' + fmtP(a.entry, a.sym) + ' • ' + mvTxt + '</small></div>' + sparkOf(a.sym) + '</div>';
    h += '<div class="foot" style="margin-top:8px"><b style="color:var(--tx)">Priority ' + a.score + '/100</b> • ' + a.pct + '% confidence • reward ÷ risk ' + a.rr.toFixed(1) + '</div><div class="bar2"><i style="width:' + a.score + '%;background:' + (a.tier === 'NOW' ? 'var(--grn)' : a.tier === 'PREPARE' ? 'var(--org)' : 'var(--mut)') + '"></i></div>';
    h += lv(a.side, a.entry, a.sl, a.tp, a.sym) + plBox(a.side, a.entry, a.sl, a.tp, a.sym);
    if (a.until > nowMs() && a.tier === 'NOW') { h += '<button class="btn" style="margin-top:10px" data-tr="open" data-sym="' + a.sym + '" data-side="' + a.side + '" data-sl="' + a.stopLvl + '" data-tp="' + a.tgtLvl + '" data-until="' + a.until + '">💱 Trade this on Binance</button>'; }
    h += '<div class="why"><b>Why it ranks here</b>' + a.reasons.map(function (r) { return '<div>✅ ' + esc(r) + '</div>'; }).join('') + a.warns.map(function (w) { return '<div class="org">⚠️ ' + esc(w) + '</div>'; }).join('') + '</div>';
    if (big && a.tier === 'NOW') { h += ticket(a); }
    return h + '<div class="foot">Valid ' + hm(a.at) + ' → ' + hm(a.until) + ' (' + (a.until > nowMs() ? Math.ceil((a.until - nowMs()) / 60000) + ' min left' : 'EXPIRED') + ') • not a guarantee</div></div>';
}
function boardHTML(max) {
    if (!S.scan.at) { return skel(2, 220); }
    var acts = getActions(), now = acts.filter(function (a) { return a.tier === 'NOW'; }), prep = acts.filter(function (a) { return a.tier === 'PREPARE'; }), watch = acts.filter(function (a) { return a.tier === 'WATCH'; }), h = '', n = 0;
    h += '<div class="sh" style="margin-top:6px"><span>🟢 Do now</span><span>' + now.length + '</span></div>';
    if (!now.length) { h += '<div class="group pad"><b>Nothing passes every check right now.</b><div class="note" style="margin:4px 0 0">The best action is to wait. The list refreshes every 30 seconds, and you get an alert when something qualifies.</div></div>'; }
    now.slice(0, 3).forEach(function (a) { n++; h += boardCard(a, '#' + n, true); });
    if (prep.length) { h += '<div class="sh"><span>🟠 Prepare: not ready yet</span><span>' + prep.length + '</span></div>'; prep.slice(0, 3).forEach(function (a) { n++; h += boardCard(a, '#' + n, false); }); }
    if (watch.length && max > 6) { h += '<div class="sh"><span>⚪ Watch</span><span>' + watch.length + '</span></div>'; watch.slice(0, 5).forEach(function (a) { n++; h += boardCard(a, '#' + n, false); }); }
    return h + '<div class="note">Priority 0–100 combines the confidence %, volume, liquidity, agreement with the New Day plan, and how fresh the signal is. Only the Do now group passes every check, and even those can lose.</div>';
}
function vBot() {
    var b = S.bot, s = botStats(), h = '<div class="warn" style="margin-top:0">🧪 Paper trading: virtual money, real prices. No real order is ever placed.</div>';
    h += '<div class="group pad"><div class="ph"><div><div class="sh" style="margin:0 0 4px">Virtual account</div><div class="px">$' + s.eq.toFixed(2) + '</div><div class="chg ' + cc(s.ret) + '">' + pct(s.ret) + ' since the start ($' + b.start + ')</div></div><div style="text-align:right"><div class="note" style="margin:0 0 6px">' + (b.on ? 'Running' : 'Paused') + '</div><span class="sw' + (b.on ? ' on' : '') + '" data-act="bot:toggle"><i></i></span></div></div>' +
        '<div class="lv x2"><div><span>TRADES</span><b>' + s.n + '</b></div><div><span>WIN RATE</span><b>' + (s.n ? s.wr + '%' : '—') + '</b></div><div><span>PROFIT FACTOR</span><b>' + (s.n ? (s.pf >= 99 ? '∞' : s.pf.toFixed(2)) : '—') + '</b></div><div><span>MAX DROP</span><b class="' + (s.dd > 10 ? 'dn' : '') + '">' + s.dd.toFixed(1) + '%</b></div></div>' +
        '<div class="note" style="margin:8px 0 0">' + (s.n < 50 ? 'Only ' + s.n + ' closed trades so far. Judge the bot only after at least 50 trades over several days.' : 'Average result per trade: ' + (s.avgR >= 0 ? '+' : '') + s.avgR.toFixed(2) + ' R (1 R = the money risked on that trade).') + '</div></div>';
    h += sh('Open positions', b.open.length);
    if (!b.open.length) { h += '<div class="group pad mut">No open position. The bot opens one only when a signal reaches ENTER NOW.</div>'; }
    else { h += '<div class="group">' + b.open.map(function (p) { var t = S.tick[p.sym], u = t ? p.notional * (p.sg * (t.p - p.entry) / p.entry) : 0; return '<div class="row tap" data-act="chart:' + p.sym + '">' + who(p.sym, p.side + ' · ' + p.lev + '× · opened ' + hm(p.at)) + '<div style="text-align:right"><b class="' + cc(u) + '">' + usd(u) + '</b><div class="note" style="margin:2px 0 0">stop ' + fmtP(p.sl, p.sym) + ' · target ' + fmtP(p.tp, p.sym) + '</div></div></div>'; }).join('') + '</div>'; }
    h += sh('Closed trades', b.closed.length);
    if (!b.closed.length) { h += '<div class="group pad mut">None yet.</div>'; }
    else { h += '<div class="group">' + b.closed.slice(0, 30).map(function (c) { return '<div class="row">' + who(c.sym, c.side + ' · ' + c.why + ' · ' + hm(c.ct)) + '<b class="' + cc(c.pnl) + '">' + usd(c.pnl) + '</b></div>'; }).join('') + '</div>'; }
    h += '<div class="group pad" style="margin-top:14px"><b>How the bot works</b><div class="note" style="margin:6px 0 0">It starts with $1,000 of virtual money and acts alone while the app is open. It enters only ENTER NOW signals, risks 1% of the account per trade at the stop, holds at most 3 positions, and never uses leverage that would liquidate before its stop (up to 5×). It pays 0.05% fees per side plus 0.03% slippage, exits at the stop, the target or after 3 hours, and pauses if the account falls by half. This is a fair test of the signals with real prices, not a promise of profit.</div></div>';
    return h + '<button class="btn sec" data-act="bot:reset">Reset the virtual account</button>';
}
function vHealth() {
    var now = nowMs(), age = dataAge(), h = '', f = S.feed;
    function row(label, ok, text) { return '<div class="row"><span>' + label + '</span><b class="' + (ok ? 'up' : 'org') + '">' + (ok ? '✅ ' : '⚠️ ') + text + '</b></div>'; }
    var storage = true; try { localStorage.setItem('mintoo_t', '1'); localStorage.removeItem('mintoo_t'); } catch (e) { storage = false; }
    var recent = S.errs.filter(function (e) { return now - e.t < 600000; }).length;
    h += '<div class="group">' + row('Live prices', age < 8000, isFinite(age) ? (f.mode === 'ws' ? 'live stream, ' : 'fast refresh, ') + Math.round(age / 1000) + 's old' : 'not connected') +
        row('Scanner', S.scan.at && now - S.scan.at < 120000, S.scan.at ? Math.round((now - S.scan.at) / 1000) + 's ago, ' + S.scan.n + ' coins' : 'starting') +
        row('Workers', S.threads === 'workers', S.threads === 'workers' ? '5 background workers' : 'main-thread mode') +
        row('News', S.newsAt && now - S.newsAt < 1200000, S.newsAt ? ago(S.newsAt) + ', ' + S.newsSrc.filter(function (x) { return x.ok; }).length + ' sources' : 'not loaded') +
        row('Clock', Math.abs(S.skew) < 3000, Math.abs(S.skew) < 1000 ? 'in sync' : (S.skew / 1000).toFixed(1) + 's off, corrected') +
        row('Storage', storage, storage ? 'working' : 'blocked') + row('Version', !S.update, 'build ' + BUILD + (S.update ? ' (newer available)' : ' (latest)')) +
        row('Errors (10 min)', recent === 0, recent ? recent + ' (last: ' + esc(S.errs[0].m) + ')' : 'none') + '</div>';
    h += '<button class="btn" data-act="repair">🔧 Run repair now</button>';
    h += sh('Automatic repairs', S.heal.length);
    h += S.heal.length ? '<div class="group">' + S.heal.slice(0, 15).map(function (x) { return '<div class="row" style="display:block"><div>' + esc(x.m) + '</div><div class="note" style="margin:3px 0 0">' + new Date(x.t).toLocaleString() + '</div></div>'; }).join('') + '</div>' : '<div class="group pad mut">Nothing needed fixing so far.</div>';
    return h + '<div class="note">The app watches itself every few seconds. It reconnects lost prices, restarts a stuck scanner, refreshes old news, and reloads itself if data stays missing for 5 minutes.</div>';
}
function vOverview() {
    var picks = computePicks().filter(function (p) { return p.aligned; }), top = picks[0], m = mktStats(), h = levBar();
    h += boardHTML(6) + sh('Markets');
    h += '<div class="grid2">' + stile('Gold', GOLD) + stile('Bitcoin', 'BTCUSDT') + stile('Ethereum', 'ETHUSDT') +
        '<div class="group stile"><div class="lb">Market breadth</div><div class="big ' + (m.breadth >= 50 ? 'up' : 'dn') + '">' + (m.n ? m.breadth + '%' : '—') + '</div><div class="note" style="margin:4px 0 0">of ' + m.n + ' coins are up in 24h</div></div></div>';
    var ms = morningSolid().slice(0, 3), nl = S.newc.list.slice(0, 3);
    h += sh('Today') + '<div class="group"><div class="row tap" data-act="win:morning"><div><b>🌅 New day plan</b><div class="note" style="margin:2px 0 0">' + (ms.length ? ms.map(function (o) { return base(o.sym) + ' ' + o.today.day; }).join(' · ') : (S.morning.at ? 'No solid setup today' : 'Building…')) + '</div></div><span class="mut">›</span></div>' +
        '<div class="row tap" data-act="win:newc"><div><b>🆕 New coins</b><div class="note" style="margin:2px 0 0">' + (nl.length ? nl.map(function (n) { return base(n.sym); }).join(' · ') + ' · ' + S.newc.list.length + ' in 30 days' : 'None in the last 30 days') + '</div></div><span class="mut">›</span></div></div>';
    h += sh('Binance Futures (24h)') + '<div class="group"><div class="row"><span>Total volume</span><b>' + (m.n ? money(m.tot) : '—') + '</b></div></div>';
    if (m.n) { h += '<div class="group pad"><div class="sh" style="margin:0 0 8px">Top gainers</div>' + chips(m.gain) + '<div class="sh" style="margin:14px 0 8px">Top losers</div>' + chips(m.los) + '</div>'; }
    h += sh('Scanner') + scanSummary();
    return h;
}

function planCard(r, label, goldCard) {
    var w = windows(r.kind, S.plan.at), sym = r.sym, nd = r.nextDay === 'NEUTRAL' ? 'SIDEWAYS' : r.nextDay === 'LONG' ? 'UP' : 'DOWN', nc = r.nextDay === 'LONG' ? 'up' : r.nextDay === 'SHORT' ? 'dn' : 'mut';
    var counter = (r.fh === 'LONG' || r.fh === 'SHORT') && (r.day === 'LONG' || r.day === 'SHORT') && r.fh !== r.day;
    return '<div class="group pad"><div class="ph">' + who(sym, goldCard ? 'Binance ' + sym + ' proxy' : null) + '<div class="px" style="font-size:20px">' + px(sym, r.price) + '</div></div>' + tfWarn(sym) +
        (r.note ? '<div class="warn">⚠️ ' + esc(r.note) + '</div>' : '') +
        '<div class="blk"><div class="t"><span>Next-day trend</span><span class="' + nc + '">' + nd + ' <small>' + (r.nextPct ? r.nextPct + '% confidence' : '') + '</small></span></div></div>' +
        '<div class="blk"><div class="t"><span>Whole day</span>' + badge(r.day === 'NEUTRAL' ? 'WAIT' : r.day) + '</div><div class="tm">' + fmtT(w.dayStart) + ' → ' + fmtT(w.dayEnd) + (r.dayPct ? ' • ' + meter(r.dayPct) : '') + '</div>' + lv(r.day, r.price, r.daySL, r.dayTP, sym) + plBox(r.day, r.price, r.daySL, r.dayTP, sym) + '</div>' +
        '<div class="blk"><div class="t"><span>Few hours</span>' + badge(r.fh) + '</div><div class="tm">' + fmtT(w.fhStart) + ' → ' + fmtT(w.fhStop) + (r.fhPct ? ' • ' + meter(r.fhPct) : '') + (counter ? ' • <span class="org">against whole-day trend: small size</span>' : '') + '</div>' + lv(r.fh, r.price, r.fhSL, r.fhTP, sym) + plBox(r.fh, r.price, r.fhSL, r.fhTP, sym) + '</div>' +
        '<div class="foot">' + bothChg(sym) + ' • volume vs 30-day avg ×' + r.vr.toFixed(2) + ' • RSI 1h ' + r.rsiH.toFixed(0) + ' / 1d ' + r.rsiD.toFixed(0) + '</div></div>';
}
function vPlan() {
    var items = S.plan.items, h = levBar();
    if (!items.length) { return h + skel(3, 200); }
    if (nowMs() - S.plan.at > 240000) { h += '<div class="warn">This plan is ' + Math.round((nowMs() - S.plan.at) / 60000) + ' minutes old because the data refresh is delayed.</div>'; }
    h += '<div class="note" style="margin-top:0">Plan calculated ' + hms(S.plan.at) + '. The price on each card is live; entry, stop and target are fixed at plan time. The plan refreshes every minute.</div>';
    var gold = items.filter(function (r) { return r.kind === 'gold'; })[0];
    h += sh('🥇 Exness gold (XAU/USD)');
    if (goldClosed(new Date(nowMs()))) { h += '<div class="warn">Exness gold is closed (weekend). The plan starts when it reopens: ' + fmtT(nextGoldOpen(nowMs())) + '.</div>'; }
    h += gold ? planCard(gold, 'Gold', true) : '<div class="group pad mut">Gold data unavailable right now.</div>';
    h += sh('🟡 Binance Futures');
    items.filter(function (r) { return r.kind !== 'gold'; }).forEach(function (r) { h += planCard(r); });
    return h + '<div class="note">Rule-based estimate from live Binance data (trend, RSI, volume). Not a guarantee and not financial advice.</div>';
}
function vScanner() {
    var all = computePicks(), picks = all.filter(function (p) { return p.aligned; });
    if (S.scanf === 'long') { picks = picks.filter(function (p) { return p.side === 'LONG'; }); } else if (S.scanf === 'short') { picks = picks.filter(function (p) { return p.side === 'SHORT'; }); }
    var h = levBar() + scanSummary() + '<div style="height:14px"></div><div class="segc">';
    [['all', 'All'], ['long', 'Long'], ['short', 'Short']].forEach(function (f) { h += '<span class="' + (S.scanf === f[0] ? 'on' : '') + '" data-act="scanf:' + f[0] + '">' + f[1] + '</span>'; });
    h += '</div>' + sh('Recommendations (10m + 15m agree)', picks.length);
    if (!S.scan.at) { h += skel(3, 200); }
    else if (!picks.length) { h += '<div class="group pad mut">Nothing matches right now.</div>'; }
    else { h += picks.slice(0, 30).map(pickCard).join(''); }
    return h + '<div class="note">' + (all.length - all.filter(function (p) { return p.aligned; }).length) + ' scanned coins have mixed signals and are skipped. Confidence % is the share of indicator checks (trend, momentum, RSI, volume, Supertrend) that agree with the signal. It is not a probability of profit. Stop is 1.5×ATR and the target is twice the stop distance. Valid for about 45 minutes. Tap a coin to open its chart.</div>';
}
function vCandles() {
    if (!S.scan.at) { return skel(4, 70); }
    if (!S.candles.length) { return '<div class="group pad mut">No strong candle yet. They show up here as they close.</div>'; }
    return sh('Body ≥ 1.2×ATR and volume ≥ 2×', S.candles.length) + '<div class="group">' + S.candles.map(function (c) {
        return '<div class="row tap" data-act="chart:' + c.sym + '">' + who(c.sym, hm(c.t) + ' candle • volume ×' + c.vr.toFixed(1)) + '<div style="text-align:right"><span class="badge ' + (c.bull ? 'long' : 'short') + '">' + (c.bull ? '▲ BULLISH' : '▼ BEARISH') + '</span><div class="mid" style="font-weight:800;margin-top:3px">' + fmtP(c.price, c.sym) + '</div></div></div>';
    }).join('') + '</div>';
}
function vMarket() {
    var t = S.tick, keys = Object.keys(t), list;
    if (S.mkt === 'vol') { list = keys.slice().sort(function (a, b) { return t[b].q - t[a].q; }); }
    else { list = keys.filter(function (s) { return t[s].q > 20e6; }).sort(function (a, b) { return S.mkt === 'gain' ? chgOf(b).v - chgOf(a).v : chgOf(a).v - chgOf(b).v; }); }
    var h = '<div class="segc">';
    [['gain', 'Gainers'], ['loss', 'Losers'], ['vol', 'Volume']].forEach(function (f) { h += '<span class="' + (S.mkt === f[0] ? 'on' : '') + '" data-act="mkt:' + f[0] + '">' + f[1] + '</span>'; });
    h += '</div>';
    if (!keys.length) { return h + skel(5, 64); }
    h += '<div class="group">' + list.slice(0, 40).map(function (s) {
        return '<div class="row tap" data-act="chart:' + s + '">' + who(s, 'Vol ' + money(t[s].q) + (chgOf(s).kind === 'today' ? ' • 24h ' + pct(chgOf(s).roll) : '')) + '<div style="display:flex;align-items:center;gap:10px">' + sparkOf(s) + '<div style="text-align:right"><div style="font-weight:800">' + px(s) + '</div>' + chgChip(s) + '</div></div></div>';
    }).join('') + '</div>';
    return h + '<div class="note">The big percentage is the change since the day opened at 05:00 PKT, the same figure Binance shows on its Futures screen. The rolling last-24-hours change is shown under each name. Gainers and losers only include coins with more than $20M 24h volume, to hide illiquid noise.</div>';
}
function vGold() {
    var t = S.tick[GOLD], h = levBar();
    if (!t) { h += skel(1, 150); }
    else { h += '<div class="group pad"><div class="ph">' + who(GOLD, 'Binance ' + GOLD + ' (Exness proxy)') + chgChip(GOLD) + '</div><div class="pm"><div class="px">' + px(GOLD) + '</div>' + sparkOf(GOLD) + '</div></div><div class="group"><div class="row"><span>24h high / low</span><b>' + fmtP(t.h, GOLD) + ' / ' + fmtP(t.l, GOLD) + '</b></div><div class="row"><span>24h volume</span><b>' + money(t.q) + '</b></div></div>'; }
    if (goldClosed(new Date(nowMs()))) { h += '<div class="warn">Exness gold is closed (weekend). Plan starts at ' + fmtT(nextGoldOpen(nowMs())) + '.</div>'; }
    var gold = S.plan.items.filter(function (r) { return r.kind === 'gold'; })[0];
    h += gold ? planCard(gold, 'Gold', true) : skel(1, 160);
    var fx = S.fx, usdP = fx.eur != null && fx.gbp != null ? -(0.829 * fx.eur + 0.171 * fx.gbp) : null;
    h += sh('Dollar strength (proxy)') + '<div class="group">' + (usdP == null ? '<div class="row mut">Loading real EUR and GBP data…</div>' :
        '<div class="row"><span>US dollar vs EUR & GBP, 24h</span><b class="' + cc(usdP) + '">' + (usdP >= 0 ? '▲ stronger ' : '▼ weaker ') + pct(usdP) + '</b></div><div class="row"><span>EUR/USDT</span><b class="' + cc(fx.eur) + '">' + pct(fx.eur) + '</b></div><div class="row"><span>GBP/USDT</span><b class="' + cc(fx.gbp) + '">' + pct(fx.gbp) + '</b></div>') + '</div>' +
        '<div class="note">This is a proxy built from real Binance EUR and GBP prices, weighted like the official index. It is not the official US Dollar Index (DXY), which has no free live feed. Gold usually moves opposite to the dollar.</div>';
    var m = mktStats();
    return h + sh('Context') + '<div class="group"><div class="row"><span>BTC ' + (chgOf('BTCUSDT').kind === 'today' ? 'today' : '24h') + '</span><b class="' + cc(chgOf('BTCUSDT').v) + '">' + (S.tick.BTCUSDT ? pct(chgOf('BTCUSDT').v) : '—') + '</b></div><div class="row"><span>Crypto coins up</span><b>' + m.breadth + '%</b></div></div>' +
        '<div class="note">Exness publishes no free price feed, so gold uses Binance gold futures as a close proxy and can differ slightly from your Exness chart.</div>';
}
function vNews() {
    var h = '', now = nowMs();
    if (!S.news.length) { return (S.newsTried ? '<div class="group pad"><b>No headlines could be loaded</b><div class="note" style="margin:4px 0 8px">The free news relays may be busy or you may be offline. It retries every 2 minutes.</div></div>' : skel(4, 80)) + '<button class="btn sec" data-act="newsrefresh">Try again now</button>'; }
    var newest = S.news[0].t, old = newest && now - newest > 90 * 60000, ok = S.newsSrc.filter(function (x) { return x.ok; }).length;
    h += '<div class="group"><div class="row"><span>Newest headline</span><b class="' + (old ? 'org' : 'up') + '">' + (newest ? ago(newest) : 'unknown') + '</b></div><div class="row"><span>Checked</span><b>' + ago(S.newsAt) + ' • ' + ok + ' of ' + S.newsSrc.length + ' sources</b></div></div>';
    if (old) { h += '<div class="warn">The newest headline is over 90 minutes old. The sources may be delayed, or it is a quiet news period.</div>'; }
    h += '<button class="btn sec" data-act="newsrefresh">⟳ Refresh news now</button>';
    [['mkt', '🪙 Crypto'], ['macro', '🥇 Gold & markets'], ['geo', '🌍 World']].forEach(function (g) {
        var items = S.news.filter(function (n) { return n.g === g[0]; }).slice(0, 10);
        h += sh(g[1]) + '<div class="group nws">';
        if (!items.length) { h += '<div class="row mut">No headlines from these sources right now.</div>'; }
        items.forEach(function (n) {
            var okl = /^https?:\/\//.test(n.link);
            h += '<div class="row" style="display:block"><div>' + (okl ? '<a href="' + esc(n.link) + '" target="_blank" rel="noopener noreferrer">' + esc(n.title) + '</a>' : esc(n.title)) + '</div><div class="note" style="margin:4px 0 0">' + esc(n.src) + (n.t ? ' • ' + ago(n.t) : '') + '</div></div>';
        });
        h += '</div>';
    });
    return h + '<div class="note">Headlines are fetched live from CoinDesk, Cointelegraph, BBC and Google News through public relays, and refresh every 2 minutes. Sources: ' + S.newsSrc.map(function (x) { return esc(x.n) + (x.ok ? ' ✓' : ' ✗'); }).join(', ') + '.</div>';
}
function sw(on, act, label, sub) { return '<div class="row tap" data-act="' + act + '"><div><b>' + label + '</b>' + (sub ? '<div class="note" style="margin:2px 0 0">' + sub + '</div>' : '') + '</div><span class="sw' + (on ? ' on' : '') + '"><i></i></span></div>'; }
function vAlerts() {
    var perm = window.MintooNative ? 'granted' : ('Notification' in window ? Notification.permission : 'not supported'), eff = S.sysPush && perm === 'granted';
    return '<div class="group"><div class="row"><span>Phone permission</span><b class="' + (perm === 'granted' ? 'up' : 'org') + '">' + perm + '</b></div></div>' +
        (perm === 'granted' ? '' : '<div class="warn">Notifications are not allowed yet. Switch on "Push notifications" below' + (perm === 'denied' ? ', or enable them for this app in your phone settings (currently blocked)' : '') + '.</div>') +
        '<div class="group">' + sw(eff, 'set:sys', 'Push notifications', 'Master switch') + sw(S.goldPush, 'set:gold', '🥇 Gold alerts') + sw(S.cryptoPush, 'set:crypto', '₿ Crypto alerts') +
        sw(S.a3m, 'set:a3m', '🕯 Strong 3m candles') + sw(S.aMaster, 'set:amaster', '🧭 Master picks and new-day plan', '10m + 15m agree, HIGH strength') + '</div>' +
        '<button class="btn" data-act="set:test">⚡ Send test notification</button>' +
        '<div class="note">Alerts are limited to avoid spam: at most 5 candle alerts and 3 master-pick alerts per scan, and one per coin every 15–30 minutes. They arrive while the app is open or running in the background. This app has no server, so alerts cannot arrive after the app is fully closed.</div>';
}
function vLog() {
    var h = '<button class="btn sec" data-act="clearlog">🗑 Clear log (' + S.log.length + ')</button>';
    if (!S.log.length) { return h + '<div class="group pad mut">Nothing yet. Master picks and candle alerts are recorded here as they happen.</div>'; }
    h += '<div class="group">' + S.log.slice(0, 80).map(function (e) { return '<div class="row" style="display:block"><div><span class="badge wait">' + esc(e.type) + '</span> ' + esc(e.text) + '</div><div class="note" style="margin:4px 0 0">' + new Date(e.t).toLocaleString() + '</div></div>'; }).join('') + '</div>';
    return h + '<div class="note">This is a record of what the bot recommended, not of trades. The app places no trades and does not track profit or loss.</div>';
}
function vExchanges() {
    var h = '<div class="group">', now = nowMs();
    EXCH.forEach(function (x) {
        var z = zoned(x[1]);
        if (!z) { h += '<div class="row"><span>' + x[0] + '</span><span class="mut">n/a</span></div>'; return; }
        var open = z.wd !== 'Sat' && z.wd !== 'Sun' && x[2].some(function (r) { return z.m >= r[0] && z.m < r[1]; });
        h += '<div class="row"><div><b>' + x[0] + '</b><div class="note" style="margin:2px 0 0">local time ' + z.label + '</div></div><span class="badge ' + (open ? 'long' : 'warn') + '">' + (open ? 'OPEN' : 'CLOSED') + '</span></div>';
    });
    var fx = !goldClosed(new Date(now));
    h += '<div class="row"><div><b>💱 Forex & Exness gold</b><div class="note" style="margin:2px 0 0">24 hours, Monday to Friday</div></div><span class="badge ' + (fx ? 'long' : 'warn') + '">' + (fx ? 'OPEN' : 'CLOSED') + '</span></div>';
    h += '<div class="row"><div><b>🟡 Binance Futures</b><div class="note" style="margin:2px 0 0">24/7</div></div><span class="badge long">OPEN</span></div></div>';
    return h + '<div class="note">Based on regular trading hours. Public holidays and early closes are not included.</div>';
}
function vHelp() {
    var T = [['Priority list (Home)', 'Every signal is ranked from best to worst with a priority score from 0 to 100. Only the green Do now group passes every check. Each one lists why it ranks there, any cautions, and a 5-step order ticket for Binance. If nothing qualifies, the app tells you to wait.'],
        ['Auto Bot (paper)', 'An autonomous bot that trades virtual money using the Do now signals and real prices, with fees and slippage. It is the honest way to test the signals: judge it only after at least 50 closed trades over several days. It never places a real order.'],
        ['Back button and Health', 'The arrow at the top left (and your phone Back button) returns to the previous screen. The Health window shows the app checking itself and the repairs it made on its own.'],
        ['New Day Recommendations', 'At 05:15 PKT (15 minutes after the 05:00 PKT day open) the app locks a whole-day plan and a few-hours plan for gold and the 10 most active coins, using only data available at that moment. It then tracks each plan (target hit, stop hit, or still running) and replays the same rules on the last 9 days so you can see how they really performed.'],
        ['New Coins', 'Coins listed on Binance Futures in the last 30 days: first-trade price, change since listing, highest price, volume, volatility and a signal. New coins move fast in both directions, so a long or a short can win or lose quickly. You also get an alert when a coin is newly listed.'],
        ['Why percentages can differ', 'Binance Futures shows the change since its day opened at 00:00 UTC, which is 05:00 PKT. The rolling change over the last 24 hours is a different number, and for fast-moving coins the two can be far apart. This app shows the Binance one as the main figure and the rolling 24h beside it, so you can match either.'],
        ['Confidence %', 'The percentage on each signal is the share of indicator checks that agree with it: trend, momentum, RSI, volume, and the Supertrend (10, 3) like the one on your Binance chart. 100% means every check agrees. It is not a probability of making profit, so also look at the 9-day track record. A signal is never shown against its own Supertrend.'],
        ['Profit boxes and leverage', 'Every entry shows the profit at the target and the loss at the stop for $50 and $100, at the leverage chosen at the top of the screen (1× to 50×), after about 0.1% fees. A second box shows the leverage you would need to make $20 on $50 and $50 on $100 at that target, and the loss at the stop. Leverage multiplies profit and loss equally, and a position is liquidated after about 100 ÷ leverage percent against you, which can happen before your stop.'],
        ['Master Plan', 'For gold and the most active coins: next-day trend, a whole-day plan and a few-hours plan, each with start time, stop time, entry, stop and target.'],
        ['Scanner', 'Every 30 seconds the app scans the top 100 Binance Futures coins on 10m and 15m candles using 25 parallel requests (5 background workers × 5). A coin is recommended only when both timeframes agree.'],
        ['3m Candles', 'Strong bullish or bearish 3-minute candles that are large compared with recent volatility and backed by high volume.'],
        ['Real data only', 'Prices come live from Binance Futures. Headlines come from public news feeds. If something is unavailable the app says so instead of showing made-up numbers. If the live feed pauses, the screen fades and a banner tells you.'],
        ['Limits', 'Recommendations only: this app cannot place trades on any account. Signals are rule-based (trend, RSI, volume) and are not guaranteed or financial advice. Gold uses Binance XAUUSDT as a proxy for Exness.']];
    return '<div class="group">' + T.map(function (x) { return '<div class="topic"><b>' + x[0] + '</b><span>' + x[1] + '</span></div>'; }).join('') + '</div>' + sh('Contact & support') +
        '<div class="group"><div class="row"><span>Name</span><b>Muhammad Awais</b></div><div class="row"><span>Email</span><a href="mailto:awaisrajpoot2@yahoo.com"><b>awaisrajpoot2@yahoo.com</b></a></div><div class="row" style="display:block"><span class="mut">Address</span><div>Broadway Street, Greens Avenue, Park Road, Islamabad, Pakistan</div></div></div>';
}
function vChart() {
    var t = S.tick, keys = Object.keys(t).sort(function (a, b) { return t[b].q - t[a].q; }).slice(0, 120);
    if (keys.indexOf(S.chart.sym) < 0) { keys.unshift(S.chart.sym); }
    var h = '<select id="chartSel">' + keys.map(function (s) { return '<option value="' + s + '"' + (s === S.chart.sym ? ' selected' : '') + '>' + nm(s) + '</option>'; }).join('') + '</select><div class="segc">';
    ['1m', '3m', '5m', '15m', '1h', '4h', '1d'].forEach(function (tf) { h += '<span class="' + (S.chart.tf === tf ? 'on' : '') + '" data-act="tf:' + tf + '">' + tf + '</span>'; });
    return h + '</div><div class="group pad"><div class="note" id="chartInfo" style="margin:0 0 8px"></div><canvas id="cv"></canvas><div class="note" id="chartNote" style="margin-bottom:0"></div></div>';
}

// ---------- New Day Recommendations ----------
function recStats(items, key) {
    var w = 0, l = 0, t = 0, net = 0, n = 0;
    items.forEach(function (o) { (o.hist || []).forEach(function (p) { var r = p[key]; if (!r) { return; } n++; if (r.res === 'WIN') { w++; } else if (r.res === 'LOSS') { l++; } else { t++; } net += r.pnl - feeOf(o.sym) * 100; }); });
    return { n: n, w: w, l: l, t: t, wr: (w + l) ? Math.round(w / (w + l) * 100) : 0, avg: n ? net / n : 0 };
}
function coinStats(o, key) { var w = 0, l = 0, t = 0; (o.hist || []).forEach(function (p) { var r = p[key]; if (!r) { return; } if (r.res === 'WIN') { w++; } else if (r.res === 'LOSS') { l++; } else { t++; } }); return w + ' target · ' + l + ' stop · ' + t + ' timeout'; }
function resBox(r, side, entry, sym) {
    if (!r) { return ''; }
    if (r.res === 'WIN') { return '<div class="res win">✅ Target hit at ' + pk(r.at) + ' PKT · ' + netUsd(r.pnl, sym, 100) + ' on $100 · ' + netUsd(r.pnl, sym, 50) + ' on $50' + (S.lev > 1 ? ' (at ' + S.lev + '×)' : '') + '</div>'; }
    if (r.res === 'LOSS') { return '<div class="res loss">❌ Stop hit at ' + pk(r.at) + ' PKT · ' + netUsd(r.pnl, sym, 100) + ' on $100 · ' + netUsd(r.pnl, sym, 50) + ' on $50</div>'; }
    var tk = S.tick[sym], pnl = r.pnl; if (r.res === 'OPEN' && tk) { pnl = (side === 'LONG' ? 1 : -1) * (tk.p - entry) / entry * 100; }
    return '<div class="res ' + (r.res === 'OPEN' ? 'run' : 'end') + '">' + (r.res === 'OPEN' ? '⏳ Running now: ' : '⌛ Window ended: ') + netUsd(pnl, sym, 100) + ' on $100 · ' + netUsd(pnl, sym, 50) + ' on $50 <small>(if closed now, after fees)</small></div>';
}
function morningCard(o) {
    var p = o.today, sym = o.sym, dEnd = p.D + 86400000, fEnd = p.T + 4 * 3600000, now = nowMs();
    function blk(title, side, pctv, from, to, sl, tp, res) {
        var pr = Math.max(0, Math.min(1, (now - from) / (to - from)));
        return '<div class="blk"><div class="t"><span>' + title + '</span>' + badge(side) + '</div><div class="tm">' + pkd(from) + ' → ' + pkd(to) + ' PKT' + (pctv ? ' • ' + meter(pctv) : '') + '</div>' +
            (side === 'WAIT' ? '' : '<div class="prog"><i style="width:' + Math.round(pr * 100) + '%"></i></div>') + lv(side, p.entry, sl, tp, sym) + plBox(side, p.entry, sl, tp, sym) + resBox(res, side, p.entry, sym) + '</div>';
    }
    return '<div class="group pad"><div class="ph">' + who(sym) + '<div class="side"><span class="badge ' + (isSolid(o) ? 'solid' : 'wait') + '">' + (isSolid(o) ? '✓ SOLID' : 'WATCH') + '</span><div class="px" style="font-size:18px">' + px(sym, p.entry) + '</div></div></div>' +
        tfWarn(sym) + (p.note ? '<div class="warn">⚠️ ' + esc(p.note) + '</div>' : '') + stChip(sym, p.day !== 'WAIT' ? p.day : p.fh) +
        blk('Whole day', p.day, p.dayPct, p.T, dEnd, p.dSL, p.dTP, p.dayRes) + blk('Few hours', p.fh, p.fhPct, p.T, fEnd, p.fSL, p.fTP, p.fhRes) +
        '<div class="foot">Entry = price at 05:15 PKT. Stop and target are fixed fractions of the coin\'s recent average range. Previous day ' + pct(p.chgPrev) + ' • RSI 1d ' + p.rsiD.toFixed(0) + ' / 1h ' + p.rsiH.toFixed(0) + '</div>' +
        '<div class="foot">Last 9 days, same rules: whole day ' + coinStats(o, 'dayRes') + ' • few hours ' + coinStats(o, 'fhRes') + '</div></div>';
}
function vMorning() {
    var now = nowMs(), D0 = dayOpenFor(now), nextT = D0 + 900000 + 86400000, left = Math.max(0, nextT - now), h = levBar();
    h += '<div class="group pad"><div class="sh" style="margin:0 0 6px">Plan for the day starting</div><div style="font-size:21px;font-weight:800">' + pkd(D0) + ' PKT</div><div class="note" style="margin:8px 0 0">The trading day opens at 05:00 PKT (00:00 UTC, when Binance\'s daily candle starts). The plan is locked at 05:15 PKT, after the first 15 minutes, using only data available at that moment. Next plan: ' + pkd(nextT) + ' PKT, in ' + Math.floor(left / 3600000) + 'h ' + Math.floor(left % 3600000 / 60000) + 'm.</div></div>';
    var items = S.morning.D === D0 ? S.morning.items : [];
    if (!items.length) { return h + skel(3, 200) + '<div class="note">Building the plan from real candles… this takes a few seconds.</div>'; }
    var d = recStats(items, 'dayRes'), f = recStats(items, 'fhRes');
    function line2(s, label) { return '<div class="note" style="margin:6px 0 0">' + label + ': ' + s.n + ' plans took a trade, ' + s.w + ' target · ' + s.l + ' stop · ' + s.t + ' timeout, average <b class="' + (s.avg >= 0 ? 'up' : 'dn') + '">' + (s.avg >= 0 ? '+' : '') + s.avg.toFixed(2) + '%</b> per plan = ' + usd(s.avg) + ' per $100 after fees</div>'; }
    function trk(t, s, inv) { return '<div class="pad" style="border-top:1px solid var(--line)"><b>' + t + '</b><div class="lv x2"><div><span>TARGET</span><b class="up">' + s.w + '</b></div><div><span>STOP</span><b class="dn">' + s.l + '</b></div><div><span>TIMEOUT</span><b>' + s.t + '</b></div><div><span>WIN RATE</span><b>' + s.wr + '%</b></div></div>' + line2(s, 'As signalled') + line2(inv, 'Opposite side every time') + '</div>'; }
    var di = recStats(items, 'dayInv'), fi = recStats(items, 'fhInv');
    h += sh('Track record: last 9 days replayed') + '<div class="group">' + trk('Whole-day plans', d, di) + trk('Few-hours plans', f, fi) + '</div><div class="note">Doing the opposite of every signal is not a fix. With the same stop, target and fees, a signal with no real edge loses on both sides. Only a result that holds over many days would justify it, and 9 days is too short to trust. A replay of the same rules on real past candles, not live trading. Past results do not guarantee future results. If the stop and target were both touched in one 15-minute candle, the stop is counted first.</div>';
    var ok = items.filter(function (o) { return o.today; }), solid = ok.filter(isSolid).sort(function (a, b) { return b.today.dayPct - a.today.dayPct; }), rest = ok.filter(function (o) { return !isSolid(o); });
    if (S.morning.goldClosed) { h += '<div class="warn">Exness gold has no plan today because the market is closed (weekend).</div>'; }
    h += sh('✅ Solid setups', solid.length) + (solid.length ? solid.map(morningCard).join('') : '<div class="group pad mut">No coin has a solid setup today (whole day and few hours must agree). Waiting is also a position.</div>');
    if (rest.length) { h += sh('👀 Watch list', rest.length) + rest.map(morningCard).join(''); }
    return h + '<div class="note">Confidence % is the share of indicator checks (daily and hourly trend, RSI, volume, opening candle, 15m and hourly Supertrend) that agree with the plan. It is not a probability of profit: judge it together with the 9-day track record above. Profit and loss are for $50 and $100 at the leverage you pick, after about 0.1% Binance trading fees on the full position (gold: no fee, spread not included). Leverage multiplies profit and loss by the same amount, and a position is liquidated after roughly 100 ÷ leverage percent against you. The track record above is at 1×. Not financial advice.</div>';
}

// ---------- New Coins ----------
function newcCard(n) {
    var r = S.newc.res[n.sym], tk = S.tick[n.sym], age = nowMs() - n.onboard;
    var ageT = age < 86400000 ? Math.floor(age / 3600000) + 'h' : Math.floor(age / 86400000) + 'd ' + Math.floor(age % 86400000 / 3600000) + 'h';
    var h = '<div class="group pad"><div class="ph tap" data-act="chart:' + n.sym + '">' + who(n.sym, 'Listed ' + new Date(n.onboard).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })) + '<div class="side"><span class="badge new">NEW · ' + ageT + '</span>' + (tk ? '<div style="font-weight:800">' + px(n.sym) + '</div>' : '') + '</div></div>';
    if (!r) { return h + '<div class="sk" style="height:90px;margin-top:12px"></div></div>'; }
    var price = tk ? tk.p : r.last, since = r.p0 ? (price - r.p0) / r.p0 * 100 : 0, fromHi = r.hi ? (price - r.hi) / r.hi * 100 : 0, riseHi = r.p0 ? (r.hi - r.p0) / r.p0 * 100 : 0, atrp = price ? r.atr15 / price * 100 : 0;
    h += '<div class="lv" style="margin-top:12px"><div><span>SINCE 1ST TRADE</span><b class="' + cc(since) + '">' + pct(since) + '</b></div><div><span>HIGHEST</span><b>' + pct(riseHi) + '</b></div><div><span>NOW VS HIGH</span><b class="' + cc(fromHi) + '">' + pct(fromHi) + '</b></div></div>' +
        '<div class="foot">First trade ' + fmtP(r.p0, n.sym) + ' • highest ' + fmtP(r.hi, n.sym) + ' • 24h volume ' + (tk ? money(tk.q) : '—') + ' • typical 15m swing ' + atrp.toFixed(2) + '%</div>';
    var flags = []; if (atrp > 2) { flags.push('EXTREME VOLATILITY'); } if (fromHi < -30) { flags.push('FADING FROM HIGH'); } else if (fromHi > -5) { flags.push('NEAR HIGH'); } if (tk && tk.q < 5e6) { flags.push('LOW VOLUME'); }
    if (flags.length) { h += '<div class="warn">⚠️ ' + flags.join(' · ') + '</div>'; }
    var rec = newcRec(r);
    if (rec.side === 'NONE') { h += '<div class="nt">' + esc(rec.why) + '</div>'; }
    else { h += '<div class="blk"><div class="t"><span>Signal</span>' + badge(rec.side) + '</div><div class="tm">' + (rec.pct ? meter(rec.pct) : '') + (rec.why ? ' • ' + esc(rec.why) : '') + '</div>' + lv(rec.side, rec.price, rec.sl, rec.tp, n.sym) + plBox(rec.side, rec.price, rec.sl, rec.tp, n.sym) + '</div>'; }
    return h + '</div>';
}
function vNewc() {
    var h = levBar() + '<div class="warn">New listings move fast in both directions. A long or a short can win, and both can lose quickly. Nothing here is guaranteed, so keep size small.</div>', list = S.newc.list;
    if (!list.length) { return h + (S.newc.listAt ? '<div class="group pad mut">No Binance Futures coin was listed in the last 30 days.</div>' : skel(2, 200)); }
    return h + list.map(newcCard).join('') + '<div class="note">Listing dates come from Binance. Prices and candles are real. You also get an alert when a brand-new Futures coin appears (while the app is open or in the background).</div>';
}

// ---------- chart ----------
function cv(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim() || '#888'; }
function closeChartWS() { var c = S.chart; if (c.ws) { try { c.ws.onmessage = null; c.ws.close(); } catch (e) {} c.ws = null; } }
function openChartWS() {
    var c = S.chart, sym = c.sym, tf = c.tf; closeChartWS();
    try {
        var ws = new WebSocket('wss://fstream.binance.com/ws/' + sym.toLowerCase() + '@kline_' + tf);
        ws.onmessage = function (ev) {
            var m; try { m = JSON.parse(ev.data); } catch (e) { return; }
            if (!m || !m.k || sym !== c.sym || tf !== c.tf) { return; }
            var k = m.k, cd = { t: +k.t, o: +k.o, h: +k.h, l: +k.l, c: +k.c, v: +k.v }, last = c.k[c.k.length - 1];
            if (last && last.t === cd.t) { c.k[c.k.length - 1] = cd; } else if (!last || cd.t > last.t) { c.k.push(cd); if (c.k.length > 300) { c.k.shift(); } }
            if (S.win === 'chart') { drawChart(); }
        };
        c.ws = ws;
    } catch (e) {}
}
function loadChart() {
    var c = S.chart, sym = c.sym, tf = c.tf; c.err = ''; c.k = []; closeChartWS();
    fetchJSON('/fapi/v1/klines?symbol=' + sym + '&interval=' + tf + '&limit=120').then(function (rows) {
        if (sym !== c.sym || tf !== c.tf) { return; }
        c.k = rows.map(function (r) { return { t: +r[0], o: +r[1], h: +r[2], l: +r[3], c: +r[4], v: +r[5] }; });
        drawChart(); openChartWS();
    }).catch(function (e) { c.err = 'Could not load candles (' + e.message + ')'; drawChart(); });
}
function drawChart() {
    var cvs = $('cv'); if (!cvs) { return; }
    var dpr = window.devicePixelRatio || 1, w = cvs.clientWidth, h = cvs.clientHeight; if (!w || !h) { return; }
    cvs.width = w * dpr; cvs.height = h * dpr;
    var g = cvs.getContext('2d'); g.scale(dpr, dpr); g.clearRect(0, 0, w, h);
    var k = S.chart.k, note = $('chartNote'), info = $('chartInfo'), GR = cv('--grn'), RD = cv('--red'), LN = cv('--line'), MT = cv('--mut');
    g.font = '11px -apple-system,Segoe UI,sans-serif';
    if (!k.length) { g.fillStyle = MT; g.fillText(S.chart.err || 'Loading candles…', 12, 24); if (note) { note.textContent = S.chart.err; } return; }
    var n = Math.min(k.length, Math.floor((w - 62) / 7)), v = k.slice(-n), padR = 58, padT = 8, volH = 46, ph = h - padT - volH - 6, hi = -Infinity, lo = Infinity, vmax = 0, i;
    v.forEach(function (x) { if (x.h > hi) { hi = x.h; } if (x.l < lo) { lo = x.l; } if (x.v > vmax) { vmax = x.v; } });
    var span = (hi - lo) || 1, y = function (p) { return padT + (hi - p) / span * ph; }, cw = (w - padR - 4) / n;
    g.lineWidth = 1;
    for (i = 0; i <= 4; i++) { var gy = padT + ph * i / 4, gp = hi - span * i / 4; g.strokeStyle = LN; g.beginPath(); g.moveTo(0, gy); g.lineTo(w - padR, gy); g.stroke(); g.fillStyle = MT; g.fillText(fmtP(gp, S.chart.sym), w - padR + 4, gy + 4); }
    v.forEach(function (x, j) {
        var up = x.c >= x.o, col = up ? GR : RD, cx = 2 + j * cw + cw / 2, bw = Math.max(1, cw * 0.7);
        g.strokeStyle = col; g.fillStyle = col; g.beginPath(); g.moveTo(cx, y(x.h)); g.lineTo(cx, y(x.l)); g.stroke();
        var y1 = y(Math.max(x.o, x.c)), y2 = y(Math.min(x.o, x.c)); g.fillRect(cx - bw / 2, y1, bw, Math.max(1, y2 - y1));
        g.globalAlpha = 0.4; var vh = vmax ? x.v / vmax * volH : 0; g.fillRect(cx - bw / 2, h - vh - 2, bw, vh); g.globalAlpha = 1;
    });
    var cl = k.map(function (x) { return x.c; }), kk = 2 / 22, e = cl[0], es = [e];
    for (i = 1; i < cl.length; i++) { e = cl[i] * kk + e * (1 - kk); es.push(e); }
    g.strokeStyle = '#ff9f0a'; g.lineWidth = 1.5; g.beginPath();
    es.slice(-n).forEach(function (val, j) { var cx = 2 + j * cw + cw / 2; if (j === 0) { g.moveTo(cx, y(val)); } else { g.lineTo(cx, y(val)); } }); g.stroke();
    var lastC = k[k.length - 1], tk = S.tick[S.chart.sym], lp = tk ? tk.p : lastC.c, ly = Math.min(padT + ph, Math.max(padT, y(lp))), lc = lp >= lastC.o ? GR : RD;
    g.setLineDash([4, 3]); g.strokeStyle = lc; g.lineWidth = 1; g.beginPath(); g.moveTo(0, ly); g.lineTo(w - padR, ly); g.stroke(); g.setLineDash([]);
    g.fillStyle = lc; g.fillRect(w - padR, ly - 9, padR, 18); g.fillStyle = '#fff'; g.fillText(fmtP(lp, S.chart.sym), w - padR + 4, ly + 4);
    if (info) { info.textContent = nm(S.chart.sym) + ' • ' + S.chart.tf + ' • O ' + fmtP(lastC.o, S.chart.sym) + '  H ' + fmtP(lastC.h, S.chart.sym) + '  L ' + fmtP(lastC.l, S.chart.sym) + '  C ' + fmtP(lastC.c, S.chart.sym) + '  — orange line: EMA21'; }
    if (note) { note.textContent = 'Live candles from Binance Futures. The last candle updates in real time.'; }
}

// ---------- rendering, navigation, events ----------
var VIEWS = { bot: vBot, health: vHealth, morning: vMorning, newc: vNewc, overview: vOverview, plan: vPlan, scanner: vScanner, candles: vCandles, market: vMarket, chart: vChart, gold: vGold, exness: vExness, calib: vCalib, trade: vTrade, news: vNews, alerts: vAlerts, log: vLog, exchanges: vExchanges, help: vHelp };
var LIVE = { bot: 1, health: 1, morning: 1, newc: 1, overview: 1, plan: 1, scanner: 1, candles: 1, market: 1, gold: 1, exness: 1, exchanges: 1, news: 1 };
var lastKey = '';
function renderKey() { return [S.bot.open.length, S.bot.closed.length, S.lev, S.win, S.scan.at, S.plan.at, S.morning.at, S.newc.at, S.newsAt, S.candles.length, S.log.length, S.fx.at, S.mkt, S.scanf, Math.floor(nowMs() / (S.win === 'bot' || S.win === 'health' ? 3000 : S.win === 'overview' ? 5000 : 15000))].join('|'); }
VIEWS.wallet = function () { return MW.html(); };
function renderView(keep) {
    var d = winDef(S.win), y = window.pageYOffset;
    $('winName').textContent = d.n; $('winSub').textContent = d.sub;
    try { $('view').innerHTML = VIEWS[d.id]() + '<div class="note" style="text-align:center;margin-top:18px">MintooSuite build ' + BUILD + '</div>'; } catch (e) { $('view').innerHTML = '<div class="group pad"><b>Something went wrong showing this window.</b><div class="note">' + esc(e && e.message || e) + '</div></div>'; }
    if (d.id === 'chart') { drawChart(); }
    if (keep) { window.scrollTo(0, y); }
    lastKey = renderKey();
}
function livePatch() {
    var els = document.querySelectorAll('[data-px]'), i, t, el, s;
    for (i = 0; i < els.length; i++) { el = els[i]; t = S.tick[el.getAttribute('data-px')]; if (t) { s = fmtP(t.p, el.getAttribute('data-px')); if (el.textContent !== s) { el.textContent = s; } } }
    els = document.querySelectorAll('[data-chg]');
    for (i = 0; i < els.length; i++) { el = els[i]; s = el.getAttribute('data-chg'); if (S.tick[s]) { var cg = chgOf(s); el.textContent = pct(cg.v) + (el.getAttribute('data-lbl') === '1' ? chgLbl(cg.kind) : ''); el.className = 'chg ' + cc(cg.v); } }
    els = document.querySelectorAll('[data-chip]');
    for (i = 0; i < els.length; i++) { el = els[i]; s = el.getAttribute('data-chip'); if (S.tick[s]) { var cq = chgOf(s); el.textContent = pct(cq.v); el.className = 'badge ' + (cq.v >= 0 ? 'long' : 'short'); } }
}
var TABS = [['overview', 'Home', '<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>'],
    ['morning', 'New Day', '<circle cx="12" cy="14" r="4"/><path d="M12 3v3M4.5 7.5l2 2M19.5 7.5l-2 2M2 18h20"/>'],
    ['scanner', 'Scanner', '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 12l6-6"/>'],
    ['bot', 'Auto Bot', '<rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 4v4M9 13h.01M15 13h.01M9 17h6"/>'],
    ['more', 'More', '<rect x="4" y="4" width="7" height="7" rx="1.6"/><rect x="13" y="4" width="7" height="7" rx="1.6"/><rect x="4" y="13" width="7" height="7" rx="1.6"/><rect x="13" y="13" width="7" height="7" rx="1.6"/>']];
function buildNav() {
    $('tabs').innerHTML = TABS.map(function (t) { var act = t[0] === 'more' ? 'openwin' : 'win:' + t[0]; return '<button class="tab' + (t[0] === S.win ? ' on' : '') + '" data-act="' + act + '"><svg viewBox="0 0 24 24">' + t[2] + '</svg>' + t[1] + '</button>'; }).join('');
    $('tiles').innerHTML = WINS.map(function (w) { return '<div class="tile' + (w.id === S.win ? ' on' : '') + '" data-act="win:' + w.id + '"><div class="ic" style="background:' + w.c + '22">' + w.ic + '</div>' + (w.t || w.n) + '</div>'; }).join('');
}
S.hist = [];
function updateBack() { var el = $('btnBack'); if (el) { el.style.display = S.hist.length ? '' : 'none'; } }
function gotoWin(id, isBack) {
    if (!VIEWS[id]) { id = 'overview'; }
    var leaving = S.win === 'chart' && id !== 'chart';
    if (!isBack && id !== S.win) { S.hist.push(S.win); if (S.hist.length > 30) { S.hist.shift(); } try { history.pushState({ mw: 1 }, ''); } catch (e) {} }
    S.win = id; lss('mintoosuite_win', id); closeSheets(); buildNav(); renderView(); window.scrollTo(0, 0); updateBack();
    if (leaving) { closeChartWS(); }
    if (id === 'chart') { loadChart(); }
    if (id === 'wallet') { MW.onOpen(); }
    if (id === 'news' && (!S.newsTried || nowMs() - S.newsAt > 60000)) { loadNews(); }
}
function goBack() { if (S.hist.length) { try { history.back(); } catch (e) { gotoWin(S.hist.pop(), true); } } }
window.addEventListener('popstate', function () {
    if ($('sheetWin').classList.contains('open') || $('sheetMenu').classList.contains('open')) { closeSheets(); try { history.pushState({ mw: 1 }, ''); } catch (e) {} return; }
    if (S.hist.length) { gotoWin(S.hist.pop(), true); }
});
function openSheet(id) { closeSheets(); if (id === 'sheetMenu') { renderAbout(); applyTheme(); } $(id).classList.add('open'); }
function closeSheets() { $('sheetWin').classList.remove('open'); $('sheetMenu').classList.remove('open'); }
function renderAbout() {
    var age = dataAge(), f = S.feed, feed = f.mode === 'ws' ? 'Live stream (' + (f.variant + 1) + ')' : f.mode === 'rest' ? 'Fast refresh every 1.5s (live stream blocked here)' : 'Not connected';
    $('aboutBox').innerHTML = '<div class="row"><span>Version</span><b>v8 · build ' + BUILD + '</b></div><div class="row"><span>Live feed</span><b>' + feed + '</b></div><div class="row"><span>Data age</span><b class="' + (age < 15000 ? 'up' : 'org') + '">' + (isFinite(age) ? Math.round(age / 1000) + 's' : 'none yet') + '</b></div>' +
        '<div class="row"><span>Phone clock vs Binance</span><b>' + (Math.abs(S.skew) < 1000 ? 'in sync' : (S.skew / 1000).toFixed(1) + 's off (corrected)') + '</b></div><div class="row"><span>Scanner</span><b>' + (S.threads === 'workers' ? 'background workers' : 'main thread') + '</b></div>' + (f.err ? '<div class="row"><span>Last feed issue</span><b class="org">' + esc(f.err) + '</b></div>' : '') +
        '<div class="row"><span>Trading</span><b class="up">Recommendations only</b></div>';
}
function applyTheme() {
    var pref = ls('mintoosuite_theme', 'light'), t = pref === 'auto' ? ((window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light') : pref;
    document.documentElement.setAttribute('data-theme', t);
    var m = document.querySelector('meta[name=theme-color]'); if (m) { m.setAttribute('content', t === 'dark' ? '#000000' : '#f2f2f7'); }
    var segs = document.querySelectorAll('#themeSeg span'); for (var i = 0; i < segs.length; i++) { segs[i].className = segs[i].getAttribute('data-act') === 'theme:' + pref ? 'on' : ''; }
    if (S.win === 'chart') { drawChart(); }
}
function setPref(k) {
    function save() { lss('mintoosuite_sys_push', S.sysPush ? 'on' : 'off'); lss('mintoosuite_gold_push', S.goldPush ? 'on' : 'off'); lss('mintoosuite_crypto_push', S.cryptoPush ? 'on' : 'off'); lss('mintoosuite_alert_3m', S.a3m ? 'on' : 'off'); lss('mintoosuite_alert_master', S.aMaster ? 'on' : 'off'); renderView(true); }
    if (k === 'sys') {
        if (!window.MintooNative && 'Notification' in window && Notification.permission !== 'granted') { Notification.requestPermission().then(function (p) { S.sysPush = p === 'granted'; save(); }); return; }
        S.sysPush = !S.sysPush;
    } else if (k === 'gold') { S.goldPush = !S.goldPush; } else if (k === 'crypto') { S.cryptoPush = !S.cryptoPush; }
    else if (k === 'a3m') { S.a3m = !S.a3m; } else if (k === 'amaster') { S.aMaster = !S.aMaster; }
    else if (k === 'test') {
        var go = function () { sendPush('MintooSuite test', 'Push notifications are working.'); };
        if ('Notification' in window && Notification.permission === 'default') { Notification.requestPermission().then(function () { go(); save(); }); return; }
        go(); return;
    }
    save();
}
function reloadFresh() { try { location.replace(location.pathname + '?v=' + Date.now()); } catch (e) { location.reload(); } }
function reconnect() { wsBack = 1000; closeWS(); connectWS(); pollREST(true); loadTime(); }
var askedPerm = false;
document.addEventListener('click', function (e) {
    if (!askedPerm && S.sysPush && 'Notification' in window && Notification.permission === 'default') { askedPerm = true; try { Notification.requestPermission(); } catch (err) {} }
    if (e.target.classList && e.target.classList.contains('sheet')) { if (e.target.id !== 'sheetTerms') { closeSheets(); } return; }
    var el = e.target.closest ? e.target.closest('[data-act]') : null; if (!el) { return; }
    var a = el.getAttribute('data-act'), p = a.split(':'), v = p.slice(1).join(':');
    if (a === 'openwin') { buildNav(); openSheet('sheetWin'); } else if (a === 'openmenu') { $('langSel').value = S.lang; openSheet('sheetMenu'); } else if (a === 'closesheets') { closeSheets(); }
    else if (a === 'back') { goBack(); } else if (a === 'repair') { repairNow(); renderView(true); } else if (a === 'acceptTerms') { lss('mintoosuite_terms', '1'); $('sheetTerms').classList.remove('open'); }
    else if (a === 'bot:toggle') { S.bot.on = !S.bot.on; botSave(); renderView(true); } else if (a === 'bot:reset') { if (window.confirm('Reset the virtual account to $1,000?')) { botReset(); renderView(true); } }
    else if (a === 'reload') { reloadFresh(); } else if (a === 'reconnect') { reconnect(); } else if (a === 'newsrefresh') { loadNews(); }
    else if (p[0] === 'win') { gotoWin(v); } else if (p[0] === 'theme') { lss('mintoosuite_theme', v); applyTheme(); }
    else if (p[0] === 'mkt') { S.mkt = v; renderView(); } else if (p[0] === 'scanf') { S.scanf = v; renderView(); }
    else if (p[0] === 'chart') { if (SYM_OK.test(v)) { S.chart.sym = v; lss('mintoosuite_chart', v); gotoWin('chart'); } }
    else if (p[0] === 'tf') { S.chart.tf = v; renderView(); loadChart(); }
    else if (p[0] === 'lev') { S.lev = Math.max(1, Math.min(125, +v || 1)); lss('mintoosuite_lev', String(S.lev)); renderView(true); }
    else if (p[0] === 'set') { setPref(v); }
    else if (a === 'clearlog') { S.log = []; lss('mintoosuite_log', '[]'); renderView(); }
});
document.addEventListener('change', function (e) {
    if (e.target.id === 'chartSel' && SYM_OK.test(e.target.value)) { S.chart.sym = e.target.value; lss('mintoosuite_chart', S.chart.sym); loadChart(); drawChart(); }
    else if (e.target.id === 'langSel') { S.lang = e.target.value; lss('mintoosuite_lang', S.lang); applyLang(); }
});
window.addEventListener('resize', function () { if (S.win === 'chart') { drawChart(); } });
var LANG = { en: ['MintooSuite', 'MENU', 'WINDOWS'], ar: ['منتو سويت', 'القائمة', 'النوافذ'], zh: ['MintooSuite', '菜单', '窗口'], ur: ['منٹو سوٹ', 'مینو', 'ونڈوز'], de: ['MintooSuite', 'MENÜ', 'FENSTER'], fr: ['MintooSuite', 'MENU', 'FENÊTRES'] };
function applyLang() { var d = LANG[S.lang] || LANG.en; $('lblTitle').textContent = d[0]; $('lblMenu').textContent = d[1]; $('lblWin').textContent = d[2]; document.documentElement.lang = S.lang; }
function updateStatus() {
    var age = dataAge(), n = Object.keys(S.tick).length, d = $('dot'), t = $('statusTxt'), live = (S.feed.mode === 'ws' && S.wsAt && nowMs() - S.wsAt < 5000) || (S.feed.mode === 'rest' && S.restAt && nowMs() - S.restAt < 4000);
    if (live) { d.className = 'dot ok'; t.textContent = 'LIVE · ' + n + ' coins'; }
    else if (age < 15000) { d.className = 'dot warn'; t.textContent = 'DELAYED · ' + n + ' coins'; }
    else { d.className = 'dot'; t.textContent = n ? 'PAUSED · data ' + Math.round(age / 1000) + 's old' : 'Connecting…'; }
}
function updateBanner() {
    var age = dataAge(), stale = (S.wsAt || S.restAt) && age > 45000, b = $('banner'), html = '';
    if (S.update) { html = '<div class="bn upd">A new version is ready<button data-act="reload">Update now</button></div>'; }
    else if (stale) { html = '<div class="bn stale">Live data paused (' + Math.round(age / 1000) + 's). Prices are hidden until it reconnects<button data-act="reconnect">Retry</button></div>'; }
    if (b.getAttribute('data-h') !== html) { b.innerHTML = html; b.setAttribute('data-h', html); }
    document.body.classList.toggle('is-stale', !!stale);
}
function tick() {
    updateStatus(); updateBanner();
    if (document.hidden) { return; }
    if (LIVE[S.win]) { if (renderKey() !== lastKey) { renderView(true); } else { livePatch(); } }
    if ($('sheetMenu').classList.contains('open')) { renderAbout(); }
}
function onResume() { if (document.hidden) { return; } reconnect(); S.scan.next = 0; S.scan.running = false; runScan(); loadNews(); loadFx(); checkUpdate(); renderView(true); }
document.addEventListener('visibilitychange', onResume);
window.addEventListener('online', onResume);
window.addEventListener('focus', function () { if (dataAge() > 20000) { reconnect(); } });

// ---------- start ----------
if (!VIEWS[S.win]) { S.win = 'overview'; }
applyTheme(); applyLang(); buildNav(); renderView();
if (S.win === 'chart') { loadChart(); }
makeWorkers(false); loadTime(); connectWS(); pollREST(true);
setInterval(pollREST, 8000); setInterval(wsWatchdog, 3000); setInterval(loadTime, 600000);
loadFx(); setInterval(loadFx, 30000);
scanLoop(); loadNews(); setInterval(loadNews, 120000); loadListings(); setInterval(loadListings, 1800000);
setInterval(pollPrices, 1500); setInterval(botStep, 1000); setInterval(healTick, 5000);
history.replaceState({ mw: 1 }, '');
if (ls('mintoosuite_terms', '') !== '1') { $('sheetTerms').classList.add('open'); }
setTimeout(checkUpdate, 15000); setInterval(checkUpdate, 300000); setInterval(tick, 1000);
if ('serviceWorker' in navigator && !window.MintooNative) { navigator.serviceWorker.register('sw.js').catch(function () {}); }
S.dbg = { ACT: ACT_CACHE, processSignals: processSignals, computePicks: computePicks, buildActions: buildActions, botStep: botStep, botStats: botStats, botEquity: botEquity, botReset: botReset, healTick: healTick };
window.__mintoo = S;
})();
</script>
</body></html>
