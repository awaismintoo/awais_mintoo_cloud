<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MintooSuite Terminal</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#f2f2f7">
<style>
:root{--bg:#f2f2f7;--card:#fff;--line:#e5e5ea;--tx:#111114;--mut:#6c6c70;--fill:#f2f2f7;--blu:#007aff;--grn:#1fa855;--red:#e5383b;--org:#f08c00;--glass:rgba(249,249,251,.84);--shadow:0 1px 2px rgba(0,0,0,.04),0 6px 18px rgba(20,24,40,.06);--gt:rgba(31,168,85,.13);--rt:rgba(229,56,59,.12);--ot:rgba(240,140,0,.14);--bt:rgba(0,122,255,.12)}
[data-theme=dark]{--bg:#000;--card:#1c1c1e;--line:#2c2c2e;--tx:#f5f5f7;--mut:#98989f;--fill:#2c2c2e;--blu:#0a84ff;--grn:#30d158;--red:#ff453a;--org:#ff9f0a;--glass:rgba(24,24,26,.84);--shadow:none;--gt:rgba(48,209,88,.16);--rt:rgba(255,69,58,.16);--ot:rgba(255,159,10,.16);--bt:rgba(10,132,255,.18)}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--tx);font:15px/1.4 -apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif;padding-bottom:calc(92px + env(safe-area-inset-bottom));transition:background .25s,color .25s}
button{font-family:inherit}
.bn{position:sticky;top:0;z-index:60;padding:calc(env(safe-area-inset-top) + 8px) 14px 8px;font-size:13px;font-weight:600;text-align:center;color:#fff}
.bn.upd{background:var(--blu)}.bn.stale{background:var(--org)}
.bn button{margin-left:8px;border:0;background:rgba(255,255,255,.25);color:#fff;font-weight:700;padding:4px 12px;border-radius:999px;font-size:12px}
.nav{position:sticky;top:0;z-index:30;background:var(--glass);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--line);padding:calc(env(safe-area-inset-top) + 8px) 14px 8px}
.nav-in{max-width:600px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:8px}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.logo{width:36px;height:36px;border-radius:11px;background:linear-gradient(135deg,#0a84ff,#5e5ce6);display:grid;place-items:center;flex:none;box-shadow:0 3px 10px rgba(10,132,255,.35)}
.brand b{display:block;font-size:16px;font-weight:800;letter-spacing:-.3px;white-space:nowrap}
.stat{display:inline-flex;align-items:center;gap:5px;font-size:11px;color:var(--mut);white-space:nowrap;font-weight:600}
.dot{width:7px;height:7px;border-radius:50%;background:var(--red);flex:none}
.dot.ok{background:var(--grn);animation:pulse 1.8s infinite}.dot.warn{background:var(--org)}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(48,209,88,.55)}70%{box-shadow:0 0 0 6px rgba(48,209,88,0)}100%{box-shadow:0 0 0 0 rgba(48,209,88,0)}}
.nbtns{display:flex;gap:6px;flex:none}
.nbtn{display:flex;align-items:center;gap:5px;border:0;background:var(--fill);color:var(--blu);padding:9px 11px;border-radius:12px;font-size:12px;font-weight:800;cursor:pointer;letter-spacing:.2px}
.nbtn.menu{color:var(--tx)}
.nbtn svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.wrap{max-width:600px;margin:0 auto;padding:4px 14px}
h1{font-size:31px;font-weight:800;letter-spacing:-.7px;margin:14px 0 2px;line-height:1.12}
.sub{font-size:13px;color:var(--mut);margin-bottom:12px}
.group{background:var(--card);border-radius:18px;box-shadow:var(--shadow);margin-bottom:14px;overflow:hidden}
.pad{padding:14px}
.sh{display:flex;justify-content:space-between;align-items:baseline;font-size:12px;font-weight:800;color:var(--mut);text-transform:uppercase;letter-spacing:.05em;margin:20px 4px 8px}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
.row:last-child{border-bottom:0}
.row.tap,.tap{cursor:pointer}.tap:active{opacity:.7}
.mut{color:var(--mut)}.up{color:var(--grn)}.dn{color:var(--red)}.org{color:var(--org)}.blu{color:var(--blu)}
small{font-size:12px;color:var(--mut);font-weight:500}
.av{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:800;font-size:13px;flex:none;text-shadow:0 1px 2px rgba(0,0,0,.25)}
.av.gold{background:linear-gradient(135deg,#f5c542,#c9971c)}
.who{display:flex;align-items:center;gap:10px;min-width:0}
.who b{font-size:16px;font-weight:800;letter-spacing:-.2px;display:block}
.ph{display:flex;justify-content:space-between;align-items:center;gap:8px}
.side{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:800;white-space:nowrap}
.badge.long{background:var(--gt);color:var(--grn)}.badge.short{background:var(--rt);color:var(--red)}.badge.wait{background:var(--fill);color:var(--mut)}
.badge.solid{background:var(--gt);color:var(--grn)}.badge.new{background:var(--bt);color:var(--blu)}.badge.warn{background:var(--ot);color:var(--org)}
.dots{display:inline-flex;gap:3px;align-items:center;font-size:10px;color:var(--mut);font-weight:700}
.dots i{width:14px;height:5px;border-radius:3px;background:var(--line);display:inline-block}.dots i.on{background:var(--grn)}.dots.s i.on{background:var(--red)}
.pm{display:flex;justify-content:space-between;align-items:flex-end;margin-top:12px}
.px{font-size:26px;font-weight:800;letter-spacing:-.6px;font-variant-numeric:tabular-nums}
.chg{font-size:13px;font-weight:700}
.spark{display:block}
.lv{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.lv>div{background:var(--fill);border-radius:12px;padding:9px 6px;text-align:center}
.lv span{display:block;font-size:10px;font-weight:800;color:var(--mut);letter-spacing:.06em}
.lv b{font-size:14px;font-variant-numeric:tabular-nums;font-weight:800}
.nt{margin-top:12px;background:var(--fill);border-radius:12px;padding:10px;text-align:center;color:var(--mut);font-size:13px;font-weight:600}
.pl{margin-top:10px;border:1px solid var(--line);border-radius:12px;overflow:hidden;font-variant-numeric:tabular-nums}
.plr{display:grid;grid-template-columns:1fr 1fr 1fr;padding:7px 10px;font-size:13px;font-weight:700;border-bottom:1px solid var(--line)}
.plr:last-child{border-bottom:0}.plr.hd{font-size:10px;font-weight:800;color:var(--mut);letter-spacing:.06em;background:var(--fill)}
.plr span:nth-child(n+2){text-align:right}
.foot{margin-top:10px;font-size:11px;color:var(--mut)}
.prog{height:5px;border-radius:3px;background:var(--fill);margin:8px 0 2px;overflow:hidden}.prog i{display:block;height:100%;border-radius:3px;background:linear-gradient(90deg,#0a84ff,#5e5ce6)}
.blk{padding:12px 0 2px;border-top:1px solid var(--line);margin-top:12px}.blk:first-of-type{border-top:0;margin-top:6px}
.blk .t{display:flex;justify-content:space-between;align-items:center;font-weight:800}
.tm{font-size:12px;color:var(--mut);margin-top:4px}
.res{margin-top:10px;padding:9px 12px;border-radius:12px;font-size:13px;font-weight:700}
.res.win{background:var(--gt);color:var(--grn)}.res.loss{background:var(--rt);color:var(--red)}.res.run{background:var(--bt);color:var(--blu)}.res.end{background:var(--fill);color:var(--mut)}
.warn{background:var(--ot);color:var(--org);border-radius:12px;padding:10px 12px;font-size:13px;font-weight:600;margin:10px 0}
.note{font-size:12px;color:var(--mut);margin:6px 4px 14px;line-height:1.45}
.segc{display:flex;background:var(--fill);border-radius:11px;padding:3px;margin-bottom:12px;gap:2px}
.segc span{flex:1;text-align:center;padding:8px 4px;font-size:13px;font-weight:700;border-radius:9px;color:var(--mut);cursor:pointer;white-space:nowrap}
.segc span.on{background:var(--card);color:var(--tx);box-shadow:0 1px 4px rgba(0,0,0,.14)}
.sw{width:50px;height:30px;border-radius:15px;background:var(--line);position:relative;flex:none;transition:background .2s;cursor:pointer}
.sw i{position:absolute;top:2px;left:2px;width:26px;height:26px;border-radius:50%;background:#fff;box-shadow:0 2px 5px rgba(0,0,0,.3);transition:left .2s}
.sw.on{background:var(--grn)}.sw.on i{left:22px}
.btn{width:100%;border:0;border-radius:14px;padding:14px;font-size:15px;font-weight:800;background:var(--blu);color:#fff;cursor:pointer;margin-bottom:10px}
.btn.sec{background:var(--fill);color:var(--blu)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}.grid2>.group{margin-bottom:0}
.stile{padding:14px}.stile .lb{font-size:12px;font-weight:800;color:var(--mut);display:flex;align-items:center;gap:7px}
.stile .big{font-size:22px;font-weight:800;letter-spacing:-.5px;margin-top:8px;font-variant-numeric:tabular-nums}
.hero{background:linear-gradient(135deg,#0a84ff 0%,#5e5ce6 60%,#bf5af2 100%);color:#fff;border-radius:22px;padding:16px;margin-bottom:14px;box-shadow:0 10px 28px rgba(10,132,255,.32)}
.hero .hl{font-size:12px;font-weight:800;letter-spacing:.06em;opacity:.85;text-transform:uppercase;display:flex;justify-content:space-between}
.hero .who b{color:#fff}.hero small{color:rgba(255,255,255,.78)}
.hero .lv>div{background:rgba(255,255,255,.18)}.hero .lv span{color:rgba(255,255,255,.8)}.hero .lv b,.hero .lv b.up,.hero .lv b.dn{color:#fff}
.hero .badge{background:rgba(255,255,255,.22);color:#fff}.hero .px{color:#fff}.hero .chg{color:#fff}
.hero .pl{border-color:rgba(255,255,255,.3)}.hero .plr{border-color:rgba(255,255,255,.22)}.hero .plr.hd{background:rgba(255,255,255,.14);color:rgba(255,255,255,.85)}
.hero .up,.hero .dn{color:#fff}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.cc{display:inline-flex;align-items:center;gap:6px;background:var(--fill);padding:6px 10px;border-radius:999px;font-size:13px;font-weight:700}
.sk{background:linear-gradient(90deg,var(--fill) 25%,var(--line) 37%,var(--fill) 63%);background-size:400% 100%;animation:sk 1.4s infinite;border-radius:12px}
@keyframes sk{0%{background-position:100% 50%}100%{background-position:0 50%}}
.skb{height:76px;margin-bottom:12px}
canvas{width:100%;height:320px;display:block;border-radius:14px}
select{background:var(--fill);color:var(--tx);border:0;border-radius:12px;padding:12px;font-size:15px;font-weight:700;width:100%;margin-bottom:10px;appearance:none}
a{color:var(--blu);text-decoration:none}.nws a{color:var(--tx);font-weight:700;line-height:1.35}
.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--glass);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-top:1px solid var(--line);padding:6px 6px calc(env(safe-area-inset-bottom) + 6px)}
.tabs{max-width:600px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr)}
.tab{border:0;background:none;color:var(--mut);display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;font-weight:700;padding:5px 0;cursor:pointer}
.tab svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.tab.on{color:var(--blu)}
.sheet{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:flex-end;z-index:70}
.sheet.open{display:flex}
.sheet-in{background:var(--bg);width:100%;max-width:600px;margin:0 auto;border-radius:24px 24px 0 0;padding:8px 14px calc(env(safe-area-inset-bottom) + 16px);max-height:88vh;overflow:auto;animation:up .22s ease-out}
@keyframes up{from{transform:translateY(40px);opacity:.4}to{transform:none;opacity:1}}
.grab{width:40px;height:5px;border-radius:3px;background:var(--line);margin:4px auto 10px}
.sheet-t{font-size:20px;font-weight:800;margin:4px 2px 12px;display:flex;justify-content:space-between;align-items:center}
.x{border:0;background:var(--fill);color:var(--mut);width:32px;height:32px;border-radius:50%;font-size:16px;font-weight:800;cursor:pointer}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.tile{background:var(--card);border-radius:18px;padding:14px 6px 12px;text-align:center;font-size:12px;font-weight:800;cursor:pointer;box-shadow:var(--shadow);border:2px solid transparent;line-height:1.2}
.tile.on{border-color:var(--blu)}
.tile .ic{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;font-size:23px;margin:0 auto 8px}
.topic{padding:13px 14px;border-bottom:1px solid var(--line)}.topic:last-child{border-bottom:0}.topic b{display:block;margin-bottom:3px}.topic span{font-size:14px;color:var(--mut)}
.tmod{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:90;display:flex;align-items:flex-end;justify-content:center}
.tmod-in{background:var(--card);color:var(--tx);width:100%;max-width:560px;border-radius:22px 22px 0 0;padding:16px 16px 24px;max-height:92vh;overflow:auto;box-sizing:border-box}
.tin{width:100%;padding:12px;border-radius:12px;border:1px solid var(--line);background:var(--fill);color:var(--tx);font-size:16px;box-sizing:border-box}
.btn:disabled{opacity:.5}
</style>
<style>.tk{margin:8px 0 0 20px;font-size:13px;color:var(--tx)}.tk li{margin:5px 0}.rank{width:26px;height:26px;border-radius:8px;background:var(--fill);display:grid;place-items:center;font-size:12px;font-weight:800;color:var(--mut);flex:none}.why{margin-top:10px;font-size:13px}.why b{font-size:12px;color:var(--mut);text-transform:uppercase;letter-spacing:.05em}.why div{margin:4px 0}.bar2{height:8px;border-radius:4px;background:var(--fill);overflow:hidden;margin:6px 0 2px}.bar2 i{display:block;height:100%;border-radius:4px}</style>
</head>
<body>
<div id="banner"></div>
<header class="nav"><div class="nav-in">
  <div class="brand">
    <button class="nbtn" id="btnBack" data-act="back" style="display:none;padding:9px 13px;font-size:18px;line-height:1" aria-label="Back">‹</button>
    <div class="logo"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linejoin="round" stroke-linecap="round"><path d="M12 3l8 6-8 12L4 9z"/><path d="M4 9h16M9 9l3 12 3-12"/></svg></div>
    <div><b id="lblTitle">MintooSuite</b><span class="stat"><i class="dot" id="dot"></i><span id="statusTxt">Connecting…</span></span></div>
  </div>
  <div class="nbtns">
    <button class="nbtn" id="btnWin" data-act="openwin"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.6"/><rect x="13" y="4" width="7" height="7" rx="1.6"/><rect x="4" y="13" width="7" height="7" rx="1.6"/><rect x="13" y="13" width="7" height="7" rx="1.6"/></svg><span id="lblWin">WINDOWS</span></button>
    <button class="nbtn menu" id="btnMenu" data-act="openmenu"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span id="lblMenu">MENU</span></button>
  </div>
</div></header>

<div class="wrap">
  <h1 id="winName"></h1>
  <div class="sub" id="winSub"></div>
  <div id="view"></div>
</div>

<nav class="tabbar"><div class="tabs" id="tabs"></div></nav>

<div class="sheet" id="sheetWin"><div class="sheet-in">
  <div class="grab"></div>
  <div class="sheet-t"><span>Windows</span><button class="x" data-act="closesheets">✕</button></div>
  <div class="tiles" id="tiles"></div>
</div></div>

<div class="sheet" id="sheetTerms"><div class="sheet-in">
  <div class="grab"></div>
  <div class="sheet-t"><span>Before you start</span></div>
  <div class="group">
    <div class="topic"><b>Not financial advice</b><span>MintooSuite shows market information and rule-based ideas. Nobody can promise profit, and no signal, plan or bot result is guaranteed.</span></div>
    <div class="topic"><b>You can lose money</b><span>Trading futures is risky. With leverage you can lose your whole amount quickly. Only use money you can afford to lose.</span></div>
    <div class="topic"><b>No real trades</b><span>This app places no real orders. The Auto Bot trades with virtual money only.</span></div>
    <div class="topic"><b>Check before acting</b><span>Prices come from Binance public data and can be delayed. Always check the price on your exchange before you act.</span></div>
    <div class="topic"><b>Privacy</b><span>Everything stays on your phone. The app collects no personal data and has no account or login.</span></div>
  </div>
  <button class="btn" data-act="acceptTerms">I understand and accept</button>
</div></div>

<div class="sheet" id="sheetMenu"><div class="sheet-in">
  <div class="grab"></div>
  <div class="sheet-t"><span>Menu</span><button class="x" data-act="closesheets">✕</button></div>
  <div class="sh" style="margin-top:4px">Appearance</div>
  <div class="segc" id="themeSeg"><span data-act="theme:light">Light</span><span data-act="theme:dark">Dark</span><span data-act="theme:auto">Auto</span></div>
  <div class="sh">Language</div>
  <div class="group pad"><select id="langSel" style="margin:0">
    <option value="en">English (US)</option><option value="ar">العربية (Arabic)</option><option value="zh">中文 (Chinese)</option>
    <option value="ur">اردو (Urdu)</option><option value="de">Deutsch (German)</option><option value="fr">Français (French)</option>
  </select><div class="note" style="margin-bottom:0">Language changes the title and top buttons only.</div></div>
  <div class="sh">About this copy</div>
  <div class="group" id="aboutBox"></div>
  <button class="btn sec" data-act="win:alerts">🔔 Alert settings</button>
  <button class="btn sec" data-act="win:help">📖 Help & contact</button>
  <button class="btn" data-act="reload">⟳ Reload app (get latest version)</button>
</div></div>
<style>.is-stale #view{opacity:.5;filter:grayscale(.5);transition:opacity .3s}.x2{grid-template-columns:repeat(4,1fr)!important}</style>
<script>
// ---------- Scan engine: runs inside background workers (or on the main thread as a fallback) ----------
function engineBoot(self) {
    var BASE = 'https://fapi.binance.com';
    function emaSeries(a, n) { var k = 2 / (n + 1), o = [a[0]]; for (var i = 1; i < a.length; i++) { o.push(a[i] * k + o[i - 1] * (1 - k)); } return o; }
    function ema(a, n) { var s = emaSeries(a, n); return s[s.length - 1]; }
    function rsi(a, n) {
        n = n || 14; if (a.length <= n) { return 50; }
        var g = 0, l = 0, i, d;
        for (i = 1; i <= n; i++) { d = a[i] - a[i - 1]; if (d >= 0) { g += d; } else { l -= d; } }
        g /= n; l /= n;
        for (i = n + 1; i < a.length; i++) { d = a[i] - a[i - 1]; g = (g * (n - 1) + Math.max(d, 0)) / n; l = (l * (n - 1) + Math.max(-d, 0)) / n; }
        return l === 0 ? 100 : 100 - 100 / (1 + g / l);
    }
    function atrK(k, n) {
        n = n || 14; var s = 0, c = 0;
        for (var i = Math.max(1, k.length - n); i < k.length; i++) {
            s += Math.max(k[i].h - k[i].l, Math.abs(k[i].h - k[i - 1].c), Math.abs(k[i].l - k[i - 1].c)); c++;
        }
        return c ? s / c : 0;
    }
    function macdHist(c) {
        var e12 = emaSeries(c, 12), e26 = emaSeries(c, 26), m = [], i;
        for (i = 0; i < c.length; i++) { m.push(e12[i] - e26[i]); }
        var sg = emaSeries(m, 9);
        return [m[m.length - 2] - sg[sg.length - 2], m[m.length - 1] - sg[sg.length - 1]];
    }
    function supertrend(k, n, m) {
        var len = k.length, i; if (len < n + 3) { return null; }
        var tr = [], atr = [], a = 0;
        for (i = 0; i < len; i++) { var pc = i ? k[i - 1].c : k[i].c; tr.push(Math.max(k[i].h - k[i].l, Math.abs(k[i].h - pc), Math.abs(k[i].l - pc))); }
        for (i = 0; i < n; i++) { a += tr[i]; } a /= n; atr[n - 1] = a;
        for (i = n; i < len; i++) { a = (a * (n - 1) + tr[i]) / n; atr[i] = a; }
        var fu = [], fl = [], dir = [], s = n - 1, hl2 = (k[s].h + k[s].l) / 2;
        fu[s] = hl2 + m * atr[s]; fl[s] = hl2 - m * atr[s]; dir[s] = k[s].c > hl2 ? 1 : -1;
        for (i = s + 1; i < len; i++) {
            hl2 = (k[i].h + k[i].l) / 2; var bu = hl2 + m * atr[i], bl = hl2 - m * atr[i];
            fu[i] = (bu < fu[i - 1] || k[i - 1].c > fu[i - 1]) ? bu : fu[i - 1];
            fl[i] = (bl > fl[i - 1] || k[i - 1].c < fl[i - 1]) ? bl : fl[i - 1];
