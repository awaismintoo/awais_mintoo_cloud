{
  "version": 2,
  "public": true,
  "routes": [
    {
      "src": "/(manifest\\.json|sw\\.js|icon-.*\\.png)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
